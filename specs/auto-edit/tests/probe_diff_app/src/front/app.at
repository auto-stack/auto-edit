// app.at — PLAN-011 T-00 决策探针（probe_diff.py 载具，vm 轨专用脚手架）。
//
// 五项勘定面（决策记录落 PLAN-011 §10）：
//   ① AutoVM 算力微基准：list push/get、str 比较、空循环吞吐（10⁴/10⁵/10⁶
//     三档）+ 401×401 二维表填+扫（DP-LCS 上限 400 行的最坏单元形态）
//     + 600 行 rows 记录构建（渲染 cap 形态）+ 5k 行 split。
//     计时口径=python 墙钟（click→bench_out 增量耗时；UI app 轨
//     Instant.elapsed() 不解析——tnow 通/tel 默杀实证，故弃 .at 侧时钟）。
//     完成以 "name=done;" 形态拼进 .bench_out，acc 校验和防循环被优化。
//   ③ scroll 定标：container 定高包装 + scroll-pane(controller) h-full
//     （直接给 scroll-pane 挂 h-* 样式的形态 content 测量退化
//     content=viewport 实证——p656 示例 container 形为正形）+
//     scroll_to(handle,"y",px) 绝对像素语义 + scroll_state 读回
//     （offset_y/viewport_h/content_h）→ 行高 = content_h/行数。
//   ④ 双栏同步：第二个 scroll-pane 绑 onscroll: .ScObserved（8 位置 float
//     实参：offset_x..progress_y，PLAN-656 v1 执行裁定形）——MCP scroll
//     action（operation::scroll_to 直落）试驱动，观察回声有无。
//
// 测量口径注记：墙钟含消息派发/渲染延迟（ms 级，相对秒级测量可忽略）；
// str 比较用同长异内容串（最差逐字节扫描形）；分档按钮隔离步数预算风险。

// ① DP-LCS 内环模拟：k×k 表填充（str 比较 + 双邻 max + set）+ 全表扫——
// 真实 DP-LCS 的每单元成本形态（T-01 实现同构），预算/时安定标依据。
fn dp_sim(k int) int {
    var tab list = []
    var i int = 0
    while i <= k {
        var r list = []
        var j int = 0
        while j <= k {
            r.push(0)
            j = j + 1
        }
        tab.push(r)
        i = i + 1
    }
    var sa str = "line of text alpha"
    var sb str = "line of TEXT alpha"
    var acc int = 0
    i = 1
    while i <= k {
        var prev list = tab[i - 1]
        var rr list = tab[i]
        var j2 int = 1
        while j2 <= k {
            var v int = 0
            if sa == sb {
                v = 1
            }
            var m int = prev[j2]
            var jm int = j2 - 1
            var r2 int = rr[jm]
            if r2 > m {
                m = r2
            }
            rr.set(j2, m + v)
            acc = acc + m
            j2 = j2 + 1
        }
        i = i + 1
    }
    var sc int = 0
    i = 0
    while i <= k {
        var rr2 list = tab[i]
        var j3 int = 0
        while j3 <= k {
            sc = sc + rr2[j3]
            j3 = j3 + 1
        }
        i = i + 1
    }
    return acc + sc
}

