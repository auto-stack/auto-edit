85, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 186, ro: 186, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 187, ro: 187, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 188, ro: 188, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 189, ro: 189, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 190, ro: 190, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 191, ro: 191, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 192, ro: 192, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 193, ro: 193, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 194, ro: 194, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 195, ro: 195, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 196, ro: 196, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 197, ro: 197, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 198, ro: 198, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 199, ro: 199, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}, {lo: 200, ro: 200, ln: "row-content", rn: "row-content", lk: "ctx", rk: "ctx", lpre: "row-content", lmid: "", lpost: "", rpre: "row-content", rmid: "", rpost: ""}]
        var n_rows int = 200
        var body str = ""
        var dp_k int = 0
        var pane2 bool = false
        var sc2_oy float = -1.0
        var sc2_vh float = -1.0
        var sc2_ch float = -1.0
        var sc_handle str = "diffctl"
        var sc_oy float = -1.0
        var sc_vh float = -1.0
        var sc_ch float = -1.0
        var obs_n int = 0
        var obs_oy float = -999.0
        var obs_vh float = -1.0
        var obs_cw float = -1.0
        var obs_ch float = -1.0
    }
    msg { BenchPush4, BenchPush5, BenchPush6,
          BenchGet5, BenchGet6,
          BenchStr5, BenchStr6,
          BenchLoop4, BenchLoop5, BenchLoop6,
          BldBody, BenchDp200, BenchDp300, BenchDp400, BenchSplit, BenchRows,
          Rows200, Pane2On, Sc2Probe,
          ScProbe, ScTo40, ScBy100, ScToEnd,
          ScObserved(float, float, float, float, float, float, float, float),
          ObsClear }

    on {
        // ---- ① 微基准：list push 三档 ----
        .BenchPush4 -> {
            var l list = []
            var i int = 0
            while i < 10000 {
                l.push(i)
                i = i + 1
            }
            .bench_out = .bench_out + "push1e4=done;"
        }
        .BenchPush5 -> {
            var l list = []
            var i int = 0
            while i < 100000 {
                l.push(i)
                i = i + 1
            }
            .bench_out = .bench_out + "push1e5=done;"
        }
        .BenchPush6 -> {
            var l list = []
            var i int = 0
            while i < 1000000 {
                l.push(i)
                i = i + 1
            }
            .bench_out = .bench_out + "push1e6=done;"
        }
        // ---- ① list get（先建表再扫，两段分别计时）----
        .BenchGet5 -> {
            var l list = []
            var i int = 0
            while i < 100000 {
                l.push(i)
                i = i + 1
            }
            var acc int = 0
            i = 0
            while i < 100000 {
                acc = acc + l[i]
                i = i + 1
            }
            .bench_out = .bench_out + "get1e5=done,acc=" + acc.str() + ";"
        }
        .BenchGet6 -> {
            var l list = []
            var i int = 0
            while i < 1000000 {
                l.push(i)
                i = i + 1
            }
            var acc int = 0
            i = 0
            while i < 1000000 {
                acc = acc + l[i]
                i = i + 1
            }
            .bench_out = .bench_out + "get1e6=done,acc=" + acc.str() + ";"
        }
        // ---- ① str 比较（同长异内容，逐字节最差形）----
        .BenchStr5 -> {
            var s1 str = "line of text alpha"
            var s2 str = "line of TEXT alpha"
            var c int = 0
            var i int = 0
            while i < 100000 {
                if s1 == s2 {
                    c = c + 1
                } else {
                    c = c - 1
                }
                i = i + 1
            }
            .bench_out = .bench_out + "str1e5=done,c=" + c.str() + ";"
        }
        .BenchStr6 -> {
            var s1 str = "line of text alpha"
            var s2 str = "line of TEXT alpha"
            var c int = 0
            var i int = 0
            while i < 1000000 {
                if s1 == s2 {
                    c = c + 1
                } else {
                    c = c - 1
                }
                i = i + 1
            }
            .bench_out = .bench_out + "str1e6=done,c=" + c.str() + ";"
        }
        // ---- ① 空循环基线 ----
        .BenchLoop4 -> {
            var i int = 0
            while i < 10000 {
                i = i + 1
            }
            .bench_out = .bench_out + "loop1e4=done;"
        }
        .BenchLoop5 -> {
            var i int = 0
            while i < 100000 {
                i = i + 1
            }
            .bench_out = .bench_out + "loop1e5=done;"
        }
        .BenchLoop6 -> {
            var i int = 0
            while i < 1000000 {
                i = i + 1
            }
            .bench_out = .bench_out + "loop1e6=done;"
        }
        // ---- ① DP-LCS 内环模拟三档（200/300/400——预算/时安定标）----
        .BenchDp200 -> {
            var acc int = dp_sim(200)
            .bench_out = .bench_out + "dp200=done,acc=" + acc.str() + ";"
        }
        .BenchDp300 -> {
            var acc int = dp_sim(300)
            .bench_out = .bench_out + "dp300=done,acc=" + acc.str() + ";"
        }
        .BenchDp400 -> {
            var acc int = dp_sim(400)
            .bench_out = .bench_out + "dp400=done,acc=" + acc.str() + ";"
        }
        .BldBody -> {
            var bdy str = ""
            var i int = 0
            while i < 5000 {
                bdy = bdy + "line xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
"
                i = i + 1
            }
            .body = bdy
            .bench_out = .bench_out + "bld=done;"
        }
        // ---- ① str split 定标（body 预建于 .store.body——BldBody 先行的
        // 两段式；本 handler 只计 split，剔除 O(n²) 拼接构建成本）----
        .BenchSplit -> {
            var lines list = .body.split("
")
            var nl int = lines.len()
            .bench_out = .bench_out + "split5k_lines=" + nl.str() + ",split5k=done;"
        }
        // ---- ① 渲染 cap 形态：600 行渲染就绪 rows 记录构建 ----
        .BenchRows -> {
            var rl list = []
            var k int = 0
            while k < 600 {
                rl.push({lo: k + 1, ro: k + 1, ln: "line of row content",
                         rn: "line of row content", lk: "ctx", rk: "ctx",
                         lpre: "line of row content", lmid: "", lpost: "",
                         rpre: "line of row content", rmid: "", rpost: ""})
                k = k + 1
            }
            .rows = rl
            .n_rows = 600
            .bench_out = .bench_out + "rows600=done;"
        }
        // ---- ③ scroll 视图行集（200 行，h-6 固定行高）----
        .Rows200 -> {
            var rl list = []
            var k int = 0
            while k < 200 {
                rl.push({lo: k + 1, ro: k + 1, ln: "row-content",
                         rn: "row-content", lk: "ctx", rk: "ctx",
                         lpre: "row-content", lmid: "", lpost: "",
                         rpre: "row-content", rmid: "", rpost: ""})
                k = k + 1
            }
            .rows = rl
            .n_rows = 200
        }
        // ---- ③ scroll_state 读回 ----
        .ScProbe -> {
            let s = scroll_state(.sc_handle)
            .sc_oy = s.offset_y
            .sc_vh = s.viewport_h
            .sc_ch = s.content_h
        }
        // ---- ③ 绝对像素跳转（40 × 24px = 960；行高实测后复核）----
        .ScTo40 -> {
            let ok = scroll_to(.sc_handle, "y", 960.0)
        }
        .ScBy100 -> {
            let ok = scroll_by(.sc_handle, 100.0)
        }
        .ScToEnd -> {
            let ok = scroll_to_end(.sc_handle)
        }
        // ---- ④ onscroll 观察面（8 位置实参：offset_x..progress_y）----
        .ScObserved(ox, oy2, vw, vh, cw, ch, px, p2) -> {
            .obs_n = .obs_n + 1
            .obs_oy = oy2
            .obs_vh = vh
            .obs_cw = cw
            .obs_ch = ch
        }
        .ObsClear -> {
            .obs_n = 0
            .obs_oy = -999.0
        }
        // ---- ③ 延期挂载形态（产品 diff_open 同款：pane 后挂载+for 行集）----
        .Pane2On -> {
            .pane2 = true
        }
        .Sc2Probe -> {
            let s2 = scroll_state("diffctl2")
            .sc2_oy = s2.offset_y
            .sc2_vh = s2.viewport_h
            .sc2_ch = s2.content_h
        }
    }
}

widget App {
    msg { BenchPush4, BenchPush5, BenchPush6,
          BenchGet5, BenchGet6,
          BenchStr5, BenchStr6,
          BenchLoop4, BenchLoop5, BenchLoop6,
          BldBody, BenchDp200, BenchDp300, BenchDp400, BenchSplit, BenchRows,
          Rows200, Pane2On, Sc2Probe,
          ScProbe, ScTo40, ScBy100, ScToEnd,
          ScObserved(float, float, float, float, float, float, float, float),
          ObsClear }
    view {
        col (style: "h-full w-full p-2 gap-2") {
            row (style: "gap-1 shrink-0 flex-wrap") {
                button (text: "bp4", variant: "outline") { onclick: .BenchPush4 }
                button (text: "bp5", variant: "outline") { onclick: .BenchPush5 }
                button (text: "bp6", variant: "outline") { onclick: .BenchPush6 }
                button (text: "bg5", variant: "outline") { onclick: .BenchGet5 }
                button (text: "bg6", variant: "outline") { onclick: .BenchGet6 }
                button (text: "bs5", variant: "outline") { onclick: .BenchStr5 }
                button (text: "bs6", variant: "outline") { onclick: .BenchStr6 }
                button (text: "bl4", variant: "outline") { onclick: .BenchLoop4 }
                button (text: "bl5", variant: "outline") { onclick: .BenchLoop5 }
                button (text: "bl6", variant: "outline") { onclick: .BenchLoop6 }
                button (text: "bld", variant: "outline") { onclick: .BldBody }
                button (text: "dp200", variant: "outline") { onclick: .BenchDp200 }
                button (text: "dp300", variant: "outline") { onclick: .BenchDp300 }
                button (text: "dp400", variant: "outline") { onclick: .BenchDp400 }
                button (text: "bspl", variant: "outline") { onclick: .BenchSplit }
                button (text: "brows", variant: "outline") { onclick: .BenchRows }
            }
            row (style: "gap-1 shrink-0 flex-wrap") {
                button (text: "rows200", variant: "outline") { onclick: .Rows200 }
                button (text: "sc-probe", variant: "outline") { onclick: .ScProbe }
                button (text: "sc-to40", variant: "outline") { onclick: .ScTo40 }
                button (text: "sc-by100", variant: "outline") { onclick: .ScBy100 }
                button (text: "sc-to-end", variant: "outline") { onclick: .ScToEnd }
                button (text: "obs-clear", variant: "outline") { onclick: .ObsClear }
                button (text: "pane2on", variant: "outline") { onclick: .Pane2On }
                button (text: "sc2-probe", variant: "outline") { onclick: .Sc2Probe }
            }
            // ③ 定标面：controller 绑定 scroll-pane（固定行高 h-6 行集）。
            container (style: "h-64") {
                scroll-pane (controller: .store.sc_handle, style: "h-full w-full border") {
                col (style: "gap-0 p-0") {
                    for r in .store.rows {
                        row (style: "h-6 w-full gap-0") {
                            text "${r.lo}" { style: "h-6 w-16 text-xs font-mono" }
                            text "${r.ln}" { style: "h-6 flex-1 text-xs font-mono" }
                        }
                    }
                }
                }
            }
            // ④ 观察面：onscroll 绑定的第二个 scroll-pane。
            container (style: "h-24") {
                scroll-pane (style: "h-full w-full border", onscroll: .ScObserved) {
                col (style: "gap-0 p-0") {
                    text "obs-01" { style: "h-6 text-xs font-mono" }
                    text "obs-02" { style: "h-6 text-xs font-mono" }
                    text "obs-03" { style: "h-6 text-xs font-mono" }
                    text "obs-04" { style: "h-6 text-xs font-mono" }
                    text "obs-05" { style: "h-6 text-xs font-mono" }
                    text "obs-06" { style: "h-6 text-xs font-mono" }
                    text "obs-07" { style: "h-6 text-xs font-mono" }
                    text "obs-08" { style: "h-6 text-xs font-mono" }
                    text "obs-09" { style: "h-6 text-xs font-mono" }
                    text "obs-10" { style: "h-6 text-xs font-mono" }
                    text "obs-11" { style: "h-6 text-xs font-mono" }
                    text "obs-12" { style: "h-6 text-xs font-mono" }
                    text "obs-13" { style: "h-6 text-xs font-mono" }
                    text "obs-14" { style: "h-6 text-xs font-mono" }
                    text "obs-15" { style: "h-6 text-xs font-mono" }
                    text "obs-16" { style: "h-6 text-xs font-mono" }
                    text "obs-17" { style: "h-6 text-xs font-mono" }
                    text "obs-18" { style: "h-6 text-xs font-mono" }
                    text "obs-19" { style: "h-6 text-xs font-mono" }
                    text "obs-20" { style: "h-6 text-xs font-mono" }
                }
                }
            }
            if .store.pane2 {
                container (style: "h-64") {
                    scroll-pane (controller: "diffctl2", style: "h-full w-full border") {
                    col (style: "gap-0 p-0") {
                        for r in .store.rows {
                            row (style: "h-6 w-full gap-0") {
                                text "${r.lo}" { style: "h-6 w-16 text-xs font-mono" }
                                text "${r.ln}" { style: "h-6 flex-1 text-xs font-mono" }
                            }
                        }
                    }
                    }
                }
            }
            text "oy=${.store.sc_oy} vh=${.store.sc_vh} ch=${.store.sc_ch} n=${.store.n_rows} obs=${.store.obs_n}/${.store.obs_oy} p2=${.store.sc2_vh}/${.store.sc2_ch}" {
                style: "text-xs font-mono text-muted-foreground shrink-0"
            }
            text .store.bench_out {
                style: "text-xs font-mono text-muted-foreground shrink-0"
            }
        }
    }
    on {
        .BenchPush4 -> { store.BenchPush4() }
        .BenchPush5 -> { store.BenchPush5() }
        .BenchPush6 -> { store.BenchPush6() }
        .BenchGet5 -> { store.BenchGet5() }
        .BenchGet6 -> { store.BenchGet6() }
        .BenchStr5 -> { store.BenchStr5() }
        .BenchStr6 -> { store.BenchStr6() }
        .BenchLoop4 -> { store.BenchLoop4() }
        .BenchLoop5 -> { store.BenchLoop5() }
        .BenchLoop6 -> { store.BenchLoop6() }
        .BldBody -> { store.BldBody() }
        .BenchDp200 -> { store.BenchDp200() }
        .BenchDp300 -> { store.BenchDp300() }
        .BenchDp400 -> { store.BenchDp400() }
        .BenchSplit -> { store.BenchSplit() }
        .BenchRows -> { store.BenchRows() }
        .Rows200 -> { store.Rows200() }
        .ScProbe -> { store.ScProbe() }
        .ScTo40 -> { store.ScTo40() }
        .ScBy100 -> { store.ScBy100() }
        .ScToEnd -> { store.ScToEnd() }
        .ScObserved(a, b, c, d, e, f, g, h) -> { store.ScObserved(a, b, c, d, e, f, g, h) }
        .ObsClear -> { store.ObsClear() }
        .Pane2On -> { store.Pane2On() }
        .Sc2Probe -> { store.Sc2Probe() }
    }
}
