    var verdict str = "throw"
    try {
        var data list = File.read_bytes(src)
        File.write_bytes(dst, data)
        if File.exists(dst) {
            verdict = "ok"
        } else {
            verdict = "no-effect"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

