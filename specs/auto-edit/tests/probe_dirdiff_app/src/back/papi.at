/// ① fs.remove_dir 对非空目录（护栏语义勘定）：期待保留或抛错——
/// 若连非空树一并删除即危险映射（降级依据）
pub fn probe_rmdir_nonempty() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var p str = root + "\\b_nonempty"
    var verdict str = "throw"
    try {
        fs.remove_dir(p)
        if File.exists(p) {
            verdict = "kept"
        } else {
            verdict = "deleted-nonempty"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

/// ① fs.copy_recursive：目录递归复制可用性（dst 事先不存在）+ 嵌套 E2E
pub fn probe_cp_rec() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var src str = root + "\\a_tree"
    var dst str = root + "\\b_tree_new"
    var nested str = root + "\\b_tree_new\\inner\\nested.txt"
    var verdict str = "throw"
    try {
        fs.copy_recursive(src, dst)
        if File.exists(nested) {
            var d str = File.read_text(nested)
            if d == "nested-v1" {
                verdict = "ok"
            } else {
                verdict = "copied-wrong-content"
            }
        } else {
            verdict = "no-effect"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

/// ① fs.copy_recursive 覆盖语义（Q-2b）：dst 事先存在（top.txt=OLD-TOP）
pub fn probe_cp_rec_over() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var src str = root + "\\a_tree"
    var dst str = root + "\\b_tree_exists"
    var top str = root + "\\b_tree_exists\\top.txt"
    var verdict str = "throw"
    try {
        fs.copy_recursive(src, dst)
        if File.exists(top) {
            var d str = File.read_text(top)
            if d == "top-v1" {
                verdict = "overwritten"
            } else {
                verdict = "target-kept"
            }
        } else {
            verdict = "no-effect"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

/// ① fs.remove_dir_all：递归删除可用性 + 磁盘 E2E（两层树全消）
pub fn probe_rmdir_all() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var p str = root + "\\b_tree_del"
    var verdict str = "throw"
    try {
        fs.remove_dir_all(p)
        if File.exists(p) {
            verdict = "no-effect"
        } else {
            verdict = "ok"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

/// ② 二进制启发式勘定：invalid.bin（非法 UTF-8）→ size>0 且 read_text==
/// ""→ binary；empty.txt（0B）→ read_text=="" 但 size 门拦住（不误判）；
/// valid.txt → 读出非空。read_text_range 前缀窗 total 字段同勘（错误形
/// total:-1 预期）。
pub fn probe_bin() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var pbin str = root + "\\bin\\invalid.bin"
    var pemp str = root + "\\bin\\empty.txt"
    var ptxt str = root + "\\bin\\valid.txt"
    var sbin int = fs.metadata(pbin)
    var semp int = fs.metadata(pemp)
    var tbin str = File.read_text(pbin)
    var temp str = File.read_text(pemp)
    var ttxt str = File.read_text(ptxt)
    var rng str = File.read_text_range(pbin, 0, 8192)
    var tot int = -99
    var v = json.to_value(rng)
    tot = v.total ?? -98
    var verdict str = "text"
    if sbin > 0 {
        if tbin == "" {
            verdict = "binary"
        }
    }
    var emp_ok str = "misjudge"
    if temp == "" {
        if semp > 0 {
            emp_ok = "misjudge"
        } else {
            emp_ok = "not-binary"
        }
    }
    var rng_raw str = rng
    if rng_raw.len() > 60 {
        rng_raw = rng_raw.substr(0, 60)
    }
    return "meta=" + sbin.str() + ",inv=" + verdict + ",empty0B=" + emp_ok + ",txt_len=" + ttxt.len().str() + ",rng_total=" + tot.str() + ",rng_raw=" + rng_raw
}

/// ③ 2MB 同尺寸内容全等比对：same 对=同内容（期待 eq）/ diff 对=同尺寸
/// 异内容（期待 uneq）——Str == 语义+堆驻留勘定。两 fn 自包含（非 pub
/// 文件局部 fn 返回值丢失疑回归 2044 观察件①——不抽公共体）。
pub fn probe_bigcmp_same() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var pa str = root + "\\big\\same_a.txt"
    var pb str = root + "\\big\\same_b.txt"
    var t1 str = File.read_text(pa)
    var t2 str = File.read_text(pb)
    var verdict str = "uneq"
    if t1 == t2 {
        verdict = "eq"
    }
    var l1 int = t1.len()
    return "verdict=" + verdict + ",len=" + l1.str()
}

pub fn probe_bigcmp_diff() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var pa str = root + "\\big\\diff_a.txt"
    var pb str = root + "\\big\\diff_b.txt"
    var t1 str = File.read_text(pa)
    var t2 str = File.read_text(pb)
    var verdict str = "uneq"
    if t1 == t2 {
        verdict = "eq"
    }
    var l1 int = t1.len()
    return "verdict=" + verdict + ",len=" + l1.str()
}
