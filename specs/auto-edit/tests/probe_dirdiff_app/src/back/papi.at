    var p str = root + "\\b\\f_del.txt"
    var verdict str = "throw"
    try {
        fs.delete(p)
        if File.exists(p) {
            verdict = "no-effect"
        } else {
            verdict = "ok"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

