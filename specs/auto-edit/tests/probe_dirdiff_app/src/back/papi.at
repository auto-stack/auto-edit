// back/papi.at — PLAN-012 T-00 决策探针 back 面（probe_dirdiff.py 载具，
// vm 轨专用脚手架，非产品件）。
//
// 勘定面（决策记录落 PLAN-012 §10）：
//   ① fs 同步五内建映射可用性（Q-1）：fs.copy/fs.delete/fs.remove_dir/
//     fs.copy_recursive/fs.remove_dir_all 逐个独立 fn 实测——009 三案
//     教训（错名/撞号/覆盖映射）：catalog 在册≠codegen 映射正确。
//     判定一律磁盘 E2E（File.exists 复核/读回内容比对）+ verdict 串，
//     返回值形态不预设（裸调用+事后复核）。
//   ② 二进制启发式（Q-2 附带）：size>0 且 read_text==""（非法 UTF-8 即
//     二进制近似）；空文件（0B）不误判（size 门）；read_text_range 前缀
//     窗形态（total 字段）同勘——T-01 大文件启发式预算域的备选面。
//   ③ 内容比对上限：2MB 同尺寸对 Str == 全等比对（同/异内容双形态）——
//     墙钟由 python 侧采样，RSS 观察注记口径。
//   ④ dialog_open 目录能力：rfd 阻塞式矩阵不可驱动——静态勘定（源码
//     语义），不以 live 面登记（人工步骤注记由 python 侧落报告）。

/// 探针根（python 注入 env AUTO_DIRDIFF_PROBE；front 零 Env 铁律不破）
pub fn probe_root() str {
    return Env.get("AUTO_DIRDIFF_PROBE")
}

/// ① fs.copy（1007）勘定补记：`copy` 为 .at 保留字 token（Plan 122 废弃
/// ParamMode，词法全局收编）——`fs.copy`/`File.copy` 均不可写（探针 r1
/// 实证：parser "Expected identifier…after dot, got Copy"；复现节见
/// probe_dirdiff.py ①a）。文件复制改走字节往返面（下三 fn）。
///
/// ① 字节往返复制（1005/1006 shim=原生 Vec<i32>↔VM list，零 VM 步循环）：
/// read_bytes→write_bytes，磁盘 E2E 读回比对。
pub fn probe_cp_bytes_small() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var src str = root + "\\a\\f.txt"
    var dst str = root + "\\b\\f_copy.txt"
    var verdict str = "throw"
    try {
        var data list = File.read_bytes(src)
        File.write_bytes(dst, data)
        if File.exists(dst) {
            var d str = File.read_text(dst)
            if d == "alpha-content-v1" {
                verdict = "ok"
            } else {
                verdict = "copied-wrong-content"
            }
        } else {
            verdict = "no-effect"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

/// ① 字节往返覆盖语义（Q-2）：dst 事先存在（OLD-CONTENT）——write_bytes
/// 走 fs::write（truncate 语义）——overwritten=覆盖 / target-kept=拒
pub fn probe_cp_bytes_over() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var src str = root + "\\a\\f.txt"
    var dst str = root + "\\b\\f_exists.txt"
    var verdict str = "throw"
    try {
        var data list = File.read_bytes(src)
        File.write_bytes(dst, data)
        if File.exists(dst) {
            var d str = File.read_text(dst)
            if d == "alpha-content-v1" {
                verdict = "overwritten"
            } else {
                verdict = "target-kept"
            }
        } else {
            verdict = "no-effect"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

/// ① 字节往返 2MB 大文件：roundtrip 完整性（读回全文 ==）+ 堆/墙钟
/// 由 python 侧采样
pub fn probe_cp_bytes_big() str {
    var root str = Env.get("AUTO_DIRDIFF_PROBE")
    var src str = root + "\\big\\same_a.txt"
    var dst str = root + "\\b\\f_bytes_big.txt"
    var verdict str = "throw"
    try {
        var data list = File.read_bytes(src)
        File.write_bytes(dst, data)
        if File.exists(dst) {
            var d1 str = File.read_text(src)
            var d2 str = File.read_text(dst)
            if d1 == d2 {
                verdict = "ok-eq"
            } else {
                verdict = "copied-neq"
            }
        } else {
            verdict = "no-effect"
        }
    } catch {
        verdict = "throw"
    }
    return verdict
}

