// back/fsys.at — fs 后端实现本体（PLAN-003 T-01；T-03 改名 fs→fsys：
// 模块名与内建 fs 对象同名有遮蔽风险，且 split 扁平化只吃整模块导入）。
//
// 全部文件系统 IO 收口于此（front 零 fs.*/File.* 内建——AC-01；vue 轨
// ts_adapter 将二者拦为 __vmOnly 抛错桩，T-00 P-5 实证，此即拆 back 的
// 动机）。AutoVM 解释服役（merged 进程内 / split 为 HTTP 服务侧模块）。
// 函数名与 api.at 契约名刻意错开（root_dir↔ws_root 等）——013-todo 形态：
// 契约 fn 与实现 fn 同名会在导入处遮蔽冲突。

/// 工作区根：AUTO_PROJECT_DIR（auto-man 注入），缺席兜底 "."
pub fn root_dir() str {
    var root str = Env.get("AUTO_PROJECT_DIR")
    if root == "" {
        root = "."
    }
    return root
}

/// 目录树 JSON（front 侧 json.to_value 解析；该内建 vue 转译吸收）
pub fn tree_json(path str, depth int) str {
    return fs.tree(path, depth)
}

/// 读文本（直通 File.read_text——现 store 行为保真，无 Option 分支）
pub fn read_all(path str) str {
    return File.read_text(path)
}

/// 分块读（PLAN-007 装载链）：read_text_range envelope 直通——
/// {"text":..,"total":<文件字节数>,"next_offset":<字节>|null}；错误形
/// total:-1；EOF=next_offset null（仅真 EOF）；块边界不切多字节字符。
/// 调用方（editor_store RunPendingLoad）只把 text 块送编辑器，全文
/// 永不进 VM 堆。
pub fn read_range(path str, offset int, limit int) str {
    return File.read_text_range(path, offset, limit)
}

/// 文件字节数（PLAN-013 T-01 大文件模式探测链）：**envelope JSON 串形**
/// （`{"size":<字节>}`）——裸 int 返回过 AutoVM HTTP 面=serialize null
/// （T-00 Phase A 实勘：merged 直调 ✓/split HTTP ✗——上游 §16 观察
/// 登记；仓内既证形=JSON 串 envelope[search_files count 同款]，双轨
/// 一致）。fs.metadata 直通=auto.fs.size 映射（int 字节长）；缺失/IO
/// 错误 → size:-1（exists 前置判——metadata 对缺失返 0 无异_REQUEST
/// 常形，0 与空文件歧义故显式判存；try 门兜真异常）。调用方
/// RunPendingLoad 负值=跳过模式判定，装载链既有错误形[缺席/非法
/// UTF-8]原样承接，零行为差异。
pub fn file_size_impl(path str) str {
    // 形注记：零 try 形——a2r rust 转译器不支持 try 体内的 Asn/Return
    // （两形实测皆 unsupported statement，T-05 勘出；唯一已证形=let 体+
    // 空 catch[search_files_json]）。exists 前置后 metadata 的竞态窗
    // （删除/锁定）异常由**front 探测位 try 门**兜（editor_store.at
    // RunPendingLoad——VM 面 try 任意形可用；异常→-1→既有装载链错误
    // 形承接）。rust 臂本已全局 blocked[back-api 引擎切换节]，本形使
    // fsys.rs 模块转译零警告。
    var s int = -1
    if File.exists(path) {
        s = fs.metadata(path)
    }
    if s < 0 {
        s = -1
    }
    return json.from_value({size: s})
}

/// 写文本 + exists 复核（成功信号；对齐 TreeSelect 前置判存的 IO 惯例）
pub fn write_all(path str, content str) bool {
    File.write_text(path, content)
    return File.exists(path)
}

/// 路径存在性（目录节点不命中 → TreeSelect 静默忽略语义保持）
pub fn path_exists(path str) bool {
    return File.exists(path)
}

/// 环境变量读（未设 = ""；AUTO_OPEN_PATH/AUTO_SAVE_PATH 矩阵旁路）
pub fn env_lookup(name str) str {
    return Env.get(name)
}

/// 正则替换（PLAN-009 T-03）：Regex.replace（Rust regex）+ marker 算术
/// 计数。计数不用 Regex.match 列表（vm handler 字节码 .len() 恒 20，
/// T-00⑤ 勘定）——sentinel 串替换后按 len 差商计数（Str.replace/len
/// 双轨映射内，PLAN-008 EOL 计数同款选型）；count=真实替换数，无列表帽。
pub fn regex_replace_json(text str, pattern str, replacement str, global bool) str {
    var flags str = ""
    if global {
        flags = "g"
    }
    // 大小写不敏感默认（SD-02 契约：与查找面内核 builder
    // case_insensitive(true) 同默认；pattern 自带旗标前缀——`(` 开头，
    // 如查找面 `(?-i)` 直通形态——则透传）。裸 Regex.replace 是
    // case-sensitive（shim 直编 Regex::new 无旗标），不补齐会与高亮面
    // 劈叉（T13.3 实勘：query=alpha 仅替换小写 1 处，高亮 4 处）。
    var pat str = pattern
    if pat.substr(0, 1) != "(" {
        pat = "(?i)" + pat
    }
    let m str = "~~AM09REPLMARK~~"
    let probe str = Regex.replace(text, pat, m, flags)
    let count int = (probe.len() - probe.replace(m, "").len()) / m.len()
    let out str = Regex.replace(text, pat, replacement, flags)
    return json.from_value({out: out, count: count})
}

/// fif 路径噪声过滤（镜像 fs.tree 的 skip-list 语义——Explorer 与
/// find-in-files 口径一致）：隐藏段/VCS/构建产物/依赖树跳过。入参为
/// **剥根后的相对路径**（根前缀剥离在 search_files_json——根路径自身
/// 合法含点段如 .wt 组目录，全路径匹配会误杀全部条目，实勘教训）；
/// 段命中用 replace 等值判定（Str.replace 双轨映射内，find 的 vm 面
/// 签名不依赖）。
fn fif_skipped(rel str) bool {
    // 前导 / 归一：使首段（如工作区顶层的 gen/、node_modules/——vue 轨
    // build 产物树 11k+ 文件，T-06 实勘）与中段同样命中段检查。
    var np str = "/" + rel.replace("\\", "/")
    if np.len() <= 1 {
        return false
    }
    var skipped bool = false
    if np.replace("/.", "") != np {
        skipped = true
    }
    if np.replace("/target/", "") != np {
        skipped = true
    }
    if np.replace("/node_modules/", "") != np {
        skipped = true
    }
    if np.replace("/gen/", "") != np {
        skipped = true
    }
    if np.replace("/dist/", "") != np {
        skipped = true
    }
    if np.replace("/build/", "") != np {
        skipped = true
    }
    if np.replace("/__pycache__/", "") != np {
        skipped = true
    }
    return skipped
}

/// 跨文件查找（PLAN-009 T-04）：fs.walk 递归（walk_files 2847 未入
/// bigvm 白名单且撞号 Path.to_string——VM 模式 .at 调用 Undefined
/// symbol，read_dir 2843→2866 同症先例；fs.walk 2860 双表齐=等价递归
/// 面，本仓零 auto-lang 改动约束下的仓内可解路径，upstream §12 登记
/// walk_files 白名单补件 want）+ fs.metadata 大小门（>10MB 跳过）+
/// try/catch 读（非法 UTF-8/锁定/竞态删除静默跳过——不中断整体搜索）
/// + 逐行 Regex.test（split("\n") 行号天然；跨行不匹配=内核 find 逐行
/// 同口径；CRLF 尾 \r 随行参与匹配——显示语义可接受）。
/// pattern 大小写不敏感默认（`(?i)` 前缀追加），pattern 自带旗标前缀
/// （`(` 开头，如查找面 `(?-i)` 直通形态）则原样透传——与查找面
/// effective 串同约定。preview=行文本截断 200 字符；条数达 limit 置
/// truncated。计数用手工计数器（列表 .len() 规避面，同上）。
pub fn search_files_json(path str, pattern str, limit int) str {
    var items list = []
    var n int = 0
    var truncated bool = false
    var maxn int = limit
    if maxn <= 0 {
        maxn = 500
    }
    var re_case str = "(?i)" + pattern
    if pattern.substr(0, 1) == "(" {
        re_case = pattern
    }
    // 递归枚举 = fs.list_dir（codegen 映射 auto.fs.walk=递归扁平 JSON，
    // 反斜杠分隔符；`fs.walk` 的 codegen 映射错名 auto.file.walk——
    // 实勘 File.create 错派 500，upstream §12 登记；`fs.walk_files`
    // 2847 未入 bigvm 白名单且撞号 Path.to_string，同节登记）。
    let files = json.to_value(fs.list_dir(path))
    var root_norm str = path.replace("\\", "/")
    for f in files {
        if n >= maxn {
            truncated = true
            break
        }
        // 剥根前缀后过滤（fif_skipped 入参=相对路径——根自身点段如
        // .wt 组目录不可触发隐藏段匹配，实勘教训见 fif_skipped 注）。
        var fpath str = f
        var rel str = f.replace("\\", "/")
        if root_norm != "" {
            var stripped str = rel.replace(root_norm + "/", "")
            if stripped != rel {
                rel = stripped
            } else {
                if rel.replace(root_norm, "") != rel {
                    rel = rel.replace(root_norm, "")
                }
            }
        }
        if fif_skipped(rel) {
            continue
        }
        // 大小门：fs.metadata 实测返回 int 字节长（codegen 映射
        // auto.fs.size——metadata JSON 形态被该映射覆盖，is_dir/len
        // 字段访问不可用，upstream §12 同节登记）；>10MB 跳过。
        var fsize int = fs.metadata(fpath)
        if fsize > 10485760 {
            continue
        }
        if fs.is_dir(fpath) {
            continue
        }
        // 读失败（非法 UTF-8/锁定/竞态删除/目录误入）静默跳过——不中断
        // 整体搜索（兜底语义对齐 load_file 错误路径）。
        try {
            let content str = File.read_text(fpath)
            let lines = content.split("\n")
            var lineno int = 0
            for ln in lines {
                lineno = lineno + 1
                if n >= maxn {
                    truncated = true
                    break
                }
                if Regex.test(ln, re_case) {
                    var preview str = ln
                    if preview.len() > 200 {
                        preview = preview.substr(0, 200)
                    }
                    items.push({file: fpath, line: lineno, preview: preview})
                    n = n + 1
                }
            }
        } catch {
        }
    }
    return json.from_value({results: items, count: n, truncated: truncated})
}

// ═════════════════════════════════════════════════════════════════
// 文件 diff（PLAN-016 T-01）——引擎时代消费位（native 裸名直调）。
//
// PLAN-011 过渡朴素分层实现体（公共前后缀裁剪→≤200 行 DP-LCS→大中段
// 降级 replace→索引对齐配对+三段→ctx 切 hunk）与上限门三门（0 存在性
// +1 尺寸 1MB+2 行数 10k）随 auto-lang PLAN-703 diff 引擎供料包交付
// （46efa926a，2026-09-27）整体退役——本函数=纯转发。上游 SD-03
// 逐字段同形交付（docs/specs/auto-lang/ui/design/diff-endpoints.md）：
// envelope 12 字段 rows/hunks 0 基半开/CR 容忍/err 形（「文件不存在:
// …」/「读取失败: …」）契约零变化；refine 恒开（100k 字符预算系 VM 步
// 墙，Rust 侧无此约束）；degraded 恒 false（引擎时代无降级语义——
// G-2：DP-200 降级退场）；truncated 恒 false（v1 保留字段）。
// 裸名解析：本模块内无 diff_files 本地符号（仅 diff_files_json）——
// 裸名绑定 codegen intrinsics（vm/codegen.rs「diff_files」→
// NATIVE_DIFF_FILES 9915），api.at 契约 fn 同名不在此解析（T-00 探针
// probe_bufdiff.py ① 实证绑定）；ctx<=0 钳 3 上游侧已有（envelope
// 构建器 ctx==0→3）。
pub fn diff_files_json(path_a str, path_b str, ctx int) str {
    return diff_files(path_a, path_b, ctx)
}

// ═════════════════════════════════════════════════════════════════
// 文件 diff 窗口（PLAN-022 T-01）——PLAN-716 组C 消费位（9920 五参
// 窗口端点裸名直调）。
//
// 上游契约（docs/specs/auto-lang/ui/design/diff-endpoints.md「rows 窗口
// 投影」节，2026-09-30 交付）：`diff_files_window(path_a, path_b, ctx,
// rows_offset, rows_limit)`——envelope 增 `rows_total`（全量行计数，
// 窗口只影响物化不影响计数）+`truncated` 激活（头部 offset>0 或尾部
// offset+返回<total 任一省略即置位）；hunks 恒全量（导航域不受窗口
// 影响）；9915 默认形逐字节不变（frozen③——不增 rows_total 字段，
// 最严形）。边界形（上游 SD-C 明文）：offset ≥ rows_total → rows:[]
// +truncated=true（total>0 时）；limit 0 → 空+truncated 同语义；窗口
// 跨 hunk 任意切片=全量 rows[offset..offset+limit] 逐行等价。裸名
// 解析同上 diff_files（codegen intrinsics 9920 绑定——trans 裸名臂
// diff_files_window/ui_gen handler 直调臂 716 交付在册）。窗口形判定
// 消费位=bench diff_100mb 档（T-02——rows_limit=600 对齐 front 渲染
// cap「出结果」口径）；front 消费面零改动（窗口化仅 back/bench 域，
// frozen③——front 惰性拉行=后续件）。
pub fn diff_files_window_json(path_a str, path_b str, ctx int, rows_offset int, rows_limit int) str {
    return diff_files_window(path_a, path_b, ctx, rows_offset, rows_limit)
}

// ═════════════════════════════════════════════════════════════════
// 目录 diff（PLAN-016 T-02）——引擎时代消费位（native 裸名直调）。
//
// PLAN-012 过渡实现体（双侧 list_dir 递归+五态分类+长度桶对齐+桶积
// 700k 护栏+cap 5000）随引擎供料退役——纯转发 native 裸名 diff_dirs
// （9917，绑定同上 T-00 实证）。行为保持面（上游 SD-03 明文）：五态
// 分类序/counts 与 entries 同域/skip-list（fif_skipped 同语义）/
// >2MB 同尺寸 same+note=uncompared 注记（矩阵行为变更=后续件）/
// cap 5000 truncated 不静默/根缺失 err 不静默/左右语义 BC 同款。
// 退场面（G-3）：长度桶对齐与桶积 700k 护栏随实现体替换消亡——对齐
// 在 Rust 侧，同长巨桶目录正常出结果（「对齐超限」err 文案退役）。
// mtime 快路 opt-in 默认关（上游 parity 风险注记——行为零变化）。
pub fn diff_dirs_json(path_a str, path_b str) str {
    return diff_dirs(path_a, path_b)
}

// ═════════════════════════════════════════════════════════════════
// 缓冲区 diff（PLAN-016 T-04）——diff_snapshots 解锁件（PLAN-011 边界
// 注记「与编辑中缓冲区比较需全文读出撞零全文 tab 铁律」的正解落位：
// buffer registry 直读，零全文 VM 往返）。
//
// native 裸名 diff_snapshots（9916）直调——hunk 净形 envelope
// （rows:[]——rows 是文件面渲染投影，缓冲区面供 hunk 导航，三段标记
// 不涉及）；缺键 err 形（「编辑器不存在: …」上游同形，值不 raise）。
// 键语义=tab.key（code_editor 族同形；VM 轨 storage_key 前缀
// normalize 上游对齐——T-00 探针 probe_bufdiff.py ② merged 臂实证：
// tab-N 键直读出净形）。
pub fn diff_buffers_json(key_a str, key_b str) str {
    return diff_snapshots(key_a, key_b)
}

// ═════════════════════════════════════════════════════════════════
// 同步动作（PLAN-012 T-02）——破坏性动作收口 back（front 零 fs 铁律）。
//
// sync_copy：文件=字节往返（read_bytes 1005→write_bytes 1006——fs.copy
// 1007 表面被 `copy` 保留字阻断，T-00 定案；≤2MB 预算域=内容比对同域，
// 超限 false[front 注记+§15 want]）；目录=fs.copy_recursive 2862（静默
// 覆盖=truncate/合并语义，Q-2 定案——front 确认链管目标存在形）。
// sync_delete：文件=fs.delete 1003；目录=**仅空目录** fs.remove_dir 1014
// （非空原生失败=T-00 护栏实证；递归删除 v1 不提供——remove_dir_all
// 1015 在册不暴露，§2 安全注记）。空路径/根路径/缺失源→false（护栏三
// 条——§2 安全注记）。bool 返回=磁盘 E2E 复核（动作后 exists 终判，
// T-00 载具同口径）。
pub fn sync_copy_impl(src str, dst str, is_dir bool) bool {
    if src == "" {
        return false
    }
    if dst == "" {
        return false
    }
    if !File.exists(src) {
        return false
    }
    if is_dir {
        try {
            fs.copy_recursive(src, dst)
            return File.exists(dst)
        } catch {
            return false
        }
    }
    var sz int = 0
    try {
        sz = fs.metadata(src)
    } catch {
        return false
    }
    if sz > 2097152 {
        return false
    }
    try {
        var data list = File.read_bytes(src)
        File.write_bytes(dst, data)
        return File.exists(dst)
    } catch {
        return false
    }
}

pub fn sync_delete_impl(path str, is_dir bool) bool {
    if path == "" {
        return false
    }
    if path == "/" {
        return false
    }
    if path == "\\" {
        return false
    }
    if path.len() <= 3 {
        if path.substr(1, 1) == ":" {
            return false
        }
    }
    if !File.exists(path) {
        return false
    }
    if is_dir {
        try {
            fs.remove_dir(path)
            return !File.exists(path)
        } catch {
            return false
        }
    }
    try {
        fs.delete(path)
        return !File.exists(path)
    } catch {
        return false
    }
}
