// back/fsys.at — fs 后端实现本体（PLAN-003 T-01；T-03 改名 fs→fsys：
// 模块名与内建 fs 对象同名有遮蔽风险，且 split 扁平化只吃整模块导入）。
//
// 全部文件系统 IO 收口于此（front 零 fs.*/File.* 内建——AC-01；vue 轨
// ts_adapter 将二者拦为 __vmOnly 抛错桩，T-00 P-5 实证，此即拆 back 的
// 动机）。AutoVM 解释服役（merged 进程内 / split 为 HTTP 服务侧模块）。
// 函数名与 api.at 契约名刻意错开（root_dir↔ws_root 等）——013-todo 形态：
// 契约 fn 与实现 fn 同名会在导入处遮蔽冲突。

/// 工作区根：AUTO_PROJECT_DIR（auto-man 注入），缺席兜底 "."
pub fn root_dir() str {
    var root str = Env.get("AUTO_PROJECT_DIR")
    if root == "" {
        root = "."
    }
    return root
}

/// 目录树 JSON（front 侧 json.to_value 解析；该内建 vue 转译吸收）
pub fn tree_json(path str, depth int) str {
    return fs.tree(path, depth)
}

/// 读文本（直通 File.read_text——现 store 行为保真，无 Option 分支）
pub fn read_all(path str) str {
    return File.read_text(path)
}

/// 分块读（PLAN-007 装载链）：read_text_range envelope 直通——
/// {"text":..,"total":<文件字节数>,"next_offset":<字节>|null}；错误形
/// total:-1；EOF=next_offset null（仅真 EOF）；块边界不切多字节字符。
/// 调用方（editor_store RunPendingLoad）只把 text 块送编辑器，全文
/// 永不进 VM 堆。
pub fn read_range(path str, offset int, limit int) str {
    return File.read_text_range(path, offset, limit)
}

/// 写文本 + exists 复核（成功信号；对齐 TreeSelect 前置判存的 IO 惯例）
pub fn write_all(path str, content str) bool {
    File.write_text(path, content)
    return File.exists(path)
}

/// 路径存在性（目录节点不命中 → TreeSelect 静默忽略语义保持）
pub fn path_exists(path str) bool {
    return File.exists(path)
}

/// 环境变量读（未设 = ""；AUTO_OPEN_PATH/AUTO_SAVE_PATH 矩阵旁路）
pub fn env_lookup(name str) str {
    return Env.get(name)
}

/// 正则替换（PLAN-009 T-03）：Regex.replace（Rust regex）+ marker 算术
/// 计数。计数不用 Regex.match 列表（vm handler 字节码 .len() 恒 20，
/// T-00⑤ 勘定）——sentinel 串替换后按 len 差商计数（Str.replace/len
/// 双轨映射内，PLAN-008 EOL 计数同款选型）；count=真实替换数，无列表帽。
pub fn regex_replace_json(text str, pattern str, replacement str, global bool) str {
    var flags str = ""
    if global {
        flags = "g"
    }
    // 大小写不敏感默认（SD-02 契约：与查找面内核 builder
    // case_insensitive(true) 同默认；pattern 自带旗标前缀——`(` 开头，
    // 如查找面 `(?-i)` 直通形态——则透传）。裸 Regex.replace 是
    // case-sensitive（shim 直编 Regex::new 无旗标），不补齐会与高亮面
    // 劈叉（T13.3 实勘：query=alpha 仅替换小写 1 处，高亮 4 处）。
    var pat str = pattern
    if pat.substr(0, 1) != "(" {
        pat = "(?i)" + pat
    }
    let m str = "~~AM09REPLMARK~~"
    let probe str = Regex.replace(text, pat, m, flags)
    let count int = (probe.len() - probe.replace(m, "").len()) / m.len()
    let out str = Regex.replace(text, pat, replacement, flags)
    return json.from_value({out: out, count: count})
}

/// fif 路径噪声过滤（镜像 fs.tree 的 skip-list 语义——Explorer 与
/// find-in-files 口径一致）：隐藏段/VCS/构建产物/依赖树跳过。入参为
/// **剥根后的相对路径**（根前缀剥离在 search_files_json——根路径自身
/// 合法含点段如 .wt 组目录，全路径匹配会误杀全部条目，实勘教训）；
/// 段命中用 replace 等值判定（Str.replace 双轨映射内，find 的 vm 面
/// 签名不依赖）。
fn fif_skipped(rel str) bool {
    // 前导 / 归一：使首段（如工作区顶层的 gen/、node_modules/——vue 轨
    // build 产物树 11k+ 文件，T-06 实勘）与中段同样命中段检查。
    var np str = "/" + rel.replace("\\", "/")
    if np.len() <= 1 {
        return false
    }
    var skipped bool = false
    if np.replace("/.", "") != np {
        skipped = true
    }
    if np.replace("/target/", "") != np {
        skipped = true
    }
    if np.replace("/node_modules/", "") != np {
        skipped = true
    }
    if np.replace("/gen/", "") != np {
        skipped = true
    }
    if np.replace("/dist/", "") != np {
        skipped = true
    }
    if np.replace("/build/", "") != np {
        skipped = true
    }
    if np.replace("/__pycache__/", "") != np {
        skipped = true
    }
    return skipped
}

/// 跨文件查找（PLAN-009 T-04）：fs.walk 递归（walk_files 2847 未入
/// bigvm 白名单且撞号 Path.to_string——VM 模式 .at 调用 Undefined
/// symbol，read_dir 2843→2866 同症先例；fs.walk 2860 双表齐=等价递归
/// 面，本仓零 auto-lang 改动约束下的仓内可解路径，upstream §12 登记
/// walk_files 白名单补件 want）+ fs.metadata 大小门（>10MB 跳过）+
/// try/catch 读（非法 UTF-8/锁定/竞态删除静默跳过——不中断整体搜索）
/// + 逐行 Regex.test（split("\n") 行号天然；跨行不匹配=内核 find 逐行
/// 同口径；CRLF 尾 \r 随行参与匹配——显示语义可接受）。
/// pattern 大小写不敏感默认（`(?i)` 前缀追加），pattern 自带旗标前缀
/// （`(` 开头，如查找面 `(?-i)` 直通形态）则原样透传——与查找面
/// effective 串同约定。preview=行文本截断 200 字符；条数达 limit 置
/// truncated。计数用手工计数器（列表 .len() 规避面，同上）。
pub fn search_files_json(path str, pattern str, limit int) str {
    var items list = []
    var n int = 0
    var truncated bool = false
    var maxn int = limit
    if maxn <= 0 {
        maxn = 500
    }
    var re_case str = "(?i)" + pattern
    if pattern.substr(0, 1) == "(" {
        re_case = pattern
    }
    // 递归枚举 = fs.list_dir（codegen 映射 auto.fs.walk=递归扁平 JSON，
    // 反斜杠分隔符；`fs.walk` 的 codegen 映射错名 auto.file.walk——
    // 实勘 File.create 错派 500，upstream §12 登记；`fs.walk_files`
    // 2847 未入 bigvm 白名单且撞号 Path.to_string，同节登记）。
    let files = json.to_value(fs.list_dir(path))
    var root_norm str = path.replace("\\", "/")
    for f in files {
        if n >= maxn {
            truncated = true
            break
        }
        // 剥根前缀后过滤（fif_skipped 入参=相对路径——根自身点段如
        // .wt 组目录不可触发隐藏段匹配，实勘教训见 fif_skipped 注）。
        var fpath str = f
        var rel str = f.replace("\\", "/")
        if root_norm != "" {
            var stripped str = rel.replace(root_norm + "/", "")
            if stripped != rel {
                rel = stripped
            } else {
                if rel.replace(root_norm, "") != rel {
                    rel = rel.replace(root_norm, "")
                }
            }
        }
        if fif_skipped(rel) {
            continue
        }
        // 大小门：fs.metadata 实测返回 int 字节长（codegen 映射
        // auto.fs.size——metadata JSON 形态被该映射覆盖，is_dir/len
        // 字段访问不可用，upstream §12 同节登记）；>10MB 跳过。
        var fsize int = fs.metadata(fpath)
        if fsize > 10485760 {
            continue
        }
        if fs.is_dir(fpath) {
            continue
        }
        // 读失败（非法 UTF-8/锁定/竞态删除/目录误入）静默跳过——不中断
        // 整体搜索（兜底语义对齐 load_file 错误路径）。
        try {
            let content str = File.read_text(fpath)
            let lines = content.split("\n")
            var lineno int = 0
            for ln in lines {
                lineno = lineno + 1
                if n >= maxn {
                    truncated = true
                    break
                }
                if Regex.test(ln, re_case) {
                    var preview str = ln
                    if preview.len() > 200 {
                        preview = preview.substr(0, 200)
                    }
                    items.push({file: fpath, line: lineno, preview: preview})
                    n = n + 1
                }
            }
        } catch {
        }
    }
    return json.from_value({results: items, count: n, truncated: truncated})
}

// ═════════════════════════════════════════════════════════════════
// 文件 diff（PLAN-011 T-01）——朴素分层过渡计算层（envelope=替换缝契约）。
//
// 算法（§2/探针②同款，python 参考实现=tests/fixtures/diff/*.golden）：
// ① 公共前后缀行裁剪 → ② 中间区 ≤200 行/侧 DP-LCS（O(N·M) 行级，del
// 优先确定性回溯）→ ③ 大中段降级整块 replace（degraded=true）→ ④
// replace 区索引对齐配对+公共前后缀三段标记 → ⑤ ctx 上下文窗切 hunk
// （间距 ≤2·ctx 归组）+ rows 逐 hunk 展开（流切片摊销 O(n)）。
//
// envelope（SD-01 契约）：{hunks:[{a1,a2,b1,b2}](0 基半开),rows:[{lo,ro,
// ln,rn,lk,rk,lpre,lmid,lpost,rpre,rmid,rpost}](lo/ro=1 基,缺席侧 0；
// lk/rk ∈ ctx/del/add/""),adds,dels,truncated,degraded,err}——truncated
// v1 恒 false（保留字段）；err 无错=""。
//
// 上限门（T-00 §10 定参，保守跨工具链）：尺寸 pre-read（fs.metadata，
// 即时拒防长等）+ 行数 post-split；10k 行 / 1MB。
//
// 实现注记（T-00 实勘约束）：
// · 全内联单函数——2044 工具链文件局部 fn 返回值丢失疑回归（dp_sim
//   return→0，upstream 观察件①；模块级 fn 返回经 api 链已证可靠）。
// · 单 handler ≤10M steps（engine.rs:2145）——全链估算 ~2.2M ✓。
// · 三段标记全局字符预算 100k（超预算行退化整行 mid=Q-4 已接受形态）
//   ——逐字符 substr 最坏 20k 配对行的墙钟保护。
// · CR 容忍：CRLF 行剥尾 \r（与 golden 的 universal-newlines 参考
//   实现对齐；SD-02 成文）。
// · 语法纪律：record 字面量/调用实参严格单行（.at 解析器不接受跨行）。
// · 已知偏差（golden 集不覆盖 corner）：相邻 hunk 仅因 b 侧间距分组而
//   b 窗交叠时，前组 add 行参考实现双渲染、本实现单渲染（SD-01 注记；
//   视觉=同行只画一次）。
pub fn diff_files_json(path_a str, path_b str, ctx int) str {
    var ctxn int = ctx
    if ctxn <= 0 {
        ctxn = 3
    }
    // ═══ 门 0：存在性（缺失→err 形，不静默——AC-02）═══
    if !File.exists(path_a) {
        return json.from_value({hunks: [], rows: [], adds: 0, dels: 0, truncated: false, degraded: false, err: "文件不存在: " + path_a})
    }
    if !File.exists(path_b) {
        return json.from_value({hunks: [], rows: [], adds: 0, dels: 0, truncated: false, degraded: false, err: "文件不存在: " + path_b})
    }
    // ═══ 门 1：尺寸 pre-read（fs.metadata 字节长——即时拒，§10）═══
    var sa int = fs.metadata(path_a)
    var sb int = fs.metadata(path_b)
    if sa > 1048576 {
        return json.from_value({hunks: [], rows: [], adds: 0, dels: 0, truncated: false, degraded: false, err: "文件超限（A " + sa.str() + "B >1MB）——等待内核引擎 diff_snapshots（架构阻塞）"})
    }
    if sb > 1048576 {
        return json.from_value({hunks: [], rows: [], adds: 0, dels: 0, truncated: false, degraded: false, err: "文件超限（B " + sb.str() + "B >1MB）——等待内核引擎 diff_snapshots（架构阻塞）"})
    }
    // ═══ 读 + 行切分（尾空元素吸收=python split_lines 等价）═══
    var ta str = File.read_text(path_a)
    var tb str = File.read_text(path_b)
    var a list = ta.split("\n")
    var b list = tb.split("\n")
    // CR 容忍：CRLF 行剥尾 \r（SD-02：\r\n 与 \n 等价）
    var ci0 int = 0
    while ci0 < a.len() {
        var ln0 str = a[ci0]
        if ln0.len() > 0 {
            if ln0.substr(ln0.len() - 1, 1) == "\r" {
                a.set(ci0, ln0.substr(0, ln0.len() - 1))
            }
        }
        ci0 = ci0 + 1
    }
    ci0 = 0
    while ci0 < b.len() {
        var ln1 str = b[ci0]
        if ln1.len() > 0 {
            if ln1.substr(ln1.len() - 1, 1) == "\r" {
                b.set(ci0, ln1.substr(0, ln1.len() - 1))
            }
        }
        ci0 = ci0 + 1
    }
    var la int = a.len()
    if la > 0 {
        var lasta str = a[la - 1]
        if lasta == "" {
            la = la - 1
        }
    }
    var lb int = b.len()
    if lb > 0 {
        var lastb str = b[lb - 1]
        if lastb == "" {
            lb = lb - 1
        }
    }
    // ═══ 门 2：行数 post-split（>10k→err，§10 定参）═══
    if la > 10000 {
        return json.from_value({hunks: [], rows: [], adds: 0, dels: 0, truncated: false, degraded: false, err: "文件超限（A " + la.str() + " 行 >10000）——等待内核引擎 diff_snapshots（架构阻塞）"})
    }
    if lb > 10000 {
        return json.from_value({hunks: [], rows: [], adds: 0, dels: 0, truncated: false, degraded: false, err: "文件超限（B " + lb.str() + " 行 >10000）——等待内核引擎 diff_snapshots（架构阻塞）"})
    }
    // ═══ ① 公共前后缀行裁剪 ═══
    var p int = 0
    var walk bool = true
    while walk {
        if p >= la {
            walk = false
        }
        if p >= lb {
            walk = false
        }
        if walk {
            if a[p] == b[p] {
                p = p + 1
            } else {
                walk = false
            }
        }
    }
    var s int = 0
    walk = true
    while walk {
        if s >= la - p {
            walk = false
        }
        if s >= lb - p {
            walk = false
        }
        if walk {
            if a[la - 1 - s] == b[lb - 1 - s] {
                s = s + 1
            } else {
                walk = false
            }
        }
    }
    var na int = la - p - s
    var nb int = lb - p - s
    // ═══ 绝对坐标流（keep/del/add；changes=非 keep 子流带流位 si——
    // 分组与 rows 切片共用；计数全手工——push 列表 .len() 未证面）═══
    var stream list = []
    var changes list = []
    var adds int = 0
    var dels int = 0
    var degraded bool = false
    var k0 int = 0
    while k0 < p {
        stream.push({k: "keep", i: k0, j: k0, si: k0})
        k0 = k0 + 1
    }
    var si int = p
    if na == 0 {
        var j0 int = 0
        while j0 < nb {
            stream.push({k: "add", i: p, j: p + j0, si: si})
            changes.push({k: "add", i: p, j: p + j0, si: si})
            adds = adds + 1
            si = si + 1
            j0 = j0 + 1
        }
    } else {
        if nb == 0 {
            var i0 int = 0
            while i0 < na {
                stream.push({k: "del", i: p + i0, j: p, si: si})
                changes.push({k: "del", i: p + i0, j: p, si: si})
                dels = dels + 1
                si = si + 1
                i0 = i0 + 1
            }
        } else {
            if na <= 200 {
                if nb <= 200 {
                    // ═══ ② DP-LCS（(na+1)×(nb+1) 表；del 优先回溯）═══
                    var tab list = []
                    var r0 int = 0
                    while r0 <= na {
                        var row list = []
                        var c0 int = 0
                        while c0 <= nb {
                            row.push(0)
                            c0 = c0 + 1
                        }
                        tab.push(row)
                        r0 = r0 + 1
                    }
                    var i5 int = na - 1
                    while i5 >= 0 {
                        var prev list = tab[i5 + 1]
                        var rr list = tab[i5]
                        var ai str = a[p + i5]
                        var j5 int = nb - 1
                        while j5 >= 0 {
                            var v int = 0
                            if ai == b[p + j5] {
                                var vv int = prev[j5 + 1]
                                v = vv + 1
                            } else {
                                var v1 int = prev[j5]
                                var v2 int = rr[j5 + 1]
                                v = v1
                                if v2 > v {
                                    v = v2
                                }
                            }
                            rr.set(j5, v)
                            j5 = j5 - 1
                        }
                        i5 = i5 - 1
                    }
                    // 回溯：keep/del/add → 流（绝对坐标；add 携 a 游标）
                    var bi int = 0
                    var bj int = 0
                    var ii int = p
                    var jj int = p
                    var walking bool = true
                    while walking {
                        if bi >= na {
                            walking = false
                        }
                        if bj >= nb {
                            walking = false
                        }
                        if walking {
                            if a[p + bi] == b[p + bj] {
                                stream.push({k: "keep", i: p + bi, j: p + bj, si: si})
                                bi = bi + 1
                                bj = bj + 1
                                ii = ii + 1
                                jj = jj + 1
                            } else {
                                var r1 list = tab[bi + 1]
                                var f1 int = r1[bj]
                                var r2 list = tab[bi]
                                var f2 int = r2[bj + 1]
                                if f1 >= f2 {
                                    stream.push({k: "del", i: p + bi, j: jj, si: si})
                                    changes.push({k: "del", i: p + bi, j: jj, si: si})
                                    dels = dels + 1
                                    bi = bi + 1
                                    ii = ii + 1
                                } else {
                                    stream.push({k: "add", i: ii, j: p + bj, si: si})
                                    changes.push({k: "add", i: ii, j: p + bj, si: si})
                                    adds = adds + 1
                                    bj = bj + 1
                                    jj = jj + 1
                                }
                            }
                            si = si + 1
                        }
                    }
                    while bi < na {
                        stream.push({k: "del", i: p + bi, j: jj, si: si})
                        changes.push({k: "del", i: p + bi, j: jj, si: si})
                        dels = dels + 1
                        bi = bi + 1
                        ii = ii + 1
                        si = si + 1
                    }
                    while bj < nb {
                        stream.push({k: "add", i: ii, j: p + bj, si: si})
                        changes.push({k: "add", i: ii, j: p + bj, si: si})
                        adds = adds + 1
                        bj = bj + 1
                        jj = jj + 1
                        si = si + 1
                    }
                } else {
                    degraded = true
                }
            } else {
                degraded = true
            }
            // ═══ ③ 降级：整块 del + 整块 add（单 replace hunk 注记）═══
            if degraded {
                var i6 int = 0
                while i6 < na {
                    stream.push({k: "del", i: p + i6, j: p, si: si})
                    changes.push({k: "del", i: p + i6, j: p, si: si})
                    dels = dels + 1
                    si = si + 1
                    i6 = i6 + 1
                }
                var j6 int = 0
                while j6 < nb {
                    stream.push({k: "add", i: p + na, j: p + j6, si: si})
                    changes.push({k: "add", i: p + na, j: p + j6, si: si})
                    adds = adds + 1
                    si = si + 1
                    j6 = j6 + 1
                }
            }
        }
    }
    var k1 int = 0
    while k1 < s {
        stream.push({k: "keep", i: la - s + k1, j: lb - s + k1, si: si})
        k1 = k1 + 1
        si = si + 1
    }
    // ═══ ⑤ hunk 切分（非 keep 间距 ≤2·ctxn 归组；ctx 扩张钳位；fc/lc=
    // 流位、fi=首变更 a 索引、ah=a 侧消费水位——rows 切片用内部字段）═══
    var hunks list = []
    var nch int = adds + dels
    var nh int = 0
    if nch > 0 {
        var g_open bool = false
        var g_a1 int = 0
        var g_a2 int = 0
        var g_b1 int = 0
        var g_b2 int = 0
        var g_fi int = 0
        var g_ah int = 0
        var g_fc int = 0
        var g_lc int = 0
        var last_i int = 0
        var last_j int = 0
        var ci1 int = 0
        while ci1 < nch {
            var ch = changes[ci1]
            var flush bool = false
            if g_open {
                var gi int = ch.i - last_i
                var gj int = ch.j - last_j
                var same bool = false
                if gi <= 2 * ctxn {
                    if gj <= 2 * ctxn {
                        same = true
                    }
                }
                if !same {
                    flush = true
                }
            }
            if flush {
                var h1 int = g_a1 - ctxn
                if h1 < 0 {
                    h1 = 0
                }
                var h2 int = g_a2 + ctxn
                if h2 > la {
                    h2 = la
                }
                var h3 int = g_b1 - ctxn
                if h3 < 0 {
                    h3 = 0
                }
                var h4 int = g_b2 + ctxn
                if h4 > lb {
                    h4 = lb
                }
                hunks.push({a1: h1, a2: h2, b1: h3, b2: h4, fc: g_fc, lc: g_lc, fi: g_fi, ah: g_ah})
                nh = nh + 1
                g_open = false
            }
            if !g_open {
                g_open = true
                g_a1 = ch.i
                g_a2 = ch.i
                g_b1 = ch.j
                g_b2 = ch.j
                g_fi = ch.i
                g_ah = ch.i
                g_fc = ch.si
                g_lc = ch.si
            } else {
                if ch.i < g_a1 {
                    g_a1 = ch.i
                }
                if ch.j < g_b1 {
                    g_b1 = ch.j
                }
            }
            var ca2 int = ch.i
            if ch.k == "del" {
                ca2 = ch.i + 1
            }
            if ca2 > g_a2 {
                g_a2 = ca2
            }
            var cb2 int = ch.j
            if ch.k == "add" {
                cb2 = ch.j + 1
            }
            if cb2 > g_b2 {
                g_b2 = cb2
            }
            if ca2 > g_ah {
                g_ah = ca2
            }
            g_lc = ch.si
            last_i = ch.i
            last_j = ch.j
            ci1 = ci1 + 1
        }
        if g_open {
            var h1 int = g_a1 - ctxn
            if h1 < 0 {
                h1 = 0
            }
            var h2 int = g_a2 + ctxn
            if h2 > la {
                h2 = la
            }
            var h3 int = g_b1 - ctxn
            if h3 < 0 {
                h3 = 0
            }
            var h4 int = g_b2 + ctxn
            if h4 > lb {
                h4 = lb
            }
            hunks.push({a1: h1, a2: h2, b1: h3, b2: h4, fc: g_fc, lc: g_lc, fi: g_fi, ah: g_ah})
            nh = nh + 1
        }
    }
    // ═══ rows 预计算（逐 hunk 流切片展开——切片=[fc-(fi-a1), lc+(a2-ah))
    // 纯 keep 翼+变更块，摊销 O(stream)；块内索引对齐配对+公共前后缀
    // 三段标记（全局字符预算 100k——超预算行整行 mid=Q-4 形态）═══
    var rows list = []
    var seg_budget int = 100000
    var hi2 int = 0
    while hi2 < nh {
        var hk = hunks[hi2]
        var lo int = hk.fc - (hk.fi - hk.a1)
        var hi3 int = hk.lc + (hk.a2 - hk.ah) + 1
        var oi int = lo
        while oi < hi3 {
            var op = stream[oi]
            if op.k == "keep" {
                var t0 str = a[op.i]
                rows.push({lo: op.i + 1, ro: op.j + 1, ln: t0, rn: t0, lk: "ctx", rk: "ctx", lpre: t0, lmid: "", lpost: "", rpre: t0, rmid: "", rpost: ""})
                oi = oi + 1
            } else {
                // 变更块：连续非 keep 段 [oi, be)——break 定界（本文件
                // search 循环同款已证面）
                var be int = oi
                while be < hi3 {
                    var o1 = stream[be]
                    if o1.k == "keep" {
                        break
                    }
                    be = be + 1
                }
                var ds list = []
                var ad list = []
                var nd int = 0
                var na2 int = 0
                var oj int = oi
                while oj < be {
                    var o2 = stream[oj]
                    if o2.k == "del" {
                        ds.push(o2.i)
                        nd = nd + 1
                    } else {
                        ad.push(o2.j)
                        na2 = na2 + 1
                    }
                    oj = oj + 1
                }
                oi = be
                // 块内索引对齐配对（i-th del 对 i-th add）
                var kk int = 0
                while kk < nd {
                    if kk < na2 {
                        // ④ 配对行：公共前后缀三段标记（预算内）
                        var di int = ds[kk]
                        var aj int = ad[kk]
                        var x str = a[di]
                        var y str = b[aj]
                        var lx int = x.len()
                        var ly int = y.len()
                        var lpre str = ""
                        var lmid str = x
                        var lpost str = ""
                        var rpre str = ""
                        var rmid str = y
                        var rpost str = ""
                        var cost int = lx + ly
                        if cost <= seg_budget {
                            seg_budget = seg_budget - cost
                            var pp int = 0
                            var top int = lx
                            if ly < top {
                                top = ly
                            }
                            var g3 bool = true
                            while g3 {
                                if pp >= top {
                                    g3 = false
                                }
                                if g3 {
                                    if x.substr(pp, 1) == y.substr(pp, 1) {
                                        pp = pp + 1
                                    } else {
                                        g3 = false
                                    }
                                }
                            }
                            var ss int = 0
                            g3 = true
                            while g3 {
                                if ss >= lx - pp {
                                    g3 = false
                                }
                                if ss >= ly - pp {
                                    g3 = false
                                }
                                if g3 {
                                    if x.substr(lx - 1 - ss, 1) == y.substr(ly - 1 - ss, 1) {
                                        ss = ss + 1
                                    } else {
                                        g3 = false
                                    }
                                }
                            }
                            lpre = x.substr(0, pp)
                            lmid = x.substr(pp, lx - ss - pp)
                            lpost = x.substr(lx - ss, ss)
                            rpre = y.substr(0, pp)
                            rmid = y.substr(pp, ly - ss - pp)
                            rpost = y.substr(ly - ss, ss)
                        }
                        rows.push({lo: di + 1, ro: aj + 1, ln: x, rn: y, lk: "del", rk: "add", lpre: lpre, lmid: lmid, lpost: lpost, rpre: rpre, rmid: rmid, rpost: rpost})
                    } else {
                        // 不成对 del 行：整行 mid（Q-4 裁定形）
                        var di2 int = ds[kk]
                        var x2 str = a[di2]
                        rows.push({lo: di2 + 1, ro: 0, ln: x2, rn: "", lk: "del", rk: "", lpre: "", lmid: x2, lpost: "", rpre: "", rmid: "", rpost: ""})
                    }
                    kk = kk + 1
                }
                var kk2 int = nd
                while kk2 < na2 {
                    // 不成对 add 行：整行 mid（Q-4 裁定形）
                    var aj2 int = ad[kk2]
                    var y2 str = b[aj2]
                    rows.push({lo: 0, ro: aj2 + 1, ln: "", rn: y2, lk: "", rk: "add", lpre: "", lmid: "", lpost: "", rpre: "", rmid: y2, rpost: ""})
                    kk2 = kk2 + 1
                }
            }
        }
        hi2 = hi2 + 1
    }
    // 信封 hunks 净形（内部 fc/lc/fi/ah 不出契约——SD-01 四字段）
    var hunks_out list = []
    var q2 int = 0
    while q2 < nh {
        var hk2 = hunks[q2]
        hunks_out.push({a1: hk2.a1, a2: hk2.a2, b1: hk2.b1, b2: hk2.b2})
        q2 = q2 + 1
    }
    return json.from_value({hunks: hunks_out, rows: rows, adds: adds, dels: dels, truncated: false, degraded: degraded, err: ""})
}

// ═════════════════════════════════════════════════════════════════
// 目录 diff（PLAN-012 T-01）——递归遍历 + 长度桶对齐 + 五态分类。
//
// envelope（SD-01 契约）：{entries:[{rel,status,size_a,size_b,is_dir,
// note}],counts:{same,added,deleted,modified,binary},truncated,err}——
// 左=path_a=旧（deleted=只在左）、右=path_b=新（added=只在右，BC 同款）。
// 分类序（T-00 定案）：存在性 → kind 冲突（dir↔file）→ 二进制启发式
// （size>0 且 read_text==""——≤2MB 全文域，任一侧命中=binary）→ 尺寸差
// → ≤2MB 全等（Str ==）→ >2MB 同尺寸=same+note="uncompared"（未比对
// 注记态——hash want 清偿前形态）。对齐=长度桶：rels 按 len() 直索引
// 256 桶+桶内等值扫（.at 无 sort/hash 原语的面内解，T-00 定案；同长
// 巨桶为步数预算上界——Phase A N=600/1500 定标）。条目上限 5000（超限
// truncated=true，counts 与 entries 同域——AC-03 计数一致性）；skip-list
// =fif_skipped 同语义（Explorer/find 口径一致）。读域：≤2MB 全文（启发
// 式读=全等比对读共用，零双读）；>2MB 不读。遍历=fs.list_dir 递归扁平
// （search_files 先例）；元数据采集 try 包裹（竞态删除跳过条目不炸端
// 点）；实现=全内联单函数（2044 文件局部 fn 返回值丢失疑回归规避，
// 011 同款）；record 字面量/调用实参严格单行。
pub fn diff_dirs_json(path_a str, path_b str) str {
    // ═══ 门 0：根存在性（err 形不静默——AC-02）═══
    if !File.exists(path_a) {
        return json.from_value({entries: [], counts: {same: 0, added: 0, deleted: 0, modified: 0, binary: 0}, truncated: false, err: "目录不存在: " + path_a})
    }
    if !File.exists(path_b) {
        return json.from_value({entries: [], counts: {same: 0, added: 0, deleted: 0, modified: 0, binary: 0}, truncated: false, err: "目录不存在: " + path_b})
    }
    var cap int = 5000
    var ccap int = 2097152
    // ═══ 根归一（尾分隔符剥除——abs 拼接面）═══
    var ra0 str = path_a.replace("\\", "/")
    while ra0.len() > 1 {
        var lc0 str = ra0.substr(ra0.len() - 1, 1)
        if lc0 == "/" {
            ra0 = ra0.substr(0, ra0.len() - 1)
        } else {
            break
        }
    }
    var rb0 str = path_b.replace("\\", "/")
    while rb0.len() > 1 {
        var lc1 str = rb0.substr(rb0.len() - 1, 1)
        if lc1 == "/" {
            rb0 = rb0.substr(0, rb0.len() - 1)
        } else {
            break
        }
    }
    // ═══ 双侧遍历（list_dir 递归扁平 JSON——search_files 先例；
    // json 列表 .len() 规避面：for-in+手工计数）═══
    var files_a = json.to_value(fs.list_dir(path_a))
    var rels_a list = []
    var sizes_a list = []
    var dirs_a list = []
    var na int = 0
    for f in files_a {
        var rel str = f.replace("\\", "/")
        if ra0 != "" {
            var stripped str = rel.replace(ra0 + "/", "")
            if stripped != rel {
                rel = stripped
            } else {
                if rel.replace(ra0, "") != rel {
                    rel = rel.replace(ra0, "")
                }
            }
        }
        if fif_skipped(rel) {
            continue
        }
        var s0 int = 0
        var d0 bool = false
        var bad bool = false
        try {
            s0 = fs.metadata(f)
            d0 = fs.is_dir(f)
        } catch {
            bad = true
        }
        if bad {
            continue
        }
        if d0 {
            s0 = 0
        }
        rels_a.push(rel)
        sizes_a.push(s0)
        dirs_a.push(d0)
        na = na + 1
    }
    var files_b = json.to_value(fs.list_dir(path_b))
    var rels_b list = []
    var sizes_b list = []
    var dirs_b list = []
    var nb int = 0
    for f in files_b {
        var rel str = f.replace("\\", "/")
        if rb0 != "" {
            var stripped str = rel.replace(rb0 + "/", "")
            if stripped != rel {
                rel = stripped
            } else {
                if rel.replace(rb0, "") != rel {
                    rel = rel.replace(rb0, "")
                }
            }
        }
        if fif_skipped(rel) {
            continue
        }
        var s0 int = 0
        var d0 bool = false
        var bad bool = false
        try {
            s0 = fs.metadata(f)
            d0 = fs.is_dir(f)
        } catch {
            bad = true
        }
        if bad {
            continue
        }
        if d0 {
            s0 = 0
        }
        rels_b.push(rel)
        sizes_b.push(s0)
        dirs_b.push(d0)
        nb = nb + 1
    }
    // ═══ 长度桶（256 直索引；B 侧索引入桶 + matched 旗标表）═══
    // 桶积护栏（Σk² 增量）：同长分布过密 → 对齐扫描超 VM per-handler
    // 10M 步预算（T-01 定标：N=800 单桶 640k 积=0.65s 过 / N=1000 1M 积
    // =WARN[budget] 死）→ 700k 护栏，超限 err 形不静默（架构阻塞注记，
    // 011 上限门同款；正解=sort/hash 原语，§15 want）。
    var buckets list = []
    var bk_n list = []
    var bcap int = 256
    var bi0 int = 0
    while bi0 < bcap {
        buckets.push([])
        bk_n.push(0)
        bi0 = bi0 + 1
    }
    var matched_b list = []
    var sumsq int = 0
    var bi1 int = 0
    while bi1 < nb {
        var rb2 str = rels_b[bi1]
        var lb0 int = rb2.len()
        if lb0 < bcap {
            var cur int = bk_n[lb0]
            sumsq = sumsq + 2 * cur + 1
            bk_n.set(lb0, cur + 1)
            var bk0 = buckets[lb0]
            bk0.push(bi1)
        }
        matched_b.push(false)
        bi1 = bi1 + 1
    }
    if sumsq > 700000 {
        return json.from_value({entries: [], counts: {same: 0, added: 0, deleted: 0, modified: 0, binary: 0}, truncated: false, err: "对齐超限（同长桶积 >700k——.at 无 sort/hash 原语，VM 步数预算墙，T-01 定标 N=800 过/N=1000 墙）——等待内核 sort/hash（架构阻塞）"})
    }
    // ═══ 条目构建：A 游走（配对分类/单侧 deleted）→ B 游走（单侧
    // added）——counts 与 entries 同域（AC-03）═══
    var entries list = []
    var c_same int = 0
    var c_added int = 0
    var c_deleted int = 0
    var c_modified int = 0
    var c_binary int = 0
    var truncated bool = false
    var total int = 0
    var ai int = 0
    while ai < na {
        if total >= cap {
            truncated = true
            break
        }
        var ra str = rels_a[ai]
        var matched int = -1
        var lb1 int = ra.len()
        if lb1 < bcap {
            var bk1 = buckets[lb1]
            for bv in bk1 {
                var rb3 str = rels_b[bv]
                if rb3 == ra {
                    matched = bv
                    break
                }
            }
        }
        var sa int = sizes_a[ai]
        var sb int = 0
        var st str = "deleted"
        var note str = ""
        var isd bool = dirs_a[ai]
        if matched >= 0 {
            matched_b.set(matched, true)
            sb = sizes_b[matched]
            st = "same"
            if dirs_a[ai] != dirs_b[matched] {
                st = "modified"
            } else {
                if dirs_a[ai] {
                    st = "same"
                } else {
                    var bin bool = false
                    var ta str = ""
                    var tb str = ""
                    if sa > 0 {
                        if sa <= ccap {
                            ta = File.read_text(ra0 + "/" + ra)
                            if ta == "" {
                                bin = true
                            }
                        }
                    }
                    if sb > 0 {
                        if sb <= ccap {
                            tb = File.read_text(rb0 + "/" + ra)
                            if tb == "" {
                                bin = true
                            }
                        }
                    }
                    if bin {
                        st = "binary"
                    } else {
                        if sa != sb {
                            st = "modified"
                        } else {
                            if sa > ccap {
                                st = "same"
                                note = "uncompared"
                            } else {
                                if ta == tb {
                                    st = "same"
                                } else {
                                    st = "modified"
                                }
                            }
                        }
                    }
                }
            }
        }
        if st == "same" {
            c_same = c_same + 1
        } else {
            if st == "deleted" {
                c_deleted = c_deleted + 1
            } else {
                if st == "modified" {
                    c_modified = c_modified + 1
                } else {
                    if st == "binary" {
                        c_binary = c_binary + 1
                    }
                }
            }
        }
        entries.push({rel: ra, status: st, size_a: sa, size_b: sb, is_dir: isd, note: note})
        total = total + 1
        ai = ai + 1
    }
    var bi2 int = 0
    while bi2 < nb {
        if total >= cap {
            truncated = true
            break
        }
        var mb bool = matched_b[bi2]
        if !mb {
            var rb4 str = rels_b[bi2]
            var sb2 int = sizes_b[bi2]
            var db1 bool = dirs_b[bi2]
            entries.push({rel: rb4, status: "added", size_a: 0, size_b: sb2, is_dir: db1, note: ""})
            c_added = c_added + 1
            total = total + 1
        }
        bi2 = bi2 + 1
    }
    return json.from_value({entries: entries, counts: {same: c_same, added: c_added, deleted: c_deleted, modified: c_modified, binary: c_binary}, truncated: truncated, err: ""})
}

// ═════════════════════════════════════════════════════════════════
// 同步动作（PLAN-012 T-02）——破坏性动作收口 back（front 零 fs 铁律）。
//
// sync_copy：文件=字节往返（read_bytes 1005→write_bytes 1006——fs.copy
// 1007 表面被 `copy` 保留字阻断，T-00 定案；≤2MB 预算域=内容比对同域，
// 超限 false[front 注记+§15 want]）；目录=fs.copy_recursive 2862（静默
// 覆盖=truncate/合并语义，Q-2 定案——front 确认链管目标存在形）。
// sync_delete：文件=fs.delete 1003；目录=**仅空目录** fs.remove_dir 1014
// （非空原生失败=T-00 护栏实证；递归删除 v1 不提供——remove_dir_all
// 1015 在册不暴露，§2 安全注记）。空路径/根路径/缺失源→false（护栏三
// 条——§2 安全注记）。bool 返回=磁盘 E2E 复核（动作后 exists 终判，
// T-00 载具同口径）。
pub fn sync_copy_impl(src str, dst str, is_dir bool) bool {
    if src == "" {
        return false
    }
    if dst == "" {
        return false
    }
    if !File.exists(src) {
        return false
    }
    if is_dir {
        try {
            fs.copy_recursive(src, dst)
            return File.exists(dst)
        } catch {
            return false
        }
    }
    var sz int = 0
    try {
        sz = fs.metadata(src)
    } catch {
        return false
    }
    if sz > 2097152 {
        return false
    }
    try {
        var data list = File.read_bytes(src)
        File.write_bytes(dst, data)
        return File.exists(dst)
    } catch {
        return false
    }
}

pub fn sync_delete_impl(path str, is_dir bool) bool {
    if path == "" {
        return false
    }
    if path == "/" {
        return false
    }
    if path == "\\" {
        return false
    }
    if path.len() <= 3 {
        if path.substr(1, 1) == ":" {
            return false
        }
    }
    if !File.exists(path) {
        return false
    }
    if is_dir {
        try {
            fs.remove_dir(path)
            return !File.exists(path)
        } catch {
            return false
        }
    }
    try {
        fs.delete(path)
        return !File.exists(path)
    } catch {
        return false
    }
}
