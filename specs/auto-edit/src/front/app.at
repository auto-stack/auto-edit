// app.at — auto-edit 根组件（Plan 449 组件化重构）。
//
// 结构（vm 渲染已验证能力的边界内，见 README「vm 组件边界」）：
//   editor_store.at   store EditorStore —— 全部状态与业务逻辑（038 形态）
//   status_bar.at     StatusBar 组件（013 形态：读 .store + 直调 store）
//   console_panel.at  ConsolePanel 组件（同上）
//   ctx_menu.at       EditorCtxMenu 组件（右键弹层锚态直读 .store）
//
// App 承担：actions 声明（Plan 451：动作注册表 + menubar/toolbar 经 DSL
// 声明，原 auto-edit.at 外挂配置并入）+ view 组合 + on 薄委托 store.Xxx()
// （事件名与 actions 的 handler 映射一一对应，Action=声明层，Event=执行层；
// handler 在解析期校验命中 on{} 事件）。热重载经 action_config_reload
// 工具或 mtime 轮询重读本文件重新提取。
// 以下交互必须留在根视图（MCP 矩阵的快照定位锚——vm 下组件子树对快照
// 不可见，回调 props 更会使组件整体退化，view fn 片段的参数化条件亦不
// 求值；均为 Plan 449 调查结论，详见 README「vm 组件边界」）：
//   tab 条（x 按钮形状定位、"+" 的 onclick: .ActOpen）、确认弹层
//   （"直接关闭" 文本定位）、编辑区（code_editor 绑定根事件）、空态文本。
// code_editor_* 内建的 Plan 449「store handler 坏字节码」结论已在 1836
// 工具链证伪（PLAN-007 T-00 探针；store 侧 RunPendingLoad 现役调用族），
// .ActNew 根侧 set_text 保留为原位清空行为（见 on 块注）。

use editor_store: EditorStore
use status_bar: StatusBar
use console_panel: ConsolePanel
use ctx_menu: EditorCtxMenu

style warn_label = "text-[12px] text-amber-400 mr-1"
widget App {
    // PLAN-618 T-06: tree 四件组件拷贝分发(package use 必须在 widget 内,
    // 顶层 parse 报 LBrace 错——027 T-03 同款结论)。
    use { package: official from "./components" }
    // ---- Plan 451: actions 声明块（原 auto-edit.at，DSL 化）----
    // 三源绑定：shortcut（键盘回退层，DSL onkeydown 之下）、menubar/toolbar
    // （view 中占位标签的配置合成）、MCP 自动化同源。enabled_if/checked_if
    // 为条件表达式字符串，对合并根 state 求值（.tab_count 等，无前缀）。
    // 注意：auto test 的 T10 热重载以 "actions {" / "menubar {" 行首字符串
    // 为插入锚——保持这两个标记。
    actions {
        action (id: "file.new",        handler: .ActNew,        title: "新建",   icon: "file-plus",   shortcut: "Ctrl+N")
        action (id: "file.open",       handler: .ActOpen,       title: "打开…",  icon: "folder-open", shortcut: "Ctrl+O")
        action (id: "file.save",       handler: .ActSave,       title: "保存",   icon: "save",        shortcut: "Ctrl+S",
                enabled_if: ".store.tab_count > 0")
        action (id: "file.quit",       handler: .ActQuit,       title: "退出",   shortcut: "Alt+F4")
        action (id: "edit.undo",       handler: .ActUndo,       title: "撤销",   icon: "undo-2",      shortcut: "Ctrl+Z",
                checked_if: ".store.edits > 0")
        action (id: "edit.redo",       handler: .ActRedo,       title: "重做",   icon: "redo-2",      shortcut: "Ctrl+Y")
        action (id: "edit.cut",        handler: .ActCut,        title: "剪切",   icon: "scissors")
        action (id: "edit.copy",       handler: .ActCopy,       title: "复制",   icon: "copy")
        action (id: "edit.paste",      handler: .ActPaste,      title: "粘贴",   icon: "clipboard")
        action (id: "edit.select-all", handler: .ActSelectAll,  title: "全选",   shortcut: "Ctrl+A")
        // PLAN-008 T-03: 行尾转换三命令（menubar 族无子菜单——「行尾」
        // 分组在编辑菜单内以 menubar-label 呈现，偏差在案）。
        action (id: "edit.eol-crlf",      handler: .ActEolCrlf,    title: "转为 CRLF (Windows)")
        action (id: "edit.eol-lf",        handler: .ActEolLf,      title: "转为 LF (Unix)")
        action (id: "edit.eol-cr",        handler: .ActEolCr,      title: "转为 CR (Mac)")
        // PLAN-009 T-02: 查找替换四命令（Ctrl+F 开栏 / Ctrl+H 开替换行 /
        // F3 下一处 / Ctrl+Shift+F 跨文件查找）。
        action (id: "edit.find",          handler: .ActFind,       title: "查找",   icon: "search",   shortcut: "Ctrl+F")
        action (id: "edit.replace",       handler: .ActReplace,    title: "替换…",  shortcut: "Ctrl+H")
        action (id: "edit.find-next",     handler: .FindNext,      title: "查找下一个", shortcut: "F3")
        action (id: "search.find-in-files", handler: .FifOpen,     title: "跨文件查找", shortcut: "Ctrl+Shift+F")
        action (id: "view.console",    handler: .ActConsole,    title: "切换 Console", icon: "terminal", shortcut: "Ctrl+J",
                checked_if: ".store.console_open")
        // 仅声明层快捷键(验证回退层):Ctrl+D 切换 tab
        action (id: "view.switch-tab", handler: .ActSwitchTab,  title: "切换 Tab", shortcut: "Ctrl+D")
        // Plan 428: 代码折叠(切换激活编辑器第 2 行的 fn 块)
        action (id: "view.fold",       handler: .ActFold,       title: "折叠切换")
        // PLAN-011 T-03/T-04: diff 链四命令（工具菜单同源；F7/Shift+F7
        // 导航；Esc 关闭——Escape token 解析面烟测裁定，败则摘除注记）。
        action (id: "diff.compare", handler: .DiffOpen,  title: "比较文件…", icon: "git-compare", shortcut: "Ctrl+Alt+D")
        action (id: "diff.next",    handler: .DiffNext,  title: "下一处差异", shortcut: "F7",
                enabled_if: ".store.diff_open")
        action (id: "diff.prev",    handler: .DiffPrev,  title: "上一处差异", shortcut: "Shift+F7",
                enabled_if: ".store.diff_open")
        action (id: "diff.close",   handler: .DiffClose, title: "关闭比较", shortcut: "Escape",
                enabled_if: ".store.diff_open")
        action (id: "help.about",      handler: .ActAbout,      title: "关于 auto-edit")

        toolbar {
            item (action: "file.new")
            item (action: "file.open")
            item (action: "file.save")
            sep
            item (action: "edit.undo")
            item (action: "edit.redo")
            sep
            item (action: "edit.cut")
            item (action: "edit.copy")
            item (action: "edit.paste")
        }
    }

    view {
        col (style: "h-full w-full") {

            row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0 px-2") {
                // PLAN-630 T-03: 声明式可复用 menubar 组件族（迁移自 actions
                // DSL 占位合成；actions 块保留 shortcut 三源绑定）。VM=Popover
                // 原语 lowering；Vue=shadcn Menubar。
                menubar (class: "items-center") {
                    menubar-menu (value: "file") {
                        menubar-trigger "文件"
                        menubar-content {
                            menubar-item (title: "新建", icon: "file-plus", shortcut: "Ctrl+N") { onclick: .ActNew }
                            menubar-item (title: "打开…", icon: "folder-open", shortcut: "Ctrl+O") { onclick: .ActOpen }
                            menubar-item (title: "保存", icon: "save", shortcut: "Ctrl+S", enabled: .store.tab_count > 0) { onclick: .ActSave }
                            menubar-separator
                            menubar-item (title: "退出", icon: "log-out", shortcut: "Alt+F4") { onclick: .ActQuit }
                        }
                    }
                    menubar-menu (value: "edit") {
                        menubar-trigger "编辑"
                        menubar-content {
                            menubar-item (title: "撤销", icon: "undo-2", shortcut: "Ctrl+Z") { onclick: .ActUndo }
                            menubar-item (title: "重做", icon: "redo-2", shortcut: "Ctrl+Y") { onclick: .ActRedo }
                            menubar-separator
                            menubar-item (title: "剪切", icon: "scissors") { onclick: .ActCut }
                            menubar-item (title: "复制", icon: "copy") { onclick: .ActCopy }
                            menubar-item (title: "粘贴", icon: "clipboard") { onclick: .ActPaste }
                            menubar-item (title: "全选", shortcut: "Ctrl+A") { onclick: .ActSelectAll }
                            menubar-separator
                            // PLAN-009 T-02: 查找替换入口（与 actions 快捷键同源）。
                            menubar-item (title: "查找", icon: "search", shortcut: "Ctrl+F") { onclick: .ActFind }
                            menubar-item (title: "替换…", shortcut: "Ctrl+H") { onclick: .ActReplace }
                            menubar-item (title: "查找下一个", shortcut: "F3") { onclick: .FindNext }
                            menubar-item (title: "跨文件查找", shortcut: "Ctrl+Shift+F") { onclick: .FifOpen }
                            menubar-separator
                            // PLAN-695 T-12: 行尾分组升级为 menubar-sub
                            //（消费 T-06 submenu 能力；原 PLAN-008 T-03
                            // 平铺三命令 + label 形态退役——label 曾被
                            // 双臂静默吞，本批已根修）。
                            menubar-sub {
                                menubar-sub-trigger (text: "行尾")
                                menubar-sub-content {
                                    menubar-item (title: "转为 CRLF (Windows)") { onclick: .ActEolCrlf }
                                    menubar-item (title: "转为 LF (Unix)") { onclick: .ActEolLf }
                                    menubar-item (title: "转为 CR (Mac)") { onclick: .ActEolCr }
                                }
                            }
                        }
                    }
                    menubar-menu (value: "view") {
                        menubar-trigger "视图"
                        menubar-content {
                            menubar-checkbox-item (title: "切换 Console", icon: "terminal", checked: .store.console_open, shortcut: "Ctrl+J") { onclick: .ActConsole }
                            menubar-item (title: "切换 Tab", shortcut: "Ctrl+D") { onclick: .ActSwitchTab }
                            menubar-item (title: "折叠切换", icon: "chevrons-down-up") { onclick: .ActFold }
                        }
                    }
                    menubar-menu (value: "tools") {
                        menubar-trigger "工具"
                        menubar-content {
                            // PLAN-011 T-03: diff 入口（静态 menubar item
                            // ——010 menubar-content 四边界内：静态+无参
                            // handler 已证面）。
                            menubar-item (title: "比较文件…", icon: "git-compare", shortcut: "Ctrl+Alt+D") { onclick: .DiffOpen }
                            // PLAN-012 T-03: 目录 diff 入口（静态 item 同款
                            // ——v1 路径输入框路径，folder picker=§15 want）。
                            menubar-item (title: "比较目录…", icon: "git-compare") { onclick: .DirDiffOpen }
                            menubar-separator
                            menubar-item (title: "下一处差异", shortcut: "F7") { onclick: .DiffNext }
                            menubar-item (title: "上一处差异", shortcut: "Shift+F7") { onclick: .DiffPrev }
                        }
                    }
                    menubar-menu (value: "help") {
                        menubar-trigger "帮助"
                        menubar-content {
                            menubar-item (title: "关于 auto-edit", icon: "info") { onclick: .ActAbout }
                        }
                    }
                }
                toolbar (style: "ml-auto") {}
            }
            // PLAN-618 T-06: 左文件浏览器树 + 右编辑区双列。tab 条/编辑区
            // 仍留在根视图(Plan 449 vm 组件边界约束指的是组件子树,容器
            // 嵌套不受限)。
            row (style: "flex-1 items-stretch overflow-hidden w-full") {
                col (style: "w-56 shrink-0 border-r border-border bg-card hidden md:flex flex-col gap-2 p-2 overflow-y-auto") {
                    text "EXPLORER" { style: "text-[11px] text-muted-foreground px-1 pt-1 tracking-wider" }
                    text .store.ws_name { style: "text-[11px] text-muted-foreground px-1 pb-1" }
                    TreeView (nodes: .store.tree_nodes, expanded: .store.tree_expanded, selected: .store.tree_sel, on_toggle: .TreeToggle, on_select: .TreeSelect, directory: true) {}
                    // PLAN-010 T-03: 最近文件（Explorer 侧栏平铺节——设计
                    // 适配在案：menubar-content 组件内容模型三边界（探针
                    // menu2/隔离实验实勘）——for 不吸收、label 不吸收、
                    // if 守卫动态条目跨重建不可靠（关 tab 即失真，config
                    // reload 不救）、带参 onclick 实参归零。根视图 for +
                    // 裸循环索引 onclick=fif 结果面板同款已证面。上限 10
                    // 与 recents 契约一致）。
                    text "最近文件" { style: "text-[11px] text-muted-foreground px-1 pt-2 tracking-wider" }
                    for ri, r in .store.recents {
                        button (text: r.title, variant: "text") {
                            onclick: .RecentOpen(ri)
                            style: "h-6 px-1 text-[11px] text-muted-foreground justify-start w-full"
                        }
                    }
                    if .store.recents_count == 0 {
                        text "（空）" { style: "text-[11px] text-muted-foreground px-1" }
                    }
                }
                col (style: "flex-1 overflow-hidden") {
                    row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0") {
                        // 激活/非激活双分支保留原形态：view fn 片段的参数化条件
                        // （onclick 实参/条件样式/if 分支）在 vm 视图构建中不求值，
                        // 尚不可用于此（Plan 449 调查结论，见 README）。
                        for i, t in .store.tabs {
                            if i == .store.tab {
                                // PLAN-695 T-12: 激活 tab 底 #1C1D24 → bg-card（卡片微浮 token，浅色白板）。
                                row (style: "items-center bg-card") {
                                    button (text: t.title, variant: "text") {
                                        onclick: .TabActivate(i)
                                        style: "h-8 px-3 text-[12px] text-foreground font-medium"
                                    }
                                    if t.dirty {
                                        text "*" { style: warn_label }
                                    }
                                    button (variant: "text") {
                                        icon (name: "x", style: "h-3 w-3 text-muted-foreground") {}
                                        onclick: .CloseTab(i)
                                        style: "h-7 w-6 px-0 py-0 mr-2"
                                    }
                                }
                            }
                            if i != .store.tab {
                                row (style: "items-center") {
                                    button (text: t.title, variant: "text") {
                                        onclick: .TabActivate(i)
                                        style: "h-8 px-3 text-[12px] text-muted-foreground"
                                    }
                                    if t.dirty {
                                        text "*" { style: warn_label }
                                    }
                                }
                            }
                        }
                        button (variant: "text") {
                            icon (name: "plus", style: "h-3.5 w-3.5 text-muted-foreground") {}
                            onclick: .ActOpen
                            style: "h-7 w-7 px-0 py-0 ml-1"
                        }
                    }
                    col (style: "h-px w-full bg-border shrink-0")

                    // PLAN-009 T-02: 查找栏（根视图——Plan 449 快照定位约束，
                    // tab 条与编辑区之间）。input 双向=T-00④ handler 首参形；
                    // 三开关双分支 variant 切换（tab 激活/非激活同款条件节点
                    // 惯例——vm 视图不支持参数化样式表达式）。
                    if .store.find_open {
                        col (style: "shrink-0 w-full bg-muted/10 border-b border-border") {
                            row (style: "h-9 items-center gap-1 px-2 shrink-0") {
                                input {
                                    value: .store.find_query
                                    oninput: .FindInput
                                    placeholder: "查找"
                                    style: "h-7 flex-1 min-w-0 px-2 text-[12px]"
                                }
                                if .store.find_case {
                                    button (text: "Aa", variant: "outline") { onclick: .FindToggleCase
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.find_case {
                                    button (text: "Aa", variant: "text") { onclick: .FindToggleCase
                                        style: "h-6 px-2 text-[11px] text-muted-foreground" }
                                }
                                if .store.find_word {
                                    button (text: "[w]", variant: "outline") { onclick: .FindToggleWord
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.find_word {
                                    button (text: "[w]", variant: "text") { onclick: .FindToggleWord
                                        style: "h-6 px-2 text-[11px] text-muted-foreground" }
                                }
                                if .store.find_regex {
                                    button (text: ".*", variant: "outline") { onclick: .FindToggleRegex
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.find_regex {
                                    button (text: ".*", variant: "text") { onclick: .FindToggleRegex
                                        style: "h-6 px-2 text-[11px] text-muted-foreground" }
                                }
                                button (text: "下一处", variant: "text") { onclick: .FindNext
                                    style: "h-6 px-2 text-[11px] text-muted-foreground" }
                                button (variant: "text") {
                                    icon (name: "x", style: "h-3 w-3 text-muted-foreground") {}
                                    onclick: .FindClose
                                    style: "h-6 w-6 px-0 py-0"
                                }
                            }
                            // 替换行（Ctrl+H 展开）。
                            if .store.find_replace_mode {
                                row (style: "h-9 items-center gap-1 px-2 shrink-0") {
                                    input {
                                        value: .store.find_replacement
                                        oninput: .FindReplaceInput
                                        placeholder: "替换为"
                                        style: "h-7 flex-1 min-w-0 px-2 text-[12px]"
                                    }
                                    // PLAN-009 T-03: 全部替换（readonly 拦截
                                    // + 计数反馈在 store handler）。
                                    button (text: "全部替换", variant: "outline") { onclick: .ReplaceAllRequest
                                        style: "h-6 px-2 text-[11px]" }
                                }
                            }
                        }
                    }

                    // PLAN-012 T-03/T-04: 目录 diff 面板（根视图全幅态；
                    // dir_mode ⟺ diff_open 由 handler 组维护——dir_mode
                    // 顶层面板条件+文件视图内卫，编辑区条件 !diff_open
                    // 零改动）。行渲染=五状态五独立 for（011 四循环同款
                    // ——同循环兄弟 if 对 record 字段仅首个生效实勘规避）；
                    // 徽标/尺寸串/目录标记/未比对注记全 store 预变换。
                    // 同步动作钮=恢复语义直执行/双侧恒确认（Q-2）；删除
                    // 仅单侧条目（SD-01）。
                    if .store.dir_mode {
                        col (style: "flex-1 w-full overflow-hidden") {
                            row (style: "h-9 items-center bg-muted/30 shrink-0 w-full gap-1 px-2") {
                                text "DIRDIFF" { style: "text-[11px] font-bold text-muted-foreground shrink-0" }
                                input {
                                    value: .store.dir_a
                                    oninput: .DirAInput
                                    placeholder: "目录 A（左/旧）"
                                    style: "h-7 flex-1 min-w-0 px-2 text-[12px]"
                                }
                                input {
                                    value: .store.dir_b
                                    oninput: .DirBInput
                                    placeholder: "目录 B（右/新）"
                                    style: "h-7 flex-1 min-w-0 px-2 text-[12px]"
                                }
                                button (text: "比较", variant: "outline") { onclick: .DirDiffCompute
                                    style: "h-7 px-2 text-[11px] shrink-0" }
                                button (text: "×", variant: "text") { onclick: .DirDiffClose
                                    style: "h-7 w-6 px-0 py-0 shrink-0" }
                            }
                            row (style: "h-7 items-center bg-muted/30 shrink-0 w-full gap-2 px-2") {
                                text "同 ${.store.dir_n_same} 增 ${.store.dir_n_added} 删 ${.store.dir_n_deleted} 改 ${.store.dir_n_modified} 二进 ${.store.dir_n_binary}" { style: "text-[11px] text-muted-foreground shrink-0" }
                                if .store.dir_truncated {
                                    text "（条目截断）" { style: "text-[12px] text-amber-400 mr-1 shrink-0" }
                                }
                                if .store.dir_view_truncated {
                                    text "（渲染截断 600）" { style: "text-[12px] text-amber-400 mr-1 shrink-0" }
                                }
                                if .store.dir_has_err {
                                    text .store.dir_err { style: "text-[12px] text-red-400 mr-1 shrink-0" }
                                }
                            }
                            row (style: "h-7 items-center bg-muted/30 shrink-0 w-full gap-1 px-2") {
                                if .store.dir_f_all {
                                    button (text: "全部", variant: "outline") { onclick: .DirFilterAll
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.dir_f_all {
                                    button (text: "全部", variant: "text") { onclick: .DirFilterAll
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if .store.dir_f_added {
                                    button (text: "增", variant: "outline") { onclick: .DirFilterAdded
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.dir_f_added {
                                    button (text: "增", variant: "text") { onclick: .DirFilterAdded
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if .store.dir_f_deleted {
                                    button (text: "删", variant: "outline") { onclick: .DirFilterDeleted
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.dir_f_deleted {
                                    button (text: "删", variant: "text") { onclick: .DirFilterDeleted
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if .store.dir_f_modified {
                                    button (text: "改", variant: "outline") { onclick: .DirFilterModified
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.dir_f_modified {
                                    button (text: "改", variant: "text") { onclick: .DirFilterModified
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if .store.dir_f_binary {
                                    button (text: "二进", variant: "outline") { onclick: .DirFilterBinary
                                        style: "h-6 px-2 text-[11px]" }
                                }
                                if !.store.dir_f_binary {
                                    button (text: "二进", variant: "text") { onclick: .DirFilterBinary
                                        style: "h-6 px-2 text-[11px]" }
                                }
                            }
                            container (style: "flex-1 w-full") {
                                scroll-pane (style: "h-full w-full") {
                                    col (style: "gap-0 p-0 w-full") {
                                        for vi, r in .store.dir_view {
                                            if r.e_same {
                                                row (style: "h-6 w-full gap-1 shrink-0 items-center px-2") {
                                                    button (text: r.d_rel, variant: "text") { onclick: .DirRowClick(vi)
                                                        style: "h-6 flex-1 min-w-0 justify-start text-left text-[12px] font-mono text-muted-foreground" }
                                                    text r.badge { style: "h-6 w-8 text-[11px] text-muted-foreground shrink-0" }
                                                    text r.d_sa { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    text r.d_sb { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    if r.has_note {
                                                        text "未比对" { style: "h-6 text-[11px] text-amber-400 shrink-0" }
                                                    }
                                                }
                                            }
                                        }
                                        for vi, r in .store.dir_view {
                                            if r.e_added {
                                                row (style: "h-6 w-full gap-1 shrink-0 items-center px-2") {
                                                    button (text: r.d_rel, variant: "text") { onclick: .DirRowClick(vi)
                                                        style: "h-6 flex-1 min-w-0 justify-start text-left text-[12px] font-mono text-emerald-400" }
                                                    text r.badge { style: "h-6 w-8 text-[11px] text-emerald-400 shrink-0" }
                                                    text r.d_sa { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    text r.d_sb { style: "h-6 w-16 text-right text-[11px] font-mono text-emerald-400 shrink-0" }
                                                    button (text: "←", variant: "text") { onclick: .DirCopyLeft(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] shrink-0" }
                                                    button (text: "✕", variant: "text") { onclick: .DirDeleteB(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] text-red-400 shrink-0" }
                                                }
                                            }
                                        }
                                        for vi, r in .store.dir_view {
                                            if r.e_deleted {
                                                row (style: "h-6 w-full gap-1 shrink-0 items-center px-2") {
                                                    button (text: r.d_rel, variant: "text") { onclick: .DirRowClick(vi)
                                                        style: "h-6 flex-1 min-w-0 justify-start text-left text-[12px] font-mono text-red-400 line-through" }
                                                    text r.badge { style: "h-6 w-8 text-[11px] text-red-400 shrink-0" }
                                                    text r.d_sa { style: "h-6 w-16 text-right text-[11px] font-mono text-red-400 shrink-0" }
                                                    text r.d_sb { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    button (text: "→", variant: "text") { onclick: .DirCopyRight(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] shrink-0" }
                                                    button (text: "✕", variant: "text") { onclick: .DirDeleteA(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] text-red-400 shrink-0" }
                                                }
                                            }
                                        }
                                        for vi, r in .store.dir_view {
                                            if r.e_modified {
                                                row (style: "h-6 w-full gap-1 shrink-0 items-center px-2") {
                                                    button (text: r.d_rel, variant: "text") { onclick: .DirRowClick(vi)
                                                        style: "h-6 flex-1 min-w-0 justify-start text-left text-[12px] font-mono text-amber-400" }
                                                    text r.badge { style: "h-6 w-8 text-[11px] text-amber-400 shrink-0" }
                                                    text r.d_sa { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    text r.d_sb { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    button (text: "→", variant: "text") { onclick: .DirCopyRight(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] shrink-0" }
                                                    button (text: "←", variant: "text") { onclick: .DirCopyLeft(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] shrink-0" }
                                                }
                                            }
                                        }
                                        for vi, r in .store.dir_view {
                                            if r.e_binary {
                                                row (style: "h-6 w-full gap-1 shrink-0 items-center px-2") {
                                                    button (text: r.d_rel, variant: "text") { onclick: .DirRowClick(vi)
                                                        style: "h-6 flex-1 min-w-0 justify-start text-left text-[12px] font-mono text-violet-400" }
                                                    text r.badge { style: "h-6 w-8 text-[11px] text-violet-400 shrink-0" }
                                                    text r.d_sa { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    text r.d_sb { style: "h-6 w-16 text-right text-[11px] font-mono text-muted-foreground shrink-0" }
                                                    button (text: "→", variant: "text") { onclick: .DirCopyRight(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] shrink-0" }
                                                    button (text: "←", variant: "text") { onclick: .DirCopyLeft(vi)
                                                        style: "h-6 w-6 px-0 py-0 text-[11px] shrink-0" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // PLAN-011 T-03: diff 并排视图（根视图全幅态——
                    // diff_open 条件替换编辑区，console_open 条件面同款；
                    // tab 集零扰动，DiffClose 复原）。行形状四分支（pair/
                    // del-only/add-only/ctx——vm 条件样式仅双分支惯例，
                    // 相邻同形状 if 互斥）；行内三段 text（pre/mid/post，
                    // mid 着重色，空段零宽无害——ctx 行 lpre=全文本）；
                    // 行号=store 预变换字符串（缺席侧空串——视图零条件
                    // 格式化）；顶部状态条（文件名×2/±计数/hunk 位次/
                    // 截断/降级注记）+导航按钮+关闭。scroll controller
                    // 绑定（T-04 跳转句柄，PLAN-656；容器定高包裹——
                    // T-00③ h-*直挂退化实测）。PLAN-012: dir_mode 内卫
                    // （下钻/面板互斥——dirs 面板显示时文件视图不进）。
                    if .store.diff_open {
                        if !.store.dir_mode {
                        col (style: "flex-1 w-full overflow-hidden") {
                            row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-2 px-2") {
                                text "DIFF" { style: "text-[11px] font-bold text-muted-foreground shrink-0" }
                                text "${.store.diff_title_a} ↔ ${.store.diff_title_b}" { style: "text-[11px] text-muted-foreground shrink-0" }
                                text "+${.store.diff_adds} −${.store.diff_dels}" { style: "text-[11px] text-emerald-400 shrink-0" }
                                text "hunk ${.store.diff_hunk_pos}" { style: "text-[11px] text-muted-foreground shrink-0" }
                                if .store.diff_rows_truncated {
                                    text "渲染截断（600）" { style: "text-[12px] text-amber-400 mr-1 shrink-0" }
                                }
                                if .store.diff_degraded {
                                    text "大段降级" { style: "text-[12px] text-amber-400 mr-1 shrink-0" }
                                }
                                button (text: "上一处", variant: "text") { onclick: .DiffPrev
                                    style: "h-6 px-2 text-[11px] text-muted-foreground" }
                                button (text: "下一处", variant: "text") { onclick: .DiffNext
                                    style: "h-6 px-2 text-[11px] text-muted-foreground" }
                                if .store.dir_from_dirs {
                                    button (text: "返回目录", variant: "text") { onclick: .DirBackToDirs
                                        style: "h-6 px-2 text-[11px] text-muted-foreground" }
                                }
                                button (text: "×", variant: "text") { onclick: .DiffClose
                                    style: "h-6 w-6 px-0 py-0 ml-auto" }
                            }
                            container (style: "flex-1 w-full") {
                                scroll-pane (controller: .store.diff_scroll, style: "h-full w-full") {
                                    col (style: "gap-0 p-0 w-full") {
                                        // 四独立 for 循环（每循环单 bool 旗标
                                        // if——同循环多兄弟 if 对 record 字段
                                        // 仅首个生效实勘 T-03[ctx 渲染 pair 哑
                                        // 火，18/3 分裂]；独立循环=结构首位
                                        // 规避；互斥由 store 侧构造保证）。
                                        for ri, r in .store.diff_rows {
                                            if r.sx_pair {
                                                row (style: "h-6 w-full gap-0 shrink-0") {
                                                    text "${r.d_lo}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-red-300 bg-red-100 shrink-0" }
                                                    text "${r.d_ro}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-emerald-300 bg-emerald-100 shrink-0" }
                                                    text "${r.lpre}" { style: "h-6 text-xs font-mono bg-red-100 shrink-0" }
                                                    text "${r.lmid}" { style: "h-6 text-xs font-mono text-amber-300 bg-red-100 shrink-0" }
                                                    text "${r.lpost}" { style: "h-6 flex-1 text-xs font-mono bg-red-100 shrink-0" }
                                                    text "${r.rpre}" { style: "h-6 text-xs font-mono bg-emerald-100 shrink-0" }
                                                    text "${r.rmid}" { style: "h-6 text-xs font-mono text-amber-300 bg-emerald-100 shrink-0" }
                                                    text "${r.rpost}" { style: "h-6 flex-1 text-xs font-mono bg-emerald-100 shrink-0" }
                                                }
                                            }
                                        }
                                        for ri, r in .store.diff_rows {
                                            if r.sx_ctx {
                                                row (style: "h-6 w-full gap-0 shrink-0") {
                                                    text "${r.d_lo}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-muted-foreground shrink-0" }
                                                    text "${r.d_ro}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-muted-foreground shrink-0" }
                                                    text "${r.lpre}" { style: "h-6 text-xs font-mono shrink-0" }
                                                    text "${r.lmid}" { style: "h-6 text-xs font-mono shrink-0" }
                                                    text "${r.lpost}" { style: "h-6 flex-1 text-xs font-mono shrink-0" }
                                                    text "${r.rpre}" { style: "h-6 text-xs font-mono shrink-0" }
                                                    text "${r.rmid}" { style: "h-6 text-xs font-mono shrink-0" }
                                                    text "${r.rpost}" { style: "h-6 flex-1 text-xs font-mono shrink-0" }
                                                }
                                            }
                                        }
                                        for ri, r in .store.diff_rows {
                                            if r.sx_del {
                                                row (style: "h-6 w-full gap-0 shrink-0") {
                                                    text "${r.d_lo}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-red-300 bg-red-100 shrink-0" }
                                                    text "${r.d_ro}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-muted-foreground shrink-0" }
                                                    text "${r.lpre}" { style: "h-6 text-xs font-mono bg-red-100 shrink-0" }
                                                    text "${r.lmid}" { style: "h-6 text-xs font-mono text-amber-300 bg-red-100 shrink-0" }
                                                    text "${r.lpost}" { style: "h-6 flex-1 text-xs font-mono bg-red-100 shrink-0" }
                                                    text "" { style: "h-6 flex-1 text-xs font-mono shrink-0" }
                                                    text "" { style: "h-6 text-xs font-mono shrink-0" }
                                                    text "" { style: "h-6 flex-1 text-xs font-mono shrink-0" }
                                                }
                                            }
                                        }
                                        for ri, r in .store.diff_rows {
                                            if r.sx_add {
                                                row (style: "h-6 w-full gap-0 shrink-0") {
                                                    text "${r.d_lo}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-muted-foreground shrink-0" }
                                                    text "${r.d_ro}" { style: "h-6 w-12 px-1 text-right text-xs font-mono text-emerald-300 bg-emerald-100 shrink-0" }
                                                    text "" { style: "h-6 flex-1 text-xs font-mono shrink-0" }
                                                    text "" { style: "h-6 text-xs font-mono shrink-0" }
                                                    text "" { style: "h-6 flex-1 text-xs font-mono shrink-0" }
                                                    text "${r.rpre}" { style: "h-6 text-xs font-mono bg-emerald-100 shrink-0" }
                                                    text "${r.rmid}" { style: "h-6 text-xs font-mono text-amber-300 bg-emerald-100 shrink-0" }
                                                    text "${r.rpost}" { style: "h-6 flex-1 text-xs font-mono bg-emerald-100 shrink-0" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }

                    if !.store.diff_open {
                        for i, t in .store.tabs {
                            if t.key == .store.active_key {
                                code_editor (key: t.key, lang: "auto", style: "flex-1 w-full") {
                                    content: t.src
                                    // PLAN-009 T-02: 查找高亮接线（Ident 绑定，
                                    // T-00① 正案；live diff + 非空首跳）。
                                    search: .store.find_effective
                                    oninput: .SrcChanged(i)
                                    oncursor: .CursorMoved(i)
                                    oncontextmenu: .EditorCtx
                                }
                            }
                        }
                        if .store.tab_count == 0 {
                            col (style: "flex-1 w-full items-center justify-center") {
                                text "没有打开的文件 — 点击 + 或「文件 → 打开」" {
                                    style: "text-[13px] text-muted-foreground"
                                }
                            }
                        }
                    }

                    if .store.console_open {
                        ConsolePanel()
                    }

                    // PLAN-009 T-04: find-in-files 结果面板（内联根视图——
                    // Plan 449 快照定位约束：条目点击必须 MCP 可达，组件
                    // 子树对快照不可见故不用 console_panel 形态；面板开合
                    // FifOpen/FifClose，搜索打 find_effective 同查找面）。
                    if .store.fif_open {
                        col (style: "w-full shrink-0") {
                            col (style: "h-px w-full bg-border")
                            row (style: "h-7 items-center bg-muted/30 shrink-0 gap-3 px-2") {
                                text "FIND RESULTS" {
                                    style: "text-[11px] font-bold text-muted-foreground"
                                }
                                button (text: "搜索", variant: "text") { onclick: .FifSearch
                                    style: "text-[11px] h-5 px-1 text-muted-foreground" }
                                button (text: "×", variant: "text") { onclick: .FifClose
                                    style: "text-[11px] h-5 px-1 text-muted-foreground" }
                                text "${.store.fif_count} 处" {
                                    style: "text-[11px] text-muted-foreground ml-auto"
                                }
                            }
                            col (style: "p-2 max-h-40 w-full overflow-hidden bg-muted/10 shrink-0") {
                                // 行点击载荷=裸循环索引（TabActivate(i) 先例；
                                // 字段访问载荷 r.file 经 MCP 派发面携带字面量
                                // 不解析——T-06 实勘，见 FifResultClick 注）。
                                for idx, r in .store.fif_results {
                                    button (text: "${r.file}:${r.line}: ${r.preview}", variant: "text") {
                                        onclick: .FifResultClick(idx)
                                        style: "h-6 px-1 text-[11px] font-mono text-muted-foreground text-left w-full"
                                    }
                                }
                                if .store.fif_truncated {
                                    text "…结果已截断（上限 500 条）" {
                                        style: "text-[11px] text-muted-foreground"
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Plan 422 P3: 坐标锚弹层 —— 右键编辑器时 EditorCtx(x, y) 记录
            // 落点并置开；面板本体在 ctx_menu.at 组件。
            EditorCtxMenu()

            // Plan 626 T-06: 关闭脏 tab 的确认改标准 alert-dialog(PLAN-530
            // 模态族,取代原固定坐标 popover——VM 下曾落回普通流渲染错位)。
            alert-dialog (open: .store.confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "有未保存的修改"
                        alert-dialog-description "关闭前要保存吗?"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .ConfirmCancel }
                        alert-dialog-action "直接关闭" { onclick: .ConfirmClose }
                    }
                }
            }

            // Plan 626 T-06: 退出/关窗确认(窗口 X 经 CloseRequest 拦截与
            // 菜单「退出」共用入口;有脏 tab 时弹出)。
            alert-dialog (open: .store.quit_confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "有未保存的修改"
                        alert-dialog-description "退出前要保存吗?"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .QuitConfirmCancel }
                        alert-dialog-action "不保存退出" { onclick: .QuitDiscard }
                        alert-dialog-action "保存并退出" { onclick: .QuitSaveClose }
                    }
                }
            }

            // PLAN-008 T-03: mixed 行尾转换确认（统一将抹平混合形态）。
            alert-dialog (open: .store.eol_confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "混合行尾"
                        alert-dialog-description "文件包含混合行尾形态。统一转换将把所有行尾改为目标形态，继续吗?"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .EolConfirmCancel }
                        alert-dialog-action "统一转换" { onclick: .EolConfirmGo }
                    }
                }
            }

            // PLAN-012 T-04: 目录同步动作确认链（覆盖复制/单侧删除——
            // 破坏性动作纪律；pending 意图冻结在 store，Go 执行+重比）。
            alert-dialog (open: .store.dir_confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "确认同步动作"
                        alert-dialog-description .store.dir_confirm_text
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .DirConfirmCancel }
                        alert-dialog-action "确认执行" { onclick: .DirConfirmGo }
                    }
                }
            }

            StatusBar()
        }
    }

    on {
        // PLAN-016 T-08：桌面 open_with 接收（宿主 write_state auto_open_path
        // → Tick 消费；interval 声明在 store，合并根 state 后被 Tick 契约读取）。
        // PLAN-007：装载消费随行——ConsumeOpen 建 tab（零全文）后，视图重建
        // 实化编辑器，下一轮 Tick 的 RunPendingLoad 分块装载（同 handler 内
        // 装载会因编辑器未实化而必败，顺序即协议）。
        .Tick -> {
            store.ConsumeOpen()
            store.RunPendingLoad()
            // PLAN-011 T-02: diff env 旁路自开（首拍消费一次；菜单/快捷键
            // =人工驱动面）。
            store.DiffBypassTick()
            // PLAN-012 T-03: 目录 diff env 旁路自开（AUTO_DIRDIFF_A/B——
            // 同款消费形）。
            store.DirBypassTick()
        }
        .TabActivate(i) -> { store.TabActivate(i) }
        .SrcChanged(i) -> { store.SrcChanged(i) }
        .CursorMoved(i) -> { store.CursorMoved(i) }
        .CloseTab(i) -> { store.CloseTab(i) }
        .ConfirmClose -> { store.ConfirmClose() }
        .ConfirmCancel -> { store.ConfirmCancel() }
        .EditorCtx(x, y) -> { store.EditorCtx(x, y) }
        // Plan 449 旧结论「code_editor_set_text 编译进 store handler 产出
        // 坏字节码」已在 1836 工具链证伪（PLAN-007 T-00 探针直调无 panic；
        // store 侧 RunPendingLoad 现役调用 edit/set_text/delta）。此处的
        // set_text 保留为 ActNew 清空编辑器的根侧原位（行为不变）。
        .ActNew -> {
            store.ActNew()
            if .store.tab_count > 0 {
                code_editor_set_text(.store.active_key, "")
            }
        }
        .ActOpen -> { store.ActOpen() }
        .ActSave -> { store.ActSave() }
        .ActQuit -> { store.ActQuit() }
        .ActUndo -> { store.ActUndo() }
        .ActRedo -> { store.ActRedo() }
        .ActSelectAll -> { store.ActSelectAll() }
        // PLAN-008 T-03: 行尾转换三命令（薄委托进 store 转换链）。
        .ActEolCrlf -> { store.EolConvertRequest("crlf") }
        .ActEolLf -> { store.EolConvertRequest("lf") }
        .ActEolCr -> { store.EolConvertRequest("cr") }
        .EolConfirmGo -> { store.EolConfirmGo() }
        .EolConfirmCancel -> { store.EolConfirmCancel() }
        // PLAN-009 T-02: 查找链薄委托（FindInput/FindReplaceInput=
        // T-00④ handler 首参形直传）。
        .ActFind -> { store.FindOpen() }
        .ActReplace -> { store.FindReplaceOpen() }
        .FindInput(q) -> { store.FindInput(q) }
        .FindReplaceInput(r) -> { store.FindReplaceInput(r) }
        .FindToggleCase -> { store.FindToggleCase() }
        .FindToggleWord -> { store.FindToggleWord() }
        .FindToggleRegex -> { store.FindToggleRegex() }
        .FindNext -> { store.FindNext() }
        .FindClose -> { store.FindClose() }
        .FifOpen -> { store.FifOpen() }
        .FifClose -> { store.FifClose() }
        .FifSearch -> { store.FifSearch() }
        .FifResultClick(i) -> { store.FifResultClick(i) }
        .ReplaceAllRequest -> { store.ReplaceAllRequest() }
