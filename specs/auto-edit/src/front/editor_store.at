    msg {
        TabActivate(int), SrcChanged(int), CursorMoved(int),
        CloseTab(int), RemoveAt(int),
        ConfirmClose, ConfirmCancel, ConsoleClear, SyncCursor(str),
        EditorCtx(float, float), CtxClose, CtxCut, CtxCopy, CtxSelectAll,
