        // PLAN-010 T-01 装载协议增补:loaded=「装载完成」标量——文件 tab
        // 创建位 false(RunPendingLoad 成功分支置 true),TabActivate 据此
        // 触发懒装载(恢复链「建而不装、激活才装」的唯一协议缺口);
        // cline/ccol=激活 tab 光标位镜像(CursorMoved/SyncCursor 位更新,
        // 持久化入会话但恢复时不应用——上游 set-cursor 端点清偿后启用的
        // 前向兼容位,docs/upstream §13)。种子 tab loaded=true(演示 tab
        // 即装即用,src 绑定承载正文)。
        var tabs list = [
            {key: "tab-main", title: "main.at", path: "", dirty: false, bom: false, eol: "lf", readonly: false, loaded: true, cline: 1, ccol: 1, big: false, ro_reason: "", src: "// 预填文本显示测试 — 如果你看到这行字,说明正文渲染正常\nfn add(a int, b int) int {\n    return a + b\n}\n\n// 中文注释:你好世界\nprint(add(1, 2))\n"},
            {key: "tab-util", title: "util.at", path: "", dirty: false, bom: false, eol: "lf", readonly: false, loaded: true, cline: 1, ccol: 1, big: false, ro_reason: "", src: "// 工具模块 — 每个 tab 的编辑状态独立保存\nfn greet(name str) str {\n    return \"hello \" + name\n}\n\nfn farewell(name str) str {\n    return \"bye \" + name\n}\n"},
        ]
