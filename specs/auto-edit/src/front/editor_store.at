// editor_store.at — auto-edit 的全部状态与业务逻辑（Plan 449 自 app.at 下沉）。
//
// 038-minesweeper / 013-todo 的 store-in-vm 先例：store 字段经 lib.rs 合并进
// 根 state（无前缀），auto-edit.at 的 enabled-if/checked-if 表达式（.tab_count
// 等）按原样继续求值；App 侧 on 薄委托 store.Xxx()，事件名与 auto-edit.at 的
// handler 映射一一对应（Action=声明层，Event=执行层）。
//
// 派生标量（tab/tab_count/line/col/sel 等）仍由各 handler 就地重算——
// VM view 不能调函数（Plan 402 约束），模板只读字段。
// 重复逻辑收口（store handler 间经 store.Xxx() 互调，038/013 先例）：
//   RemoveAt   —— 关闭 tab 的 remove + 索引修补 + 激活态重算
//                 （原 CloseTab/ConfirmClose 各持一份，现合一）
//   SyncCursor —— line/col/sel 三元组读回（原 5 处重复，现 1 处）
//   OpenPath   —— 打开文件 tab 公共核（PLAN-007：零全文 tab + 装载递延）
//   RunPendingLoad —— 分块装载消费（PLAN-007：Tick 侧，协议见 handler 注）
use bps.navigation.filetree.tree_util: toggle_id

// PLAN-003 T-02: 数据面改道 back.api(013/015 裸函数直调形态)——vm merged
// = 进程内 CALL;vm split / vue = HTTP。fs.*/File.* 内建自此退出 front
// (vue 轨 ts_adapter 将其拦为 __vmOnly 抛错桩,拆 back 动机);fs.join 亦
// 在拦截面(T-00 P-5),TreeSelect 改本地字符串拼接。
use back.api: ws_root, tree, write_text, exists, env_str, read_text_range

store EditorStore {
    model {
        // Plan 420 P1: tabs 数组态 —— 每 tab = {key, title, path, dirty, src}。
        // key 唯一(code_editor registry 按它保存实例)。
        // PLAN-007 去文本化:文件 tab 的 src 恒空串(零全文驻留)——正文经
        // 分块装载链直达编辑器 rope(RunPendingLoad),全文永不进 VM 堆;
        // src 种子位仅 untitled/演示 tab 用(T-00 裁定,AC-01 除外位)。
        // PLAN-005 起编辑态不回写;全文只在两个 save 位读出(过渡形态,
        // 上游 code_editor_save 直写端点供料后收口,docs/upstream 登记)。
        var tabs list = [
            {key: "tab-main", title: "main.at", path: "", dirty: false, src: "// 预填文本显示测试 — 如果你看到这行字,说明正文渲染正常\nfn add(a int, b int) int {\n    return a + b\n}\n\n// 中文注释:你好世界\nprint(add(1, 2))\n"},
            {key: "tab-util", title: "util.at", path: "", dirty: false, src: "// 工具模块 — 每个 tab 的编辑状态独立保存\nfn greet(name str) str {\n    return \"hello \" + name\n}\n\nfn farewell(name str) str {\n    return \"bye \" + name\n}\n"},
        ]
        var active_key str = "tab-main"
        // 派生标量(索引镜像/空态判断/状态栏与矩阵断言面;结构变化时由
        // 各 handler 就地重算,不在模板里调方法)。
        var tab int = 0
        var tab_count int = 2
        var open_count int = 2
        var title_active str = "main.at"
        var path_active str = ""
        // PLAN-007: 装载链状态——load_key 非空 = 有文件 tab 待分块装载
        // (Tick 侧 RunPendingLoad 消费;编辑器 widget 实化后才能装载,
        // 见该 handler 头注)。loaded_bytes = 最近一次装载的字节数
        // (envelope total;src_active 退役后的矩阵内容到达观测面)。
        var load_key str = ""
        var loaded_bytes int = 0
        var edits int = 0
        var line int = 1
        var col int = 1
        var sel int = 0
        var console_open bool = false
        var console str = ""
        // PLAN-016 T-08：桌面 open_with 接收臂——宿主执行臂 write_state
        // 写入路径；Tick 消费一次（open_consumed 防重放）。interval 挂
        // store（合并根 state 后为 .interval，Tick 契约读取面）。
        var interval int = 800
        var auto_open_path str = ""
        var open_consumed str = "__none__"
        // Plan 428: 折叠状态读数(隐藏行数;矩阵经 autoui_state 校验)
        var fold_hidden int = 0
        // Plan 422 P3: 右键菜单(contextmenu popover 的坐标锚状态)
        var ctx_open bool = false
        var ctx_x float = 0
        var ctx_y float = 0
        // Plan 420 P2: 关闭脏 tab 的确认弹层状态
        var confirm_open bool = false
        var confirm_idx int = -1
        // Plan 626 T-06: 退出/关窗确认弹层(窗口 X 与「退出」共用入口)。
        var quit_confirm_open bool = false
        // PLAN-618 T-06: 左侧文件浏览器树(TreeView 受控——页面持
        // expanded/selected)。文件节点 id = 相对 workspace 根的路径
        // ('/'分隔),目录节点 id 不与任何文件路径重合,TreeSelect 按
        // ws_dir+"/"+id 全路径匹配/读盘(PLAN-003 起走 back api)。初始表
        // 仅 Init 前占位,.Init 经 back tree + json.to_value 装载真实目录
        // (Plan 626 T-05)。
        var tree_nodes list = [
            { id: "src", label: "src", children: [
                { id: "src/app.at", label: "app.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/editor_store.at", label: "editor_store.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/status_bar.at", label: "status_bar.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/console_panel.at", label: "console_panel.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/ctx_menu.at", label: "ctx_menu.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" }
            ], kind: "dir", icon: "folder", is_leaf: false, badge: "" },
            { id: "docs", label: "docs", children: [
                { id: "README.md", label: "README.md", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" }
            ], kind: "dir", icon: "folder", is_leaf: false, badge: "" }
        ]
        var tree_expanded list = ["src", "docs"]
        var tree_sel str = ""
        // Plan 626 T-05: workspace 根(AUTO_PROJECT_DIR 由 auto-man 注入,
        // automan.rs set_var)——Explorer 头部展示名,TreeSelect/保存按它拼全路径。
        var ws_dir str = ""
        var ws_name str = ""
    }

    msg {
        TabActivate(int), SrcChanged(int), CursorMoved(int),
        CloseTab(int), RemoveAt(int),
        ConfirmClose, ConfirmCancel, ConsoleClear, SyncCursor(str),
        EditorCtx(float, float), CtxClose, CtxCut, CtxCopy, CtxSelectAll,
        ActNew, ActOpen, ActSave, ActQuit, ActUndo, ActRedo,
        ActSelectAll, ActCut, ActCopy, ActPaste, ActConsole,
        ActSwitchTab, ActFold, ActAbout,
        TreeToggle(str), TreeSelect(str),
        // PLAN-016 T-08：桌面 open_with 接收臂（host 写 auto_open_path，
        // Tick 消费一次）。
        ConsumeOpen,
        LoadWorkspace, CloseRequest, QuitDiscard, QuitSaveClose, QuitConfirmCancel,
        // PLAN-007: 分块装载消费臂（Tick 侧驱动）+ 打开 tab 公共核。
        RunPendingLoad, OpenPath(str),
    }

    on {
        // ---- Plan 626 T-05: 装载真实 workspace 目录树,Explorer 头部展示
        // 名。经 App.Init 薄委托(Init 名保留给根 widget 生命周期,store 侧
        // handler 不得占用——handler_EditorStore_Init 不合成,link 期炸)。
        .LoadWorkspace -> {
            // PLAN-005 T-04: bench 阶段标记（AUTO_BENCH=1 门控）。T-03 实勘
            // 结论：VM 轨 time 族内建未接线（now_ms/now_sec 两形态均返 0，
            // Instant.elapsed 返回约定坏）——标记为裸 stage 行，毫秒值由
            // host 侧对 stdout 落文件的时间戳记录；print 不进 console 面板，
            // 矩阵断言零扰动。未设门=分支不进，零行为差异。
            if env_str("AUTO_BENCH") == "1" {
                print("BENCH bench_vm_init")
            }
            // PLAN-003 T-02: ws 根解析入 back(ws_root 兜底 "." 语义不变)。
            .ws_dir = ws_root()
            .ws_name = file_basename(.ws_dir)
            .tree_nodes = json.to_value(tree(.ws_dir, 4))
            .tree_expanded = ["src"]
            console_log("workspace: " + .ws_dir)
            .console = console_lines()
            if env_str("AUTO_BENCH") == "1" {
                print("BENCH bench_ws_loaded")
            }
        }

        // ---- 内部 helper：光标三元组读回 ----
        .SyncCursor(key) -> {
            .line = code_editor_cursor_line(key) + 1
            .col = code_editor_cursor_col(key) + 1
            .sel = code_editor_selection_len(key)
        }

        .TabActivate(i) -> {
            .tab = i
            .active_key = .tabs[i].key
            .title_active = .tabs[i].title
            .path_active = .tabs[i].path
            store.SyncCursor(.tabs[i].key)
            .console = console_lines()
        }
        // Plan 428: 切换激活编辑器第 2 行 fn 块的折叠态并读回隐藏行数。
        .ActFold -> {
            code_editor_fold_toggle(.active_key, 2)
            .fold_hidden = code_editor_fold_hidden_count(.active_key)
            .console = console_lines()
        }
        .SrcChanged(i) -> {
            .edits = .edits + 1
            .tabs[i].dirty = true
            .console = console_lines()
        }
        .CursorMoved(i) -> {
            store.SyncCursor(.tabs[i].key)
            .console = console_lines()
        }

        // ---- 内部 helper：关闭 tab 的 remove + 索引修补 + 激活态重算 ----
        // （原 CloseTab/ConfirmClose 两份重复合一；脏 tab 判定在 CloseTab）
        .RemoveAt(i) -> {
            .tabs.remove(i)
            .tab_count = .tab_count - 1
            if .tab_count > 0 {
                if i == .tab {
                    if i >= .tab_count {
                        .tab = .tab_count - 1
                    }
                }
                if i < .tab {
                    .tab = .tab - 1
                }
                .active_key = .tabs[.tab].key
                .title_active = .tabs[.tab].title
                .path_active = .tabs[.tab].path
                store.SyncCursor(.active_key)
            } else {
                .tab = -1
                .active_key = ""
                .title_active = ""
                .path_active = ""
                .line = 1
                .col = 1
                .sel = 0
            }
        }
        .CloseTab(i) -> {
            if .tabs[i].dirty {
                .confirm_idx = i
                .confirm_open = true
            } else {
                store.RemoveAt(i)
                console_log("closed tab; open=" + .tab_count.str())
            }
            .console = console_lines()
        }
        .ConfirmClose -> {
            .confirm_open = false
            if .confirm_idx >= 0 {
                store.RemoveAt(.confirm_idx)
                console_log("closed dirty tab; open=" + .tab_count.str())
            }
            .confirm_idx = -1
            .console = console_lines()
        }
        .ConfirmCancel -> {
            .confirm_open = false
            .confirm_idx = -1
        }
        .ConsoleClear -> {
            console_clear()
            .console = ""
        }

        // ---- Plan 422 P3: contextmenu popover ----
        // 编辑器右键:坐标为视口系(renderer 侧已加 widget origin)。
        .EditorCtx(x, y) -> {
            .ctx_x = x
            .ctx_y = y
            .ctx_open = true
            console_log("ctx menu opened")
            .console = console_lines()
        }
        .CtxClose -> {
            .ctx_open = false
        }
        .CtxCut -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_cut(.active_key)
                .tabs[.tab].dirty = true
            }
            console_log("ctx cut")
            .console = console_lines()
        }
        .CtxCopy -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_copy(.active_key)
            }
            console_log("ctx copy")
            .console = console_lines()
        }
        .CtxSelectAll -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_select_all(.active_key)
                .sel = code_editor_selection_len(.active_key)
            }
            console_log("ctx select all")
            .console = console_lines()
        }

        // ---- Plan 418: semantic actions (menu / toolbar / shortcut 3-source) ----
        .ActNew -> {
            // Plan 449 旧结论「code_editor_set_text 编译进 store handler
            // 产出坏字节码」已在 1836 工具链证伪（PLAN-007 T-00 探针直调
            // 无 panic）——编辑器清空仍留 App 根 handler（行为原位，见
            // app.at on 块）。
            if .tab_count > 0 {
                .tabs[.tab].path = ""
                .tabs[.tab].title = "untitled.at"
                .tabs[.tab].dirty = false
                .tabs[.tab].src = ""
                .title_active = "untitled.at"
                .path_active = ""
            }
            console_log("new: cleared active tab")
            .console = console_lines()
        }
        // PLAN-016 T-08：open_with 接收消费——与 ActOpen 同构，路径来自
        // 宿主写入的 auto_open_path（防重放 + 清路径）。
        // PLAN-007: 读文本入 store 的旧链退役——tab 由 OpenPath 零全文
        // 创建，装载递延 RunPendingLoad（bench_open_* 标记随之迁至装载
        // 位包夹，open_ms 语义=纯装载时长）。
        .ConsumeOpen -> {
            // PLAN-005 T-04: bench 挂载——AUTO_BENCH=1 时 AUTO_OPEN_PATH 兼作
            // ConsumeOpen 供料（桌面宿主 open_with 臂之外的第二通道；host
            // 免 UI 触发即可测打开链。未设门=零行为差异，矩阵回归保证）。
            if env_str("AUTO_BENCH") == "1" {
                if .auto_open_path == "" {
                    .auto_open_path = env_str("AUTO_OPEN_PATH")
                }
            }
            if .auto_open_path != "" {
                if .auto_open_path != .open_consumed {
                    .open_consumed = .auto_open_path
                    let p str = .auto_open_path
                    store.OpenPath(p)
                    .auto_open_path = ""
                }
            }
        }

        // PLAN-007 T-01: 打开文件 tab 的公共核（ConsumeOpen/ActOpen/
        // TreeSelect 三点合一，RemoveAt/SyncCursor 收口先例同款）——
        // 文件 tab 零全文（src 恒空串），装载递延 RunPendingLoad：编辑
        // 器 widget 实化（视图重建）先于装载，分块链直达 rope，全文
        // 永不进 VM 堆。
        .OpenPath(p) -> {
            .open_count = .open_count + 1
            .tabs.push({key: "tab-" + .open_count.str(), title: file_basename(p), path: p, dirty: false, src: ""})
            .tab = .tab_count
            .tab_count = .tab_count + 1
            .active_key = .tabs[.tab].key
            .title_active = .tabs[.tab].title
            .path_active = p
            .line = 1
            .col = 1
            .sel = 0
            .load_key = .tabs[.tab].key
        }

        // PLAN-007 T-01: 装载（Tick 消费 load_key）。上游 PLAN-687 供料
        // code_editor_load_file(key, path)——native 端到端装载：std::fs
        // 单趟读（借 Rust 实现，用户 2026-09-22 方针）+ core.set_text
        // 单次重写 + 装载 delta drain-弃。全文零 VM 过载（envelope 过
        // 池/池滞留/O(n) 多趟重写三根因同除——T-03 三形状实测 729-1356MB
        // 反例后由本端点收敛）。协议①②维持：存在性探针 edit(key,0,0,
        // "")（编辑器实化前静默递延）+ 装载前 set_text(key,"") try/catch
        // 对齐 last_external（load 不触 guard——core 级 set_text 不改
        // last_external，装载后 stale 推送须 no-op 防清场）。
        .RunPendingLoad -> {
            if .load_key != "" {
                if code_editor_edit(.load_key, 0, 0, "") {
                    let key str = .load_key
                    let path str = .path_active
                    try {
                        code_editor_set_text(key, "")
                    } catch {
                        // guard no-op——last_external 已对齐，达标
                    }
                    if env_str("AUTO_BENCH") == "1" {
                        print("BENCH bench_open_start")
                    }
                    let total int = code_editor_load_file(key, path)
                    if total >= 0 {
                        .loaded_bytes = total
                    } else {
                        .loaded_bytes = 0
                    }
                    .load_key = ""
                    console_log("loaded: " + path + " " + total.str() + " bytes")
                    if env_str("AUTO_BENCH") == "1" {
                        print("BENCH bench_open_done")
                    }
                }
                .console = console_lines()
            }
        }

        .ActOpen -> {
            // Plan 420 P2: AUTO_OPEN_PATH 环境变量旁路(测试构建语义,prod
            // 忽略)—— 阻塞式 rfd 对话框无法被 MCP 驱动的盲区由此打通。
            // PLAN-003 T-02: env 读入 back(env_str),front 零 Env.get。
            var p str = env_str("AUTO_OPEN_PATH")
            if p == "" {
                p = dialog_open(".at, .au, .rs, .txt")
            }
            if p != "" {
                store.OpenPath(p)
                console_log("open: " + p)
            } else {
                console_log("open: cancelled")
            }
            .console = console_lines()
        }
        .ActSave -> {
            if .tab_count > 0 {
                if .path_active == "" {
                    // Plan 420 P2: AUTO_SAVE_PATH 旁路(与 AUTO_OPEN_PATH 同型)。
                    var p str = env_str("AUTO_SAVE_PATH")
                    if p == "" {
                        p = dialog_save("untitled.at")
                    }
                    if p != "" {
                        .path_active = p
                        .tabs[.tab].path = p
                        .title_active = file_basename(p)
                        .tabs[.tab].title = file_basename(p)
                    }
                }
                if .path_active != "" {
                    write_text(.path_active, code_editor_text(.active_key))
                    .tabs[.tab].dirty = false
                    console_log("saved: " + .path_active)
                } else {
                    console_log("save: cancelled")
                }
            }
            .console = console_lines()
        }
                .ActUndo -> {
            if .tab_count > 0 {
                code_editor_undo(.active_key)
            }
            console_log("undo")
            .console = console_lines()
        }
        .ActRedo -> {
            if .tab_count > 0 {
                code_editor_redo(.active_key)
            }
            console_log("redo")
            .console = console_lines()
        }
        .ActSelectAll -> {
            if .tab_count > 0 {
                code_editor_select_all(.active_key)
                store.SyncCursor(.active_key)
            }
            console_log("select all")
            .console = console_lines()
        }
        .ActCut -> {
            if .tab_count > 0 {
                code_editor_cut(.active_key)
                .tabs[.tab].dirty = true
            }
            console_log("cut")
            .console = console_lines()
        }
        .ActCopy -> {
            if .tab_count > 0 {
                code_editor_copy(.active_key)
            }
            console_log("copy")
            .console = console_lines()
        }
        .ActPaste -> {
            if .tab_count > 0 {
                code_editor_paste(.active_key)
                .tabs[.tab].dirty = true
            }
            console_log("paste")
            .console = console_lines()
        }
        .ActConsole -> {
            .console_open = !.console_open
            .console = console_lines()
        }
        .ActSwitchTab -> {
            if .tab_count > 1 {
                // 两 tab 演示语义保留(Ctrl+D 矩阵断言 0↔1 翻转)。
                .tab = 1 - .tab
                .active_key = .tabs[.tab].key
                .title_active = .tabs[.tab].title
                .path_active = .tabs[.tab].path
                store.SyncCursor(.active_key)
            }
            .console = console_lines()
        }
        .ActAbout -> {
            console_log("auto-edit 0.1 — AutoUI playground (plans 413/414/418/420)")
            .console = console_lines()
        }

        // ---- PLAN-618 T-06: 文件浏览器树 ----
        .TreeToggle(id) -> {
            .tree_expanded = toggle_id(.tree_expanded, id)
        }
        // 选中文件 → OpenByPath 语义:同路径 tab 已开则激活,否则读盘构造
        // 新 tab(Plan 626 T-05:静态演示表退役,path 存全路径,保存/再次匹配
        // 都走全路径;目录节点 exists 不命中,静默忽略)。PLAN-003 T-02:
        // 拼径改本地字符串拼接(fs.join 亦在 vue 拦截面,T-00 P-5——ws_dir
        // 尾分隔符经 "+/+" 形式归一,Win32 路径规范化容忍双斜杠),读盘/
        // 判存走 back api。
        .TreeSelect(id) -> {
            .tree_sel = id
            var full str = .ws_dir + "/" + id
            var i int = 0
            var found bool = false
            while i < .tabs.len() {
                if .tabs[i].path == full {
                    found = true
                    store.TabActivate(i)
                }
                i = i + 1
            }
            if !found {
                if exists(full) {
                    store.OpenPath(full)
                    console_log("open: " + full)
                }
                .console = console_lines()
            }
        }

        // ---- Plan 626 T-06: 退出/关窗确认(有脏 tab 先弹 alert-dialog)----
        // CloseRequest = 窗口 X(渲染器拦截分派)与菜单「退出」共用入口;
        // 无路径脏 tab(untitled)无从自动保存——落盘有路径的,其余放弃。
        .CloseRequest -> {
            var any bool = false
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].dirty {
                    any = true
                }
                i = i + 1
            }
            if any {
                .quit_confirm_open = true
            } else {
                console_log("quit")
                Process.exit(0)
            }
            .console = console_lines()
        }
        .ActQuit -> { store.CloseRequest() }
        .QuitConfirmCancel -> {
            .quit_confirm_open = false
        }
        .QuitSaveClose -> {
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].dirty {
                    if .tabs[i].path != "" {
                        write_text(.tabs[i].path, code_editor_text(.tabs[i].key))
                        .tabs[i].dirty = false
                    }
                }
                i = i + 1
            }
            console_log("quit: saved & exit")
            Process.exit(0)
        }
        .QuitDiscard -> {
            console_log("quit: discard & exit")
            Process.exit(0)
        }
    }
}
