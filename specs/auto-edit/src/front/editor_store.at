        ConsumeOpen,
        LoadWorkspace, CloseRequest, QuitDiscard, QuitSaveClose, QuitConfirmCancel,
        // PLAN-007: 分块装载消费臂（Tick 侧驱动）+ 打开 tab 公共核。
        RunPendingLoad, OpenPath(str),
        // PLAN-008 T-01: 装载后字节元数据探测（BOM/EOL/采样窗协议）。
        ProbeByteMeta(str, str),
        // PLAN-008 T-02: save 位字节保真回写收口（ActSave/QuitSaveClose
        // 共用；编辑器全文唯一读出位——检测器白名单登记件）。
        WriteFidelity(int),
        // PLAN-008 T-03: 状态栏派生标量重算 + 行尾转换命令链
        // （Request=mixed 确认门；EolConvert=转换本体，检测器白名单件）。
        SyncByteMeta, EolConvertRequest(str), EolConvert(str),
        EolConfirmGo, EolConfirmCancel,
        // PLAN-009 T-01: 查找链。FindInput/FindReplaceInput = 两输入行
        // （T-00④ 定案：键入文本=handler 首参，handler 显式赋值）；三
        // Toggle=开关（重算 find_effective）；SyncFindEffective=拼装收口
        // 内部 helper；FindOpen/FindReplaceOpen=栏开启（Ctrl+F/Ctrl+H 与
        // 菜单共用；计划 msg 清单的必要扩——开合需显式入口）；FindNext=
        // 下一处；FindClose=关栏清搜索态。
        FindInput(str), FindReplaceInput(str),
        FindToggleCase, FindToggleWord, FindToggleRegex,
        SyncFindEffective, FindOpen, FindReplaceOpen, FindNext, FindClose,
        // PLAN-009 T-03: 全部替换（检测器白名单第三件显式全文操作）。
        ReplaceAllRequest,
        // PLAN-009 T-04: find-in-files 面板开合 + 搜索（back search_files）。
        FifOpen, FifClose, FifSearch, FifResultClick(int),
        // PLAN-010 T-01: 会话落盘收口 helper（内部——五挂点 OpenPath/
        // RemoveAt/TabActivate/ActNew/CloseRequest 入口调用；结构变更
        // 即时落盘=崩溃恢复底座）。
        SessionSave,
        // PLAN-010 T-03: 最近文件点击（Explorer 侧栏条目——设计适配：
        // menubar-content 动态子节点边界见 app.at 节注；根视图裸索引
        // 载荷=已证面）。共享内部收口。
        RecentOpen(int),
        RecentOpenAt(int),
        // PLAN-011 T-02: diff 链。DiffOpen=入口（env 旁路优先→dialog×2
        // 手动路径）；DiffCompute=back diff_files 消费收口（err 形不
        // 静默）；DiffClose=关闭清态（tab 集零扰动）；DiffNext/DiffPrev=
        // hunk 导航（T-04 接 scroll_to 跳转）。
        DiffOpen, DiffCompute, DiffClose, DiffNext, DiffPrev,
        // PLAN-011 T-04: 导航内部收口（当前 hunk 首渲染行定位+scroll_to）。
        DiffScrollToHunk,
        // PLAN-011 T-02: env 旁路 Tick 消费臂（AUTO_DIFF_A 在档时首拍
        // 自开——矩阵驱动面确定性保障；menubar 展开项不进 vtree 实勘
        // 2044 复认+键盘路径 AltGr 疑虑，双双不可作矩阵依赖）。
        DiffBypassTick,
        // PLAN-012 T-03: 目录 diff 链。DirDiffOpen=入口（env 旁路优先→
        // 手动开输入面板——folder picker 无[T-00④]，v1 路径输入框）；
        // DirAInput/DirBInput=输入行（handler 首参形）；DirDiffCompute=
        // back diff_dirs 消费收口（err 形不静默）；五 DirFilter*=过滤
        // 切换（front 纯态零重比——AC-03）；DirApplyFilter=投影重建
        // 内部收口；DirDiffClose=全清；DirDiffRefresh=动作后重比（过滤
        // 态保持）；DirBypassTick=env 旁路 Tick 消费臂（AUTO_DIRDIFF_A）。
        DirDiffOpen, DirAInput(str), DirBInput(str), DirDiffCompute,
        DirFilterAll, DirFilterAdded, DirFilterDeleted, DirFilterModified,
        DirFilterBinary, DirApplyFilter, DirDiffClose, DirDiffRefresh,
        DirBypassTick,
        // PLAN-012 T-04: 下钻+同步动作。DirRowClick=条目主点击（改→
        // DiffDrillIn 下钻复用 011 视图；其余→OpenPath fif 先例）；
        // DirCopyRight/DirCopyLeft=单向复制（A→B/B→A——目标存在恒确认
        // [Q-2 静默覆盖]，单侧=恢复语义直执行）；DirDeleteA/DirDeleteB=
        // 单侧删除（恒确认；仅单侧条目渲染——双侧删除不提供）；确认链
        // DirConfirmGo/DirConfirmCancel；DirBackToDirs=下钻返回目录态。
        DirRowClick(int), DirCopyRight(int), DirCopyLeft(int),
        DirDeleteA(int), DirDeleteB(int), DirConfirmGo, DirConfirmCancel,
        DirBackToDirs,
    }

    on {
        // ---- Plan 626 T-05: 装载真实 workspace 目录树,Explorer 头部展示
        // 名。经 App.Init 薄委托(Init 名保留给根 widget 生命周期,store 侧
        // handler 不得占用——handler_EditorStore_Init 不合成,link 期炸)。
        .LoadWorkspace -> {
            // PLAN-005 T-04: bench 阶段标记（AUTO_BENCH=1 门控）。T-03 实勘
            // 结论：VM 轨 time 族内建未接线（now_ms/now_sec 两形态均返 0，
            // Instant.elapsed 返回约定坏）——标记为裸 stage 行，毫秒值由
            // host 侧对 stdout 落文件的时间戳记录；print 不进 console 面板，
            // 矩阵断言零扰动。未设门=分支不进，零行为差异。
            if env_str("AUTO_BENCH") == "1" {
                print("BENCH bench_vm_init")
                // PLAN-014 T-07: 标记携 app 侧 epoch 毫秒（供④ time 族——
                // 裸 print 直出 i64 实证形；.at 层 i64 拼接/算术=平台缺口
                // 不用）。host 时间戳降对照列（bench.py 一跑双录）。
                print(time.now_ms())
            }
            // PLAN-010 T-01: 会话链定位（头段）——APPDATA 根
            // auto-edit-session.json；缺席兜底 ""=会话链禁用（写入挂点与
            // 恢复链双重门，非常态环境零行为差异）。
            var ad str = env_str("APPDATA")
            if ad != "" {
                .session_path = ad + "/auto-edit-session.json"
            }
            // PLAN-003 T-02: ws 根解析入 back(ws_root 兜底 "." 语义不变)。
            .ws_dir = ws_root()
            .ws_name = file_basename(.ws_dir)
            .tree_nodes = json.to_value(tree(.ws_dir, 4))
            .tree_expanded = ["src"]
            console_log("workspace: " + .ws_dir)
            .console = console_lines()
            if env_str("AUTO_BENCH") == "1" {
                print("BENCH bench_ws_loaded")
                print(time.now_ms())
            }
            // PLAN-010 T-02: 会话恢复链（尾段——bench 计时标记之后，热启动
            // 预算行效力在 L2 模式、本件按门禁两档记账不阻塞）。三门：存在
            // → 解析 → ws_dir 匹配；任一不过=静默全新启动（现状零回归，
            // bench 实例 ws 键控自隔离同门）。重建=零全文 tab（src 恒空、
            // loaded=false——仅 active 装载：load_key=active，下轮 Tick
            // RunPendingLoad 消费=既有协议②③原样）；open_count 推进防撞
            // 号；recents 同源恢复。损坏 JSON 按 T-00⑤ 定案（try 门=静默
            // 全新启动）。脏内容/光标/滚动不恢复（§0 边界——cline/ccol 仅
            // 前向兼容位）。
            if .session_path != "" {
                if exists(.session_path) {
                    try {
                        let v = json.to_value(read_text(.session_path))
                        var sws str = v.ws_dir ?? ""
                        if sws == .ws_dir {
                            var stabs = v.tabs ?? []
                            .tabs = []
                            var seq int = 0
                            var act int = v.active ?? -1
                            var want int = 0
                            for t in stabs {
                                var p str = t.path ?? ""
                                if p != "" {
                                    if exists(p) {
                                        var knum int = seq + 1
                                        .tabs.push({key: "tab-" + knum.str(), title: t.title ?? file_basename(p), path: p, dirty: false, bom: false, eol: "lf", readonly: false, loaded: false, cline: t.cline ?? 1, ccol: t.ccol ?? 1, big: false, ro_reason: "", src: ""})
                                        if act == seq {
                                            want = seq
                                        }
                                        seq = seq + 1
                                    }
                                }
                            }
                            // open_count 推进防撞号（重建 key=tab-1..seq，
                            // 下次 OpenPath 自 seq+1 续号）。
                            .open_count = seq
                            .tab_count = seq
                            if seq > 0 {
                                if want >= seq {
                                    want = 0
                                }
                                .tab = want
                                .active_key = .tabs[want].key
                                .title_active = .tabs[want].title
                                .path_active = .tabs[want].path
                                .line = 1
                                .col = 1
                                .sel = 0
                                // 仅 active 装载（文件 tab 恒 loaded=false，
                                // 视图实化后下轮 Tick 装载）。
                                .load_key = .tabs[want].key
                                store.SyncByteMeta()
                            } else {
                                .tab = -1
                                .active_key = ""
                                .title_active = ""
                                .path_active = ""
                            }
                            // recents 同源恢复（元素级防御重建——畸形条目
                            // 丢弃，不携进入后续 SessionSave）。
                            var srecs = v.recents ?? []
                            .recents = []
                            for r in srecs {
                                var rp str = r.path ?? ""
                                if rp != "" {
                                    .recents.push({path: rp, title: r.title ?? file_basename(rp)})
                                }
                            }
                            .recents_count = .recents.len()
                            console_log("session: restored " + seq.str() + " tabs")
                        }
                    } catch {
                        console_log("session: parse failed — fresh start")
                    }
                }
            }
        }

        // ---- 内部 helper：光标三元组读回 ----
        // PLAN-010 T-01: cline/ccol 写入 active tab（调用面恒对 active——
        // TabActivate/RemoveAt/CursorMoved/ActSelectAll/FindNext 全部以
        // active key 调用；持久化入会话、恢复时不应用=前向兼容位）。
        .SyncCursor(key) -> {
            .line = code_editor_cursor_line(key) + 1
            .col = code_editor_cursor_col(key) + 1
            .sel = code_editor_selection_len(key)
            if .tab >= 0 {
                if .tab < .tab_count {
                    .tabs[.tab].cline = .line
                    .tabs[.tab].ccol = .col
                }
            }
        }

        // ---- PLAN-008 T-03 内部 helper：状态栏字节保真三元组重算 ----
        // （激活 tab 的 bom/eol/readonly → 显示派生标量；结构/激活/元数据
        // 变更位调用，模板只读惯例。）
        .SyncByteMeta -> {
            if .tab_count > 0 {
                .bom_active = .tabs[.tab].bom
                .readonly_active = .tabs[.tab].readonly
                .big_active = .tabs[.tab].big
                // PLAN-013 T-02: lang 绑定值（plain=旁路 syntect+零
                // warm_language 语法面；hint 清零=提示与激活 tab 绑定）。
                var la str = "auto"
                if .tabs[.tab].big {
                    la = "plain"
                }
                .lang_active = la
                .big_hint = ""
                // PLAN-013 T-01: 只读原因标签（编码错误/超大拒绝两形态
                // 分立——ro_reason 空=既有编码兜底形缺省，向后兼容）。
                var rl str = ""
                if .readonly_active {
                    rl = "只读(编码错误)"
                    if .tabs[.tab].ro_reason == "big" {
                        rl = "只读(超大拒绝)"
                    }
                }
                .readonly_label = rl
                var e str = .tabs[.tab].eol
                var lbl str = "LF"
                if e == "crlf" {
                    lbl = "CRLF"
                } else {
                    if e == "cr" {
                        lbl = "CR"
                    } else {
                        if e == "mixed" {
                            lbl = "MIXED"
                        }
                    }
                }
                .eol_label = lbl
            } else {
                .bom_active = false
                .readonly_active = false
                .big_active = false
                .readonly_label = ""
                .eol_label = "LF"
            }
        }

        .TabActivate(i) -> {
            .tab = i
            .active_key = .tabs[i].key
            .title_active = .tabs[i].title
            .path_active = .tabs[i].path
            // PLAN-010 T-02: 懒装载触发——激活未装载的文件 tab → 置
            // load_key（path_active 已由上行写，RunPendingLoad 读
            // .path_active 的假设天然满足；编辑器实化前探针 edit 失败
            // 静默递延=协议①原样）。已装载 tab 零动作（Q-1 语义按
            // T-00③ 定案——registry 存留则切回免重装）。
            if .tabs[i].loaded == false {
                if .tabs[i].path != "" {
                    .load_key = .tabs[i].key
                }
            }
            store.SyncCursor(.tabs[i].key)
            store.SyncByteMeta()
            // PLAN-010 T-01: 会话挂点（激活位变更=结构变更）。
            store.SessionSave()
            .console = console_lines()
        }
        // Plan 428: 切换激活编辑器第 2 行 fn 块的折叠态并读回隐藏行数。
        .ActFold -> {
            code_editor_fold_toggle(.active_key, 2)
            .fold_hidden = code_editor_fold_hidden_count(.active_key)
            .console = console_lines()
        }
        .SrcChanged(i) -> {
            .edits = .edits + 1
            .tabs[i].dirty = true
            .console = console_lines()
        }
        .CursorMoved(i) -> {
            store.SyncCursor(.tabs[i].key)
            .console = console_lines()
        }

        // ---- 内部 helper：关闭 tab 的 remove + 索引修补 + 激活态重算 ----
        // （原 CloseTab/ConfirmClose 两份重复合一；脏 tab 判定在 CloseTab）
        .RemoveAt(i) -> {
            .tabs.remove(i)
            .tab_count = .tab_count - 1
            if .tab_count > 0 {
                if i == .tab {
                    if i >= .tab_count {
                        .tab = .tab_count - 1
                    }
                }
                if i < .tab {
                    .tab = .tab - 1
                }
                .active_key = .tabs[.tab].key
                .title_active = .tabs[.tab].title
                .path_active = .tabs[.tab].path
                store.SyncCursor(.active_key)
                store.SyncByteMeta()
            } else {
                .tab = -1
                .active_key = ""
                .title_active = ""
                .path_active = ""
                .line = 1
                .col = 1
                .sel = 0
                store.SyncByteMeta()
            }
            // PLAN-010 T-01: 会话挂点（关闭=结构变更；末 tab 关闭后
            // tabs 空=空会话，文件照写——恢复门按空集重建零 tab）。
            store.SessionSave()
        }
        .CloseTab(i) -> {
            if .tabs[i].dirty {
                .confirm_idx = i
                .confirm_open = true
            } else {
                store.RemoveAt(i)
                console_log("closed tab; open=" + .tab_count.str())
            }
            .console = console_lines()
        }
        .ConfirmClose -> {
            .confirm_open = false
            if .confirm_idx >= 0 {
                store.RemoveAt(.confirm_idx)
                console_log("closed dirty tab; open=" + .tab_count.str())
            }
            .confirm_idx = -1
            .console = console_lines()
        }
        .ConfirmCancel -> {
            .confirm_open = false
            .confirm_idx = -1
        }
        .ConsoleClear -> {
            console_clear()
            .console = ""
        }

        // ---- Plan 422 P3: contextmenu popover ----
        // 编辑器右键:坐标为视口系(renderer 侧已加 widget origin)。
        .EditorCtx(x, y) -> {
            .ctx_x = x
            .ctx_y = y
            .ctx_open = true
            console_log("ctx menu opened")
            .console = console_lines()
        }
        .CtxClose -> {
            .ctx_open = false
        }
        .CtxCut -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_cut(.active_key)
                .tabs[.tab].dirty = true
            }
            console_log("ctx cut")
            .console = console_lines()
        }
        .CtxCopy -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_copy(.active_key)
            }
            console_log("ctx copy")
            .console = console_lines()
        }
        .CtxSelectAll -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_select_all(.active_key)
                .sel = code_editor_selection_len(.active_key)
            }
            console_log("ctx select all")
            .console = console_lines()
        }

        // ---- Plan 418: semantic actions (menu / toolbar / shortcut 3-source) ----
        .ActNew -> {
            // Plan 449 旧结论「code_editor_set_text 编译进 store handler
            // 产出坏字节码」已在 1836 工具链证伪（PLAN-007 T-00 探针直调
            // 无 panic）——编辑器清空仍留 App 根 handler（行为原位，见
            // app.at on 块）。
            if .tab_count > 0 {
                .tabs[.tab].path = ""
                .tabs[.tab].title = "untitled.at"
                .tabs[.tab].dirty = false
                .tabs[.tab].src = ""
                .tabs[.tab].bom = false
                .tabs[.tab].eol = "lf"
                .tabs[.tab].readonly = false
                .tabs[.tab].big = false
                .tabs[.tab].ro_reason = ""
                .title_active = "untitled.at"
                .path_active = ""
                store.SyncByteMeta()
            }
            console_log("new: cleared active tab")
            // PLAN-010 T-01: 会话挂点（新建=untitled 化=结构变更——untitled
            // tab 不入会话，SessionSave 按排除语义落盘）。
            store.SessionSave()
            .console = console_lines()
        }
        // PLAN-016 T-08：open_with 接收消费——与 ActOpen 同构，路径来自
        // 宿主写入的 auto_open_path（防重放 + 清路径）。
        // PLAN-007: 读文本入 store 的旧链退役——tab 由 OpenPath 零全文
        // 创建，装载递延 RunPendingLoad（bench_open_* 标记随之迁至装载
        // 位包夹，open_ms 语义=纯装载时长）。
        .ConsumeOpen -> {
            // PLAN-005 T-04: bench 挂载——AUTO_BENCH=1 时 AUTO_OPEN_PATH 兼作
            // ConsumeOpen 供料（桌面宿主 open_with 臂之外的第二通道；host
            // 免 UI 触发即可测打开链。未设门=零行为差异，矩阵回归保证）。
            if env_str("AUTO_BENCH") == "1" {
                if .auto_open_path == "" {
                    .auto_open_path = env_str("AUTO_OPEN_PATH")
                }
            }
            if .auto_open_path != "" {
                if .auto_open_path != .open_consumed {
                    .open_consumed = .auto_open_path
                    let p str = .auto_open_path
                    store.OpenPath(p)
                    .auto_open_path = ""
                }
            }
        }

        // PLAN-007 T-01: 打开文件 tab 的公共核（ConsumeOpen/ActOpen/
        // TreeSelect 三点合一，RemoveAt/SyncCursor 收口先例同款）——
        // 文件 tab 零全文（src 恒空串），装载递延 RunPendingLoad：编辑
        // 器 widget 实化（视图重建）先于装载，分块链直达 rope，全文
        // 永不进 VM 堆。
        .OpenPath(p) -> {
            // PLAN-010 T-03: recents 维护（前段——去重前移，上限 10 淘尾；
            // OpenPath 是全部打开入口的公共核，菜单/树/fif 点击/最近文件
            // 四路同源）。会话恢复链的 recents 重建亦经此语义。
            var ridx int = -1
            var ri int = 0
            while ri < .recents.len() {
                if .recents[ri].path == p {
                    ridx = ri
                }
                ri = ri + 1
            }
            if ridx >= 0 {
                .recents.remove(ridx)
            }
            .recents.push({path: p, title: file_basename(p)})
            while .recents.len() > 10 {
                .recents.remove(0)
            }
            .recents_count = .recents.len()
            .open_count = .open_count + 1
            // PLAN-014 T-02: 任务栏跳转列表消费（供⑥ shell_add_recent，
            // PLAN-701 native 9914）——打开文件即报 shell Recent（Windows
            // 跳转列表「最近」）；非 Windows no-op 返 false 零行为差异。
            // 放行位=recents 维护后（公共核四路同源单点）；恢复链不走此
            // 处（重建非新开）。注册表关联零依赖（014 T-01 勘定）。
            shell_add_recent(p)
            .tabs.push({key: "tab-" + .open_count.str(), title: file_basename(p), path: p, dirty: false, bom: false, eol: "lf", readonly: false, loaded: false, cline: 1, ccol: 1, big: false, ro_reason: "", src: ""})
            .tab = .tab_count
            .tab_count = .tab_count + 1
            .active_key = .tabs[.tab].key
            .title_active = .tabs[.tab].title
            .path_active = p
            .line = 1
            .col = 1
            .sel = 0
            .load_key = .tabs[.tab].key
            store.SyncByteMeta()
            // PLAN-010 T-01: 会话挂点（打开=结构变更；recents 维护前置于
            // 本调用——同一落盘携带）。
            store.SessionSave()
        }

        // PLAN-007 T-01: 装载（Tick 消费 load_key）。上游 PLAN-687 供料
        // code_editor_load_file(key, path)——native 端到端装载：std::fs
        // 单趟读（借 Rust 实现，用户 2026-09-22 方针）+ core.set_text
        // 单次重写 + 装载 delta drain-弃。全文零 VM 过载（envelope 过
        // 池/池滞留/O(n) 多趟重写三根因同除——T-03 三形状实测 729-1356MB
        // 反例后由本端点收敛）。协议①②维持：存在性探针 edit(key,0,0,
        // "")（编辑器实化前静默递延）+ 装载前 set_text(key,"") try/catch
        // 对齐 last_external（load 不触 guard——core 级 set_text 不改
        // last_external，装载后 stale 推送须 no-op 防清场）。
        .RunPendingLoad -> {
            if .load_key != "" {
                if code_editor_edit(.load_key, 0, 0, "") {
                    let key str = .load_key
                    let path str = .path_active
                    // PLAN-013 T-01: 装载前探测门（pre-load 裁定形——§10
                    // Q-1）。file_size 一次性（envelope JSON——裸 int 过
                    // HTTP=serialize null，T-00 实勘）；负值=缺席/IO（跳过
                    // 模式判定——既有 load_file 错误形承接，零行为差异）。
                    // 两级：>超大拒绝位（536870912B=512MB，Q-3 定参）→
                    // 拒绝装载（零 rope 分配——拒绝先于装载是 pre 形的实
                    // 质优势）；≥模式阈值（52428800B=50MB，战略 §2.2）→
                    // big 置位先于 load_file——装载完成渲染时 lang/wrap
                    // props 已按模式态走（apply_config 热应用+同 handler
                    // 原子性=首帧即模式态）。json.to_value 内联包裹（vue
                    // 转译吸收面，FifSearch 同款）；try 门=fsys 侧零 try
                    // 形的竞态窗兜底（异常→-1→既有错误形承接）。
                    var fsize int = -1
                    try {
                        let vsize = json.to_value(file_size(path))
                        fsize = vsize.size ?? -1
                    } catch {
                        fsize = -1
                    }
                    if fsize > 536870912 {
                        // 超大拒绝：错误形 tab（readonly+标题后缀）+
                        // loaded=true（装载链终结——防 TabActivate 懒装载
                        // 重触发）+ console 架构阻塞指向。readonly 置位
                        // 必须保留：空 rope + WriteFidelity 无栏 = 原文件
                        // 被清写盘成 0B（008 T-04 同根拦截面）。1GB 线
                        // 非目标注记：拒绝位在 1GB 之下，真分块 IO 清偿
                        // 前不进半装载态（upstream §16 登记）。
                        var ridx int = -1
                        var ri int = 0
                        while ri < .tabs.len() {
                            if .tabs[ri].key == key {
                                ridx = ri
                            }
                            ri = ri + 1
                        }
                        if ridx >= 0 {
                            .tabs[ridx].readonly = true
                            .tabs[ridx].ro_reason = "big"
                            .tabs[ridx].loaded = true
                            .tabs[ridx].title = file_basename(path) + "（超大文件-拒绝装载）"
                            if .tab == ridx {
                                .title_active = .tabs[ridx].title
                            }
                            store.SyncByteMeta()
                        }
                        .loaded_bytes = 0
                        .load_key = ""
                        console_log("load rejected: " + fsize.str() + " bytes > 超大拒绝位 536870912（50MB+ 为大文件模式域；>512MB 拒绝装载——真分块 IO=上游阻塞，docs/upstream §16）— " + path)
                        .console = console_lines()
                    } else {
                        if fsize >= 52428800 {
                            var bidx int = -1
                            var bi int = 0
                            while bi < .tabs.len() {
                                if .tabs[bi].key == key {
                                    bidx = bi
                                }
                                bi = bi + 1
                            }
                            if bidx >= 0 {
                                .tabs[bidx].big = true
                                store.SyncByteMeta()
                            }
                        }
                        try {
                            code_editor_set_text(key, "")
                        } catch {
                            // guard no-op——last_external 已对齐，达标
                        }
                        if env_str("AUTO_BENCH") == "1" {
                            print("BENCH bench_open_start")
                            print(time.now_ms())
                        }
                        let total int = code_editor_load_file(key, path)
                        if total >= 0 {
                            .loaded_bytes = total
                            // PLAN-008 T-01: 字节元数据探测（BOM/EOL/采样窗，
                            // 协议见 ProbeByteMeta 头注；错误形分支 T-04）
                            store.ProbeByteMeta(key, path)
                            // PLAN-010 T-02: 装载完成位置位（TabActivate 触发
                            // 门的关闭侧——此后激活免重装载；错误形不置位，
                            // 文件修复后可重试）。
                            var lidx int = -1
                            var li int = 0
                            while li < .tabs.len() {
                                if .tabs[li].key == key {
                                    lidx = li
                                }
                                li = li + 1
                            }
                            if lidx >= 0 {
                                .tabs[lidx].loaded = true
                                // PLAN-014 T-06: 光标恢复应用启用（010 前
                                // 向兼容位转正——供② code_editor_set_cursor
                                // 端点，PLAN-701）。cline/ccol 会话持久化
                                // 1 基 → 端点 0 基换算（-1）；端点内建钳位
                                // （越界→末行/行尾 char，陈旧会话安全）+
                                // Selection 弃置。fresh 打开 cline=ccol=1 →
                                // set(0,0)=起点，零行为差异。不 republish
                                // on_cursor（契约）——SyncCursor 由既有
                                // CursorMoved/TabActivate 面读回。排序：
                                // ProbeByteMeta（BOM 剥离 edit）之后——防
                                // 剥离 edit 复位光标。
                                code_editor_set_cursor(key, .tabs[lidx].cline - 1, .tabs[lidx].ccol - 1)
                            }
                        } else {
                            .loaded_bytes = 0
                            // PLAN-008 T-04: 非法 UTF-8 无损兜底——错误提示
                            // tab + readonly 置位（WriteFidelity 拦截落盘）+
                            // 状态栏标注；原文件字节零触碰（T-00 实测旧行为
                            // 会把空编辑器清写盘 32B→0B——拦截对象即此路径）。
                            // load_file 的 -1 兼指缺席/IO/非法 UTF-8——错误
                            // 路径专用 exists 前置判定区分「文件缺失」（维持
                            // 旧静默空 tab 语义）与「编码错误」（兜底形态）。
                            // widget 无禁编面（T-00 勘，§10-④）——边界=save
                            // 拦截+显著标注；替换符查看=上游 lossy want。
                            if exists(path) {
                                var eidx int = -1
                                var j int = 0
                                while j < .tabs.len() {
                                    if .tabs[j].key == key {
                                        eidx = j
                                    }
                                    j = j + 1
                                }
                                if eidx >= 0 {
                                    .tabs[eidx].readonly = true
                                    .tabs[eidx].ro_reason = "encoding"
                                    .tabs[eidx].title = file_basename(path) + "（编码错误-只读）"
                                    if .tab == eidx {
                                        .title_active = .tabs[eidx].title
                                    }
                                    store.SyncByteMeta()
                                    console_log("load error: invalid UTF-8 (readonly, save blocked) — " + path)
                                }
                            } else {
                                console_log("load error: file not found — " + path)
                            }
                        }
                        .load_key = ""
                        console_log("loaded: " + path + " " + total.str() + " bytes")
                        if env_str("AUTO_BENCH") == "1" {
                            print("BENCH bench_open_done")
                            print(time.now_ms())
                        }
                    }
                }
                .console = console_lines()
            }
        }

        // PLAN-008 T-01: 装载后字节元数据探测（T-00 决策记录落地）——
        // 单窗 read_text_range(path, 0, 65536) 采样（687 真分块 IO，磁盘
        // 窗口 O(limit)；全文件 census 会把全文 envelope 重新过 VM 字符串
        // 池=PLAN-007 观察 B③ 的机构性滞留，禁止——采样窗池驻留常数界
        // ~3×64KB/次打开）。BOM：首字符码点 65279（U+FEFF）→ bom=true +
        // 捕获前缀字符 + code_editor_edit(key,0,3,"") 剥离正文首字符
        // （byte 边界=EF BB BF；core.edit 纯 rope 拼接不经 buffer 漏斗，
        // EOL 安全；delta drain-弃=装载协议④同款卫生）。EOL：窗内
        // match_count 三计数→crlf/lf/cr/mixed 分类（窗内无行尾→lf 兜底；
        // >64KB 文件按窗口判形态——显示语义，保真由 save 位重写承载）。
        .ProbeByteMeta(key, path) -> {
            var idx int = -1
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].key == key {
                    idx = i
                }
                i = i + 1
            }
            if idx >= 0 {
                let env = json.to_value(read_text_range(path, 0, 65536))
                let w str = env.text ?? ""
                // BOM 检出：char_at 取码点（i32），经 .str() 字串化比对
                // 「65279」——vm 轨精确；vue 轨 charAt 返 string、该分支
                // 为装载位断点死分支（build-green 语义，生成器 natives
                // 层无 match_count/char_at 数值面——T-06 vue 复验勘定）。
                if w.char_at(0).str() == "65279" {
                    .tabs[idx].bom = true
                    .bom_prefix = w.substr(0, 3)
                    code_editor_edit(key, 0, 3, "")
                    code_editor_delta(key)
                    console_log("meta: bom stripped (prefix captured)")
                }
                // EOL 计数：len+replace 算术（替 match_count——vue ts_adapter
                // 无该方法映射；replace/len 两端皆映射，各端自洽单位制下
                // 计数等价）。
                let l0 int = w.len()
                let crlf int = (l0 - w.replace("\r\n", "").len()) / 2
                let nl int = l0 - w.replace("\n", "").len()
                let cr int = l0 - w.replace("\r", "").len()
                let lf int = nl - crlf
                let cro int = cr - crlf
                var e str = "lf"
                if crlf > 0 {
                    if lf == 0 {
                        if cro == 0 {
                            e = "crlf"
                        } else {
                            e = "mixed"
                        }
                    } else {
                        e = "mixed"
                    }
                } else {
                    if lf > 0 {
                        if cro == 0 {
                            e = "lf"
                        } else {
                            e = "mixed"
                        }
                    } else {
                        if cro > 0 {
                            e = "cr"
                        }
                    }
                }
                .tabs[idx].eol = e
                console_log("meta: " + path + " eol=" + e)
                store.SyncByteMeta()
            }
        }

        // PLAN-008 T-03: 行尾转换命令链——Request=mixed 确认门（统一将
        // 抹平混合形态，alert-dialog 先例）；EolConvert=转换本体（显式
        // 全文操作：code_editor_text 读出 + 归一替换 + set_text 重写 +
        // delta drain-弃——检测器白名单登记件「save 位+登记转换 handler」
        // 封闭集）。转换后 eol 元数据/状态栏同步，dirty 置位（可撤销性：
        // set_text 全文重写，Ctrl+Z 可回）。
        // PLAN-013 T-03: 大文件命令护栏（G-3）——Request 入口拦截（确认
        // 弹层不开=确认链不可达；本体 EolConvert 另设同门=确认链直呼
        // 防御，双门零成本）。readonly 不设（同 ReplaceAll——小步编辑
        // 不受限）。
        .EolConvertRequest(target) -> {
            if .tab_count > 0 {
                if .tabs[.tab].big {
                    .big_hint = "大文件：行尾转换已拦截（全文命令护栏）"
                    console_log("eol: blocked (big file — 全文命令护栏；全文读出+重写不进入大文件域，直写/分块端点=upstream §16)")
                } else {
                    if .tabs[.tab].eol == "mixed" {
                        .eol_confirm_target = target
                        .eol_confirm_open = true
                        console_log("eol: mixed line endings — confirm to unify")
                    } else {
                        store.EolConvert(target)
                    }
                }
            }
            .console = console_lines()
        }

        .EolConvert(target) -> {
            if .tab_count > 0 {
                if .tabs[.tab].big {
                    .big_hint = "大文件：行尾转换已拦截（全文命令护栏）"
                    console_log("eol: blocked (big file — 全文命令护栏)")
                } else {
                    if .tabs[.tab].readonly {
                        console_log("eol: blocked (readonly tab)")
                    } else {
                        let body str = code_editor_text(.active_key)
                        var out str = body.replace("\r\n", "\n").replace("\r", "\n")
                        if target == "crlf" {
                            out = out.replace("\n", "\r\n")
                        } else {
                            if target == "cr" {
                                out = out.replace("\n", "\r")
                            }
                        }
                        if out != body {
                            // 全文重写走结构化 edit（start=0,end=字节全长——
                            // VM str.len()=Rust s.len() 字节语义，T-00 勘定）：
                            // 该路径不触 registry set_text 的 last_external
                            // guard——handler 侧 set_text 会被下轮绑定推送
                            // （content=t.src=""≠last_external）清场（装载
                            // 协议②同款防御面，实测教训）；delta drain-弃。
                            code_editor_edit(.active_key, 0, body.len(), out)
                            code_editor_delta(.active_key)
                        }
                        .tabs[.tab].eol = target
                        .tabs[.tab].dirty = true
                        store.SyncByteMeta()
                        console_log("eol: converted to " + target)
                    }
                }
            }
            .console = console_lines()
        }

        .EolConfirmGo -> {
            .eol_confirm_open = false
            if .eol_confirm_target != "" {
                store.EolConvert(.eol_confirm_target)
            }
            .eol_confirm_target = ""
        }

        .EolConfirmCancel -> {
            .eol_confirm_open = false
            .eol_confirm_target = ""
        }

        // ---- PLAN-009 T-01: 查找链（拼装协议=T-00 决策记录）----
        // effective pattern 拼装收口（单一事实源）：find_query + 三开关 →
        // find_effective。拼装序：字面模式先转义（regex_escape 14 元字符）
        // → 大小写敏感前缀 `(?-i)`（内联覆盖内核 builder
        // case_insensitive(true)，T-00② 正案）→ 整词首尾 `\b` 锚。
        // 空 query → 空串（内核语义=清搜索态，高亮熄灭）。
        .SyncFindEffective -> {
            var p str = ""
            if .find_query != "" {
                if .find_regex {
                    p = .find_query
                } else {
                    p = regex_escape(.find_query)
                }
                if .find_case {
                    p = "(?-i)" + p
                }
                if .find_word {
                    p = "\\b" + p + "\\b"
                }
            }
            .find_effective = p
        }

        // 输入行（T-00④ 定案：vm 轨 input 派发=键入文本作 handler 首参，
        // handler 显式赋值——框架写回对 store 子树字段不适用）。
        .FindInput(q) -> {
            .find_query = q
            store.SyncFindEffective()
            .console = console_lines()
        }
        .FindReplaceInput(r) -> {
            .find_replacement = r
            .console = console_lines()
        }

        // 三开关（重算 effective；T-02 按钮双分支 variant 切换）。
        .FindToggleCase -> {
            .find_case = !.find_case
            store.SyncFindEffective()
            .console = console_lines()
        }
        .FindToggleWord -> {
            .find_word = !.find_word
            store.SyncFindEffective()
            .console = console_lines()
        }
        .FindToggleRegex -> {
            .find_regex = !.find_regex
            store.SyncFindEffective()
            .console = console_lines()
        }

        // 栏开启（Ctrl+F/Ctrl+H/菜单三源共用）。
        .FindOpen -> {
            .find_open = true
            .console = console_lines()
        }
        .FindReplaceOpen -> {
            .find_open = true
            .find_replace_mode = true
            .console = console_lines()
        }

        // 下一处（按钮/F3）：内核 find_next（光标后下一处、回绕、选区、
        // 滚动入视）；tab 门 + 空 effective 门（无 query 零动作）。
        .FindNext -> {
            if .tab_count > 0 {
                if .find_effective != "" {
                    code_editor_find(.active_key)
                    store.SyncCursor(.active_key)
                }
            }
            .console = console_lines()
        }

        // 关栏（× 按钮）：清 effective=清内核搜索态（高亮熄灭）。
        .FindClose -> {
            .find_open = false
            .find_replace_mode = false
            .find_effective = ""
            .console = console_lines()
        }

        // ---- PLAN-009 T-04: find-in-files 面板开合（搜索本体 FifSearch
        // 见该任务节；开=挂结果面板，关=清结果态）。
        .FifOpen -> {
            .fif_open = true
            .console = console_lines()
        }
        .FifClose -> {
            .fif_open = false
            .fif_results = []
            .fif_count = 0
            .fif_truncated = false
            .console = console_lines()
        }

        // ---- PLAN-009 T-04: find-in-files 搜索本体——back search_files
        // （工作区根；pattern=find_effective 与查找面同串同语义）→
        // json.to_value 解包 → 结果态（count 由 back 交付——列表 .len()
        // 规避面）。空 effective/未载 workspace 零动作。
        .FifSearch -> {
            if .fif_open {
                if .find_effective != "" {
                    if .ws_dir != "" {
                        // json.to_value 内联包裹（vue 转译吸收=JSON.parse
                        // 无注解 any——中间 typed str 层会让 string 类型
                        // 传染字段访问，vue build TS2339，T-06 实勘教训；
                        // ProbeByteMeta 同款内联先例）。
                        let v = json.to_value(search_files(.ws_dir, .find_effective, 500))
                        .fif_results = v.results ?? []
                        .fif_count = v.count ?? 0
                        .fif_truncated = v.truncated ?? false
                        console_log("fif: " + .fif_count.str() + " hits — " + .ws_dir)
                    }
                }
            }
            .console = console_lines()
        }

        // 结果条目点击开文件（OpenPath 公共核复用——同路径已开则激活，
        // TreeSelect 同款遍历；pattern 高亮经 find_effective 天然延续到
        // 新 tab 的 search prop——AC-06）。载荷=裸循环索引（TabActivate(i)
        // 先例——字段访问载荷 r.file 在 MCP 派发面携带字面量不解析，
        // T-06 实勘）；解码列表索引 + fif_count 门（.len() 规避面）。
        .FifResultClick(i) -> {
            if i >= 0 {
                if i < .fif_count {
                    let row = .fif_results[i]
                    let p str = row.file
                    var j int = 0
                    var found bool = false
                    while j < .tabs.len() {
                        if .tabs[j].path == p {
                            found = true
                            store.TabActivate(j)
                        }
                        j = j + 1
                    }
                    if !found {
                        if exists(p) {
                            store.OpenPath(p)
                            console_log("fif: open " + p)
                        }
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-009 T-03: 全部替换（检测器白名单第三件显式全文操作
        // ——读出+重写同 EolConvert 形态）。链（T-00⑤ 预演同形）：
        // readonly 拦截（WriteFidelity 拦截面复用，PLAN-008 兜底语义
        // 延续）→ code_editor_text 读出（编辑器全文读出位）→ back
        // regex_replace（Rust regex；pattern=find_effective 同查找面）
        // → json.to_value 解包 → count>0 才 edit(0,len,out) 全文重写 +
        // delta drain-弃 + dirty + SyncCursor + 计数 console 反馈。
        // 空 query/零匹配零动作（零匹配不重写——省一次全文置换）。
        // PLAN-013 T-03: 大文件命令护栏（G-3）——big 态入口拦截+显式
        // 提示（console+状态栏 big_hint，绝不静默）：全文读出+回写把
        // 50MB+ 字符串两次过 VM 池（687 滞留形态+011 工具链漂移实证，
        // §10 Q-4）；readonly 不设（小步编辑不受限——战略 §1.2 保留
        // 清单②）；解锁件=上游 code_editor_save 直写端点（§10-2 want，
        // upstream §16 登记）。
        .ReplaceAllRequest -> {
            if .tab_count > 0 {
                if .tabs[.tab].big {
                    .big_hint = "大文件：全部替换已拦截（全文命令护栏）"
                    console_log("replace: blocked (big file — 全文命令护栏；全文读出+回写不进入大文件域，直写/分块端点=upstream §16)")
                } else {
                    if .tabs[.tab].readonly {
                        console_log("replace: blocked (readonly tab)")
                    } else {
                        if .find_effective != "" {
                            let body str = code_editor_text(.active_key)
                            // json.to_value 内联包裹（vue 转译吸收面，FifSearch
                            // 同款；typed str 中间层=vue TS2339 根因）。
                            let v = json.to_value(regex_replace(body, .find_effective, .find_replacement, true))
                            let out str = v.out ?? ""
                            let count int = v.count ?? 0
                            if count > 0 {
                                code_editor_edit(.active_key, 0, body.len(), out)
                                code_editor_delta(.active_key)
                                .tabs[.tab].dirty = true
                                store.SyncCursor(.active_key)
                                console_log("replace all: " + count.str() + " 处")
                            } else {
                                console_log("replace all: 0 matches")
                            }
                        } else {
                            console_log("replace all: empty query")
                        }
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-010 T-01: 会话落盘收口（五挂点共用的内部 helper）----
        // APPDATA 根 auto-edit-session.json，结构变更即时落盘（Q-2 v1
        // 预判——用户节奏低频、文件 KB 级；退出时序 T-00④ 背书）。
        // 契约（SD-01）：ws_dir 键控 + tabs 仅文件 tab（untitled 排除，
        // 脏标记与正文不入）+ active=持久化数组内索引（激活 tab 为
        // untitled 时 -1——恢复按 0 兜底）+ open_count 防撞号推进 +
        // recents。拼装=json_escape 两字符转义 + .str() 整数化（双轨
        // 映射面内；json.stringify(1918) 在册但 vue 映射面未证——拼装
        // 侧不赌，双轨铁律）。session_path 为空（APPDATA 缺席）整链禁用。
        .SessionSave -> {
            if .session_path != "" {
                var body str = "{\"ws_dir\":\"" + json_escape(.ws_dir) + "\",\"open_count\":" + .open_count.str()
                var arr str = ""
                var act int = -1
                var n int = 0
                var i int = 0
                while i < .tabs.len() {
                    if .tabs[i].path != "" {
                        if arr != "" {
                            arr = arr + ","
                        }
                        arr = arr + "{\"path\":\"" + json_escape(.tabs[i].path) + "\",\"title\":\"" + json_escape(.tabs[i].title) + "\",\"cline\":" + .tabs[i].cline.str() + ",\"ccol\":" + .tabs[i].ccol.str() + "}"
                        if i == .tab {
                            act = n
                        }
                        n = n + 1
                    }
                    i = i + 1
                }
                body = body + ",\"active\":" + act.str()
                body = body + ",\"tabs\":[" + arr + "]"
                var rarr str = ""
                var j int = 0
                while j < .recents.len() {
                    var r = .recents[j]
                    if rarr != "" {
                        rarr = rarr + ","
                    }
                    rarr = rarr + "{\"path\":\"" + json_escape(r.path) + "\",\"title\":\"" + json_escape(r.title) + "\"}"
                    j = j + 1
                }
                body = body + ",\"recents\":[" + rarr + "]}"
                write_text(.session_path, body)
            }
        }

        // ---- PLAN-010 T-03: 最近文件点击（Explorer 侧栏条目）----
        // App 薄委托（裸索引载荷）→ 本收口。语义：已开同路径 tab →
        // TabActivate 激活；未开 → OpenPath（公共核——recents 维护随
        // OpenPath 前段自带，本 handler 零重复）。
        .RecentOpen(i) -> { store.RecentOpenAt(i) }
        .RecentOpenAt(i) -> {
            if i >= 0 {
                if i < .recents.len() {
                    let row = .recents[i]
                    let p str = row.path
                    var j int = 0
                    var found bool = false
                    while j < .tabs.len() {
                        if .tabs[j].path == p {
                            found = true
                            store.TabActivate(j)
                        }
                        j = j + 1
                    }
                    if !found {
                        if exists(p) {
                            store.OpenPath(p)
                            console_log("recent: open " + p)
                        }
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-011 T-02: diff 入口链（G-1）。env 旁路优先
        // （AUTO_DIFF_A/B——矩阵驱动面，AUTO_OPEN_PATH 先例同款 env_str
        // 消费形）：双 env 齐 → 直达 DiffCompute（零 dialog——rfd 阻塞式
        // 矩阵不可驱动）；单边残缺 → console 记录零动作（防矩阵悬挂）；
        // 双缺 → dialog_open×2 手动路径（任一取消=整链零动作）。
        .DiffOpen -> {
            var pa str = env_str("AUTO_DIFF_A")
            var pb str = env_str("AUTO_DIFF_B")
            if pa != "" {
                if pb != "" {
                    .diff_a = pa
                    .diff_b = pb
                    store.DiffCompute()
                } else {
                    console_log("diff: bypass 残缺（AUTO_DIFF_B 空）")
                }
            } else {
                if pb != "" {
                    console_log("diff: bypass 残缺（AUTO_DIFF_A 空）")
                } else {
                    pa = dialog_open("txt, md, at, rs, py, js, ts, json, toml, yml, log")
                    if pa != "" {
                        pb = dialog_open("txt, md, at, rs, py, js, ts, json, toml, yml, log")
                    }
                    if pa != "" {
                        if pb != "" {
                            .diff_a = pa
                            .diff_b = pb
                            store.DiffCompute()
                        } else {
                            console_log("diff: cancelled (b)")
                        }
                    } else {
                        console_log("diff: cancelled (a)")
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-011 T-02: diff 计算接线（G-2 消费端）。back
        // diff_files envelope → json.to_value 内联包裹（vue 吸收面，
        // FifSearch 同款）→ 显示行预变换（d_lo/d_ro 字符串行号，缺席侧
        // ""——视图零条件格式化）+渲染 cap 600 截断（T-00 定参）→ hunk
        // 表+导航位归零 → diff_open。err 形不静默（console 记录，不开
        // 视图）。计数全手工（json 列表 .len() 规避面，FifResultClick
        // 同源）。
        .DiffCompute -> {
            if .diff_a != "" {
                if .diff_b != "" {
                    let v = json.to_value(diff_files(.diff_a, .diff_b, 3))
                    .diff_err = v.err ?? ""
                    if .diff_err == "" {
                        var capped list = []
                        var nc int = 0
                        var n int = 0
                        var dbg_pair int = 0
                        var dbg_del int = 0
                        var dbg_add int = 0
                        var dbg_ctx int = 0
                        var all = v.rows ?? []
                        for r in all {
                            if nc < 600 {
                                var lov int = r.lo ?? 0
                                var rov int = r.ro ?? 0
                                var dlo str = ""
                                var dro str = ""
                                if lov > 0 {
                                    dlo = lov.str()
                                }
                                if rov > 0 {
                                    dro = rov.str()
                                }
                                // 形状判别符（视图四平铺分支用——嵌套 if+
                                // 空串比较在 vm 视图构建有迭代夭折实勘，
                                // T-03；单条件平铺=已证面）。
                                var lk0 str = r.lk
                                var rk0 str = r.rk
                                var lp0 str = r.lpre
                                var lm0 str = r.lmid
                                var lo0 str = r.lpost
                                var rp0 str = r.rpre
                                var rm0 str = r.rmid
                                var ro0 str = r.rpost
                                // bool 形状旗标×4（视图四平铺分支——record
                                // 字符串字段==字面量的兄弟 if 仅首个生效实勘
                                // [T-03：ctx 渲染 pair 哑火]，bool 字段 if=
                                // tab 条 t.dirty 已证面）。
                                var sx_ctx bool = false
                                var sx_pair bool = false
                                var sx_del bool = false
                                var sx_add bool = false
                                if lk0 == "del" {
                                    if rk0 == "add" {
                                        sx_pair = true
                                    } else {
                                        sx_del = true
                                    }
                                } else {
                                    if rk0 == "add" {
                                        sx_add = true
                                    } else {
                                        sx_ctx = true
                                    }
                                }
                                capped.push({d_lo: dlo, d_ro: dro, lo: lov, ro: rov, sx_ctx: sx_ctx, sx_pair: sx_pair, sx_del: sx_del, sx_add: sx_add, lk: lk0, rk: rk0, lpre: lp0, lmid: lm0, lpost: lo0, rpre: rp0, rmid: rm0, rpost: ro0})
                                if sx_pair {
                                    dbg_pair = dbg_pair + 1
                                }
                                if sx_del {
                                    dbg_del = dbg_del + 1
                                }
                                if sx_add {
                                    dbg_add = dbg_add + 1
                                }
                                if sx_ctx {
                                    dbg_ctx = dbg_ctx + 1
                                }
                                nc = nc + 1
                            }
                            n = n + 1
                        }
                        .diff_rows = capped
                        .diff_rows_count = nc
                        .diff_dbg_pair = dbg_pair
                        .diff_dbg_del = dbg_del
                        .diff_dbg_add = dbg_add
                        .diff_dbg_ctx = dbg_ctx
                        .diff_rows_truncated = n > nc
                        .diff_hunks = v.hunks ?? []
                        var nh int = 0
                        for h in .diff_hunks {
                            nh = nh + 1
                        }
                        .diff_hunk_count = nh
                        if nh > 0 {
                            .diff_hunk_idx = 0
                        } else {
                            .diff_hunk_idx = -1
                        }
                        .diff_hunk_pos = "1/" + nh.str()
                        .diff_adds = v.adds ?? 0
                        .diff_dels = v.dels ?? 0
                        .diff_degraded = v.degraded ?? false
                        .diff_title_a = file_basename(.diff_a)
                        .diff_title_b = file_basename(.diff_b)
                        .diff_open = true
                        var msg0 str = "diff: +" + .diff_adds.str() + "/-" + .diff_dels.str() + " hunks=" + nh.str()
                        if .diff_rows_truncated {
                            msg0 = msg0 + "（渲染截断 600）"
                        }
                        if .diff_degraded {
                            msg0 = msg0 + "（大段降级）"
                        }
                        console_log(msg0)
                    } else {
                        .diff_open = false
                        console_log("diff: " + .diff_err)
                        // PLAN-012: 下钻失败归位目录面板（dir_from_dirs
                        // 门——011 直用路径零扰动）。
                        if .dir_from_dirs {
                            .diff_open = true
                            .dir_mode = true
                            .diff_mode = "dirs"
                        }
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-011 T-02: diff 关闭清态（tab 集零扰动——编辑区条件
        // 面复原，tabs/dirty/光标全部不动；导航/边界态一并清零）。
        .DiffClose -> {
            .diff_open = false
            .diff_rows = []
            .diff_rows_count = 0
            .diff_rows_truncated = false
            .diff_hunks = []
            .diff_hunk_count = 0
            .diff_hunk_idx = -1
            .diff_adds = 0
            .diff_dels = 0
            .diff_degraded = false
            .diff_err = ""
            console_log("diff: closed")
            // PLAN-012: 下钻来源归位目录面板；目录态 Esc=整个 dirdiff
            // 出口（dir_from_dirs 门——011 直用路径零扰动）。
            if .dir_from_dirs {
                .diff_open = true
                .dir_mode = true
                .diff_mode = "dirs"
                .dir_from_dirs = false
                console_log("dirdiff: 返回目录面板")
            } else {
                if .dir_mode {
                    store.DirDiffClose()
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-011 T-04: hunk 导航（G-4）。推进/回绕（F7/Shift+F7
        // 与按钮同源）+当前 hunk 首渲染行 scroll_to 跳转。空 hunk（无
        // 差异文件）零动作——AC-04 disabled 语义=无操作（按钮无 enabled
        // 面，handler 守卫达成）。
        .DiffNext -> {
            if .diff_hunk_count > 0 {
                if .diff_hunk_idx >= .diff_hunk_count - 1 {
                    .diff_hunk_idx = 0
                } else {
                    .diff_hunk_idx = .diff_hunk_idx + 1
                }
                store.DiffScrollToHunk()
                .diff_hunk_pos = (.diff_hunk_idx + 1).str() + "/" + .diff_hunk_count.str()
                console_log("diff: hunk " + (.diff_hunk_idx + 1).str() + "/" + .diff_hunk_count.str())
            }
            .console = console_lines()
        }
        .DiffPrev -> {
            if .diff_hunk_count > 0 {
                if .diff_hunk_idx <= 0 {
                    .diff_hunk_idx = .diff_hunk_count - 1
                } else {
                    .diff_hunk_idx = .diff_hunk_idx - 1
                }
                store.DiffScrollToHunk()
                .diff_hunk_pos = (.diff_hunk_idx + 1).str() + "/" + .diff_hunk_count.str()
                console_log("diff: hunk " + (.diff_hunk_idx + 1).str() + "/" + .diff_hunk_count.str())
            }
            .console = console_lines()
        }
        // 当前 hunk 首渲染行定位（rows 归属判定：lo-1∈[a1,a2) 或 ro-1∈
        // [b1,b2)——hunks 有序不相交，首命中即目标）+ scroll_to 绝对
        // 像素跳转（T-00③ 公式：offset=行(0基)×24；float 累加规避
        // int×float 混合算术面）。
        .DiffScrollToHunk -> {
            if .diff_hunk_count > 0 {
                if .diff_hunk_idx >= 0 {
                    if .diff_hunk_idx < .diff_hunk_count {
                        let hk = .diff_hunks[.diff_hunk_idx]
                        var a1 int = hk.a1 ?? 0
                        var a2 int = hk.a2 ?? 0
                        var b1 int = hk.b1 ?? 0
                        var b2 int = hk.b2 ?? 0
                        var target int = -1
                        var ri int = 0
                        while ri < .diff_rows_count {
                            if target < 0 {
                                var r = .diff_rows[ri]
                                var lov int = r.lo ?? 0
                                var rov int = r.ro ?? 0
                                var hit bool = false
                                if lov > 0 {
                                    if lov - 1 >= a1 {
                                        if lov - 1 < a2 {
                                            hit = true
                                        }
                                    }
                                }
                                if !hit {
                                    if rov > 0 {
                                        if rov - 1 >= b1 {
                                            if rov - 1 < b2 {
                                                hit = true
                                            }
                                        }
                                    }
                                }
                                if hit {
                                    target = ri
                                }
                            }
                            ri = ri + 1
                        }
                        if target >= 0 {
                            var off float = 0.0
                            var k int = 0
                            while k < target {
                                off = off + 24.0
                                k = k + 1
                            }
                            let ok = scroll_to(.diff_scroll, "y", off)
                        }
                    }
                }
            }
        }

        .DiffBypassTick -> {
            if !.diff_bypass_done {
                var pa str = env_str("AUTO_DIFF_A")
                if pa != "" {
                    .diff_bypass_done = true
                    store.DiffOpen()
                }
            }
        }

        // ---- PLAN-012 T-03: 目录 diff 入口链（G-1）。env 旁路优先
        // （AUTO_DIRDIFF_A/B——矩阵驱动面，DiffOpen 同款消费形）：双 env
        // 齐 → 直达 DirDiffCompute；单边残缺 → console 记录零动作；双缺
        // → 开输入面板（v1 路径输入框——folder picker 无，T-00④ 定案）。
        .DirDiffOpen -> {
            var pa str = env_str("AUTO_DIRDIFF_A")
            var pb str = env_str("AUTO_DIRDIFF_B")
            if pa != "" {
                if pb != "" {
                    .dir_a = pa
                    .dir_b = pb
                    store.DirDiffCompute()
                } else {
                    console_log("dirdiff: bypass 残缺（AUTO_DIRDIFF_B 空）")
                }
            } else {
                if pb != "" {
                    console_log("dirdiff: bypass 残缺（AUTO_DIRDIFF_A 空）")
                } else {
                    .dir_from_dirs = false
                    .diff_open = true
                    .dir_mode = true
                    .diff_mode = "dirs"
                    console_log("dirdiff: 输入双路径后点比较")
                }
            }
            .console = console_lines()
        }

        .DirAInput(v) -> {
            .dir_a = v
        }
        .DirBInput(v) -> {
            .dir_b = v
        }

        // ---- PLAN-012 T-03: 目录 diff 计算接线（G-2 消费端）。back
        // diff_dirs envelope → json.to_value 内联包裹（DiffCompute 同款）
        // → counts 五标量解包 + DirApplyFilter 投影重建 → dir_mode 开。
        // err 形不静默（console 记录；手动面板保持显示 err 行）。计数全
        // 手工（json 列表 .len() 规避面）。
        .DirDiffCompute -> {
            if .dir_a != "" {
                if .dir_b != "" {
                    let v = json.to_value(diff_dirs(.dir_a, .dir_b))
                    .dir_err = v.err ?? ""
                    .dir_has_err = .dir_err != ""
                    if .dir_err == "" {
                        .dir_entries = v.entries ?? []
                        var n int = 0
                        for e in .dir_entries {
                            n = n + 1
                        }
                        .dir_total = n
                        .dir_truncated = v.truncated ?? false
                        var c = v.counts
                        .dir_n_same = c.same ?? 0
                        .dir_n_added = c.added ?? 0
                        .dir_n_deleted = c.deleted ?? 0
                        .dir_n_modified = c.modified ?? 0
                        .dir_n_binary = c.binary ?? 0
                        store.DirApplyFilter()
                        .dir_from_dirs = false
                        .diff_open = true
                        .dir_mode = true
                        .diff_mode = "dirs"
                        var msg0 str = "dirdiff: 同 " + .dir_n_same.str() + " 增 " + .dir_n_added.str() + " 删 " + .dir_n_deleted.str() + " 改 " + .dir_n_modified.str() + " 二进 " + .dir_n_binary.str()
                        if .dir_truncated {
                            msg0 = msg0 + "（截断）"
                        }
                        console_log(msg0)
                    } else {
                        console_log("dirdiff: " + .dir_err)
                    }
                } else {
                    console_log("dirdiff: 目录 B 为空")
                }
            } else {
                console_log("dirdiff: 目录 A 为空")
            }
            .console = console_lines()
        }

        // ---- PLAN-012 T-03: 过滤切换（G-3）。front 纯态——零重比
        // （dir_entries 不动，DirApplyFilter 重放投影；AC-03 断言面）。
        // 五 msg 拆分（视图静态钮零字面量实参——带参 onclick 边界规避）。
        .DirFilterAll -> {
            .dir_filter = "all"
            .dir_f_all = true
            .dir_f_added = false
            .dir_f_deleted = false
            .dir_f_modified = false
            .dir_f_binary = false
            store.DirApplyFilter()
            .console = console_lines()
        }
        .DirFilterAdded -> {
            .dir_filter = "added"
            .dir_f_all = false
            .dir_f_added = true
            .dir_f_deleted = false
            .dir_f_modified = false
            .dir_f_binary = false
            store.DirApplyFilter()
            .console = console_lines()
        }
        .DirFilterDeleted -> {
            .dir_filter = "deleted"
            .dir_f_all = false
            .dir_f_added = false
            .dir_f_deleted = true
            .dir_f_modified = false
            .dir_f_binary = false
            store.DirApplyFilter()
            .console = console_lines()
        }
        .DirFilterModified -> {
            .dir_filter = "modified"
            .dir_f_all = false
            .dir_f_added = false
            .dir_f_deleted = false
            .dir_f_modified = true
            .dir_f_binary = false
            store.DirApplyFilter()
            .console = console_lines()
        }
        .DirFilterBinary -> {
            .dir_filter = "binary"
            .dir_f_all = false
            .dir_f_added = false
            .dir_f_deleted = false
            .dir_f_modified = false
            .dir_f_binary = true
            store.DirApplyFilter()
            .console = console_lines()
        }

        // ---- PLAN-012 T-03: 过滤投影重建（内部收口）。渲染就绪行全
        // store 预变换（徽标/尺寸串/目录标记/未比对注记/动作可用性——
        // 视图零条件格式化；011 rows 同款）；cap 600（011 渲染 cap 同参，
        // 超限截断注记）。动作可用性：copy 单侧=恢复语义直执行/双侧
        // （改/二进）恒确认；删除仅单侧条目（双侧删除不提供——SD-01）。
        .DirApplyFilter -> {
            var capped list = []
            var vc int = 0
            var vt int = 0
            var f str = .dir_filter
            for e in .dir_entries {
                var st str = e.status
                var hit bool = false
                if f == "all" {
                    hit = true
                }
                if f == "added" {
                    if st == "added" {
                        hit = true
                    }
                }
                if f == "deleted" {
                    if st == "deleted" {
                        hit = true
                    }
                }
                if f == "modified" {
                    if st == "modified" {
                        hit = true
                    }
                }
                if f == "binary" {
                    if st == "binary" {
                        hit = true
                    }
                }
                if hit {
                    if vc < 600 {
                        var e_same bool = false
                        var e_added bool = false
                        var e_deleted bool = false
                        var e_modified bool = false
                        var e_binary bool = false
                        if st == "same" {
                            e_same = true
                        }
                        if st == "added" {
                            e_added = true
                        }
                        if st == "deleted" {
                            e_deleted = true
                        }
                        if st == "modified" {
                            e_modified = true
                        }
                        if st == "binary" {
                            e_binary = true
                        }
                        var sa int = e.size_a ?? 0
                        var sb int = e.size_b ?? 0
                        var isd bool = e.is_dir ?? false
                        var nt str = e.note ?? ""
                        var badge str = "同"
                        if e_added {
                            badge = "增"
                        }
                        if e_deleted {
                            badge = "删"
                        }
                        if e_modified {
                            badge = "改"
                        }
                        if e_binary {
                            badge = "二进"
                        }
                        if e_same {
                            if nt != "" {
                                badge = "未比"
                            }
                        }
                        var drel str = e.rel
                        if isd {
                            drel = "[目录] " + e.rel
                        }
                        var dsa str = sa.str()
                        var dsb str = sb.str()
                        if e_added {
                            dsa = ""
                        }
                        if e_deleted {
                            dsb = ""
                        }
                        if isd {
                            dsa = ""
                            dsb = ""
                        }
                        var can_l bool = false
                        var can_r bool = false
                        var can_del bool = false
                        if e_added {
                            can_l = true
                            can_del = true
                        }
                        if e_deleted {
                            can_r = true
                            can_del = true
                        }
                        if e_modified {
                            can_l = true
                            can_r = true
                        }
                        if e_binary {
                            can_l = true
                            can_r = true
                        }
                        capped.push({rel: e.rel, d_rel: drel, badge: badge, d_sa: dsa, d_sb: dsb, has_note: e_same, e_same: e_same, e_added: e_added, e_deleted: e_deleted, e_modified: e_modified, e_binary: e_binary, is_dir: isd, can_l: can_l, can_r: can_r, can_del: can_del})
                        vc = vc + 1
                    } else {
                        vt = vt + 1
                    }
                }
            }
            .dir_view = capped
            .dir_view_count = vc
            .dir_view_truncated = vt > 0
        }

        // ---- PLAN-012 T-03: 目录 diff 全清（编辑区复原；diff 文件态
        // 一并清零——面板 ×=整个 diff 工作流出口）。
        .DirDiffClose -> {
            .dir_from_dirs = false
            .dir_mode = false
            .diff_mode = ""
            .dir_entries = []
            .dir_total = 0
            .dir_n_same = 0
            .dir_n_added = 0
            .dir_n_deleted = 0
            .dir_n_modified = 0
            .dir_n_binary = 0
            .dir_truncated = false
            .dir_err = ""
            .dir_has_err = false
            .dir_filter = "all"
            .dir_f_all = true
            .dir_f_added = false
            .dir_f_deleted = false
            .dir_f_modified = false
            .dir_f_binary = false
            .dir_view = []
            .dir_view_count = 0
            .dir_view_truncated = false
            .dir_confirm_open = false
            .dir_confirm_text = ""
            .dir_pending_op = ""
            .dir_pending_rel = ""
            .dir_pending_dir = false
            .diff_open = false
            .diff_rows = []
            .diff_rows_count = 0
            .diff_rows_truncated = false
            .diff_hunks = []
            .diff_hunk_count = 0
            .diff_hunk_idx = -1
            .diff_adds = 0
            .diff_dels = 0
            .diff_degraded = false
            .diff_err = ""
            console_log("dirdiff: closed")
            .console = console_lines()
        }

        // ---- PLAN-012 T-04: 动作后重比（G-5）。同路径重调 diff_dirs；
        // 过滤态保持（dir_filter 不动——ApplyFilter 重放）。
        .DirDiffRefresh -> {
            if .dir_a != "" {
                if .dir_b != "" {
                    store.DirDiffCompute()
                }
            }
            .console = console_lines()
        }

        .DirBypassTick -> {
            if !.dir_bypass_done {
                var pa str = env_str("AUTO_DIRDIFF_A")
                if pa != "" {
                    .dir_bypass_done = true
                    store.DirDiffOpen()
                }
            }
        }

        // ---- PLAN-012 T-04: 条目主点击（G-4 下钻）。「改」→ 拼双 abs →
        // 011 DiffCompute 复用（diff_mode 切 file；dir_from_dirs 门=失败
        // /关闭归位目录面板）；其余 → OpenPath（fif 点击先例）。
        .DirRowClick(vi) -> {
            if vi >= 0 {
                if .dir_view_count > vi {
                    var r = .dir_view[vi]
                    if r.e_modified {
                        .dir_from_dirs = true
                        .diff_a = .dir_a + "/" + r.rel
                        .diff_b = .dir_b + "/" + r.rel
                        .dir_mode = false
                        .diff_mode = "file"
                        store.DiffCompute()
                    } else {
                        store.OpenPath(.dir_a + "/" + r.rel)
                        console_log("dirdiff: open " + r.rel)
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-012 T-04: 单向复制（G-5）。双侧条目（改/二进）=目标
        // 存在恒确认（Q-2 静默覆盖——确认链纪律）；单侧条目=恢复语义直
        // 执行。目录条目走 copy_recursive（is_dir 传递 back 分派）。
        .DirCopyRight(vi) -> {
            if vi >= 0 {
                if .dir_view_count > vi {
                    var r = .dir_view[vi]
                    if r.can_r {
                        var both bool = false
                        if r.e_modified {
                            both = true
                        }
                        if r.e_binary {
                            both = true
                        }
                        if both {
                            .dir_pending_op = "copy_r"
                            .dir_pending_rel = r.rel
                            .dir_pending_dir = r.is_dir
                            .dir_confirm_text = "覆盖右侧？ " + r.rel
                            .dir_confirm_open = true
                        } else {
                            var ok bool = sync_copy(.dir_a + "/" + r.rel, .dir_b + "/" + r.rel, r.is_dir)
                            if ok {
                                console_log("dirdiff: 已复制 →右 " + r.rel)
                                store.DirDiffRefresh()
                            } else {
                                console_log("dirdiff: 复制失败（>2MB 或 IO）—— " + r.rel)
                            }
                        }
                    }
                }
            }
            .console = console_lines()
        }
        .DirCopyLeft(vi) -> {
            if vi >= 0 {
                if .dir_view_count > vi {
                    var r = .dir_view[vi]
                    if r.can_l {
                        var both bool = false
                        if r.e_modified {
                            both = true
                        }
                        if r.e_binary {
                            both = true
                        }
                        if both {
                            .dir_pending_op = "copy_l"
                            .dir_pending_rel = r.rel
                            .dir_pending_dir = r.is_dir
                            .dir_confirm_text = "覆盖左侧？ " + r.rel
                            .dir_confirm_open = true
                        } else {
                            var ok bool = sync_copy(.dir_b + "/" + r.rel, .dir_a + "/" + r.rel, r.is_dir)
                            if ok {
                                console_log("dirdiff: 已复制 →左 " + r.rel)
                                store.DirDiffRefresh()
                            } else {
                                console_log("dirdiff: 复制失败（>2MB 或 IO）—— " + r.rel)
                            }
                        }
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-012 T-04: 单侧删除（G-5）。恒确认链；back 仅空目录
        // 可删（非空 remove_dir 原生拒——T-00 护栏）。
        .DirDeleteA(vi) -> {
            if vi >= 0 {
                if .dir_view_count > vi {
                    var r = .dir_view[vi]
                    if r.can_del {
                        .dir_pending_op = "del_a"
                        .dir_pending_rel = r.rel
                        .dir_pending_dir = r.is_dir
                        .dir_confirm_text = "确认删除左侧？ " + r.rel
                        .dir_confirm_open = true
                    }
                }
            }
            .console = console_lines()
        }
        .DirDeleteB(vi) -> {
            if vi >= 0 {
                if .dir_view_count > vi {
                    var r = .dir_view[vi]
                    if r.can_del {
                        .dir_pending_op = "del_b"
                        .dir_pending_rel = r.rel
                        .dir_pending_dir = r.is_dir
                        .dir_confirm_text = "确认删除右侧？ " + r.rel
                        .dir_confirm_open = true
                    }
                }
            }
            .console = console_lines()
        }

        // ---- PLAN-012 T-04: 确认链执行/取消（alert-dialog 先例——
        // EolConvert/quit 同款）。执行后 DirDiffRefresh 重比（磁盘 E2E
        // 由矩阵断言）。
        .DirConfirmGo -> {
            .dir_confirm_open = false
            var op str = .dir_pending_op
            var rel str = .dir_pending_rel
            var ok bool = false
            if op == "copy_r" {
                ok = sync_copy(.dir_a + "/" + rel, .dir_b + "/" + rel, .dir_pending_dir)
            }
            if op == "copy_l" {
                ok = sync_copy(.dir_b + "/" + rel, .dir_a + "/" + rel, .dir_pending_dir)
            }
            if op == "del_a" {
                ok = sync_delete(.dir_a + "/" + rel, .dir_pending_dir)
            }
            if op == "del_b" {
                ok = sync_delete(.dir_b + "/" + rel, .dir_pending_dir)
            }
            if ok {
                console_log("dirdiff: 已执行 " + op + " " + rel)
                store.DirDiffRefresh()
            } else {
                console_log("dirdiff: 动作失败—— " + rel)
            }
            .dir_pending_op = ""
            .dir_pending_rel = ""
            .dir_pending_dir = false
            .console = console_lines()
        }
        .DirConfirmCancel -> {
            .dir_confirm_open = false
            .dir_pending_op = ""
            .dir_pending_rel = ""
            .dir_pending_dir = false
            console_log("dirdiff: 动作已取消")
            .console = console_lines()
        }

        // ---- PLAN-012 T-04: 下钻返回目录态（entries 保留不重比——
        // G-4/AC-04）。
        .DirBackToDirs -> {
            if .dir_from_dirs {
                .dir_mode = true
                .diff_mode = "dirs"
                .dir_from_dirs = false
                console_log("dirdiff: 返回目录面板")
            }
            .console = console_lines()
        }

        .ActOpen -> {
            // Plan 420 P2: AUTO_OPEN_PATH 环境变量旁路(测试构建语义,prod
            // 忽略)—— 阻塞式 rfd 对话框无法被 MCP 驱动的盲区由此打通。
            // PLAN-003 T-02: env 读入 back(env_str),front 零 Env.get。
            var p str = env_str("AUTO_OPEN_PATH")
            if p == "" {
                p = dialog_open(".at, .au, .rs, .txt")
            }
            if p != "" {
                store.OpenPath(p)
                console_log("open: " + p)
            } else {
                console_log("open: cancelled")
            }
            .console = console_lines()
        }
        .ActSave -> {
            if .tab_count > 0 {
                if .path_active == "" {
                    // Plan 420 P2: AUTO_SAVE_PATH 旁路(与 AUTO_OPEN_PATH 同型)。
                    var p str = env_str("AUTO_SAVE_PATH")
                    if p == "" {
                        p = dialog_save("untitled.at")
                    }
                    if p != "" {
                        .path_active = p
                        .tabs[.tab].path = p
                        .title_active = file_basename(p)
                        .tabs[.tab].title = file_basename(p)
                    }
                }
                if .path_active != "" {
                    // PLAN-008 T-02: 保真回写收口（BOM 前缀 + EOL 主形态
                    // 重写 + readonly 拦截 T-04——全文唯一读出位）。
                    store.WriteFidelity(.tab)
                } else {
                    console_log("save: cancelled")
                }
            }
            .console = console_lines()
        }
        // PLAN-008 T-02: save 位字节保真回写（T-00 决策③落地）——编辑器
        // 全文唯一读出位（检测器白名单：WriteFidelity 登记件，取代原
        // ActSave/QuitSaveClose 两处内联读）。按 tab 元数据包装落盘：
        // BOM = bom_prefix 前缀回写（探测时捕获的 U+FEFF 字面字符——
        // 无编辑纯往返时 rope 已剥离，此前缀即复原 EF BB BF）；
        // EOL = crlf/cr 主形态重写（补偿 buffer 编辑即归一 LF：先
        // "\r\n"→"\n" 幂等归一、lone "\r"→"\n"，再统一 "\n"→目标形态——
        // 无编辑的纯形态 rope 两步互抵无损）；lf/mixed 零动作（无编辑
        // =mixed 逐字保真；编辑后=归一 LF 形态，逐行保真为上游 want
        // §10-⑥）。readonly（T-04 非法 UTF-8 错误形/PLAN-013 超大拒绝
        // 形）拦截：不落盘。
        // PLAN-014 T-05: 大文件 save 解禁（013 护栏解除件消费——供①
        // code_editor_save 直写端点，PLAN-701）——big 态改道 rope 直写
        // 落盘（零全文 VM 往返；字节保真归属见 SD-01：端点裸写 rope 字
        // 节，BOM 剥离形态随 rope——T-04 探针实测形）；readonly 兜底
        // （超大拒绝/编码错误形）保持外层先行。normal 态维持现链（Q-2
        // v1 界定——读出+包装+write_text 零变更）。Q-2 消费注记：检测器
        // 白名单零变更（code_editor_text 读出位随 normal 链保留——预记
        // 「读出位四→三」不成立，读出位语义未变）。
        .WriteFidelity(i) -> {
            if .tabs[i].path != "" {
                if .tabs[i].readonly {
                    console_log("save blocked (readonly): " + .tabs[i].path)
                } else {
                    if .tabs[i].big {
                        // big 态直写（供①）：true=写通；false=无此 key/IO
                        // 失败（值形错误——stderr 不静默，镜像 load -1 形）。
                        if code_editor_save(.tabs[i].key, .tabs[i].path) {
                            .tabs[i].dirty = false
                            .big_hint = ""
                            console_log("saved (direct): " + .tabs[i].path)
                        } else {
                            .big_hint = "大文件：直写保存失败"
                            console_log("save failed (code_editor_save false): " + .tabs[i].path)
                        }
                    } else {
                        let body str = code_editor_text(.tabs[i].key)
                        var out str = body
                        if .tabs[i].bom {
                            out = .bom_prefix + body
                        }
                        if .tabs[i].eol == "crlf" {
                            out = out.replace("\r\n", "\n").replace("\n", "\r\n")
                        } else {
                            if .tabs[i].eol == "cr" {
                                out = out.replace("\r\n", "\n").replace("\r", "\n").replace("\n", "\r")
                            }
                        }
                        write_text(.tabs[i].path, out)
                        .tabs[i].dirty = false
                        console_log("saved: " + .tabs[i].path)
                    }
                }
            }
        }

        .ActUndo -> {
            if .tab_count > 0 {
                code_editor_undo(.active_key)
            }
            console_log("undo")
            .console = console_lines()
        }
        .ActRedo -> {
            if .tab_count > 0 {
                code_editor_redo(.active_key)
            }
            console_log("redo")
            .console = console_lines()
        }
        .ActSelectAll -> {
            if .tab_count > 0 {
                code_editor_select_all(.active_key)
                store.SyncCursor(.active_key)
            }
            console_log("select all")
            .console = console_lines()
        }
        .ActCut -> {
            if .tab_count > 0 {
                code_editor_cut(.active_key)
                .tabs[.tab].dirty = true
            }
            console_log("cut")
            .console = console_lines()
        }
        .ActCopy -> {
            if .tab_count > 0 {
                code_editor_copy(.active_key)
            }
            console_log("copy")
            .console = console_lines()
        }
        .ActPaste -> {
            if .tab_count > 0 {
                code_editor_paste(.active_key)
                .tabs[.tab].dirty = true
            }
            console_log("paste")
            .console = console_lines()
        }
        .ActConsole -> {
            .console_open = !.console_open
            .console = console_lines()
        }
        .ActSwitchTab -> {
            if .tab_count > 1 {
                // 两 tab 演示语义保留(Ctrl+D 矩阵断言 0↔1 翻转)。
                .tab = 1 - .tab
                .active_key = .tabs[.tab].key
                .title_active = .tabs[.tab].title
                .path_active = .tabs[.tab].path
                store.SyncCursor(.active_key)
            }
            .console = console_lines()
        }
        .ActAbout -> {
            console_log("auto-edit 0.1 — AutoUI playground (plans 413/414/418/420)")
            .console = console_lines()
        }

        // ---- PLAN-618 T-06: 文件浏览器树 ----
        .TreeToggle(id) -> {
            .tree_expanded = toggle_id(.tree_expanded, id)
        }
        // 选中文件 → OpenByPath 语义:同路径 tab 已开则激活,否则读盘构造
        // 新 tab(Plan 626 T-05:静态演示表退役,path 存全路径,保存/再次匹配
        // 都走全路径;目录节点 exists 不命中,静默忽略)。PLAN-003 T-02:
        // 拼径改本地字符串拼接(fs.join 亦在 vue 拦截面,T-00 P-5——ws_dir
        // 尾分隔符经 "+/+" 形式归一,Win32 路径规范化容忍双斜杠),读盘/
        // 判存走 back api。
        .TreeSelect(id) -> {
            .tree_sel = id
            var full str = .ws_dir + "/" + id
            var i int = 0
            var found bool = false
            while i < .tabs.len() {
                if .tabs[i].path == full {
                    found = true
                    store.TabActivate(i)
                }
                i = i + 1
            }
            if !found {
                if exists(full) {
                    store.OpenPath(full)
                    console_log("open: " + full)
                }
                .console = console_lines()
            }
        }

        // ---- Plan 626 T-06: 退出/关窗确认(有脏 tab 先弹 alert-dialog)----
        // CloseRequest = 窗口 X(渲染器拦截分派)与菜单「退出」共用入口;
        // 无路径脏 tab(untitled)无从自动保存——落盘有路径的,其余放弃。
        // PLAN-010 T-01: 会话挂点=本入口单点（三臂共用——干净臂直接退出、
        // 弹层两臂自确认层退出，结构在挂点时已定型；弹层臂的 WriteFidelity
        // 落盘不改 tab 集，会话保持准确）。写盘先于 Process.exit 的时序
        // 由 T-00④/矩阵 T14 背书。
        .CloseRequest -> {
            store.SessionSave()
            var any bool = false
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].dirty {
                    any = true
                }
                i = i + 1
            }
            if any {
                .quit_confirm_open = true
            } else {
                console_log("quit")
                Process.exit(0)
            }
            .console = console_lines()
        }
        .ActQuit -> { store.CloseRequest() }
        .QuitConfirmCancel -> {
            .quit_confirm_open = false
        }
        .QuitSaveClose -> {
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].dirty {
                    if .tabs[i].path != "" {
                        // PLAN-008 T-02: 保真回写收口（原直写位改道）。
                        store.WriteFidelity(i)
                    }
                }
                i = i + 1
            }
            console_log("quit: saved & exit")
            Process.exit(0)
        }
        .QuitDiscard -> {
            console_log("quit: discard & exit")
            Process.exit(0)
        }
    }
}
